{#- Place de la page dans doc_sections (config/packages/twig.yaml) : la page précédente et la suivante.
    Page hors de la liste (accueil, page de test) : doc_prev et doc_next restent null -#}
{%- set doc_pages = [] -%}
{%- for section in doc_sections -%}
    {%- for link in section.links -%}
        {%- set doc_pages = doc_pages|merge([{route: link[0], label: link[1]}]) -%}
    {%- endfor -%}
{%- endfor -%}
{%- set doc_index = null -%}
{%- for page in doc_pages -%}
    {%- if page.route == app.current_route -%}{%- set doc_index = loop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- set doc_prev = doc_index is not null and doc_index > 0 ? doc_pages[doc_index - 1] : null -%}
{%- set doc_next = doc_index is not null and doc_index < doc_pages|length - 1 ? doc_pages[doc_index + 1] : null -%}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Une page définit {% block title %} (« Accordéon ») : l'onglet affiche « Accordéon · webdev-ui » #}
        <title>{% block title %}Documentation{% endblock %} · webdev-ui</title>
        <meta name="description" content="{% block description %}{{ block('title') }} : documentation de webdev-ui, framework CSS/JS léger et sans dépendance.{% endblock %}">
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        {# Avant le CSS : pose le thème choisi (Clair ou Sombre) sans flash au chargement ; Système, ou rien de gardé : pas de data-theme, le thème de l'ordinateur #}
        <script>
            const theme = localStorage.getItem('theme');
            if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        </script>
        <link rel="stylesheet" href="{{ asset('webdev-ui/css/webdev-ui.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/doc.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {# htmx (doc seulement) : les liens de navigation ne rechargent que le contenu (#doc-content), le menu reste ; avant app.js, qui l'écoute #}
            <script src="{{ asset('js/htmx.min.js') }}" defer></script>
            {# Coloration du code : Prism découpe chaque <pre><code class="language-html"> (language-css, -scss, -js, -twig…) en .token, colorés par doc.css ; l'autoloader charge depuis le CDN le langage de chaque bloc #}
            <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/components/prism-core.min.js" integrity="sha384-zLRFO4dwowZvh8kzutOb5AWhH7f39HeJp+N7PtHF1SQtTBnifRx0AtmvTYs3F4YV" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js" integrity="sha384-Uq05+JLko69eOiPr39ta9bh7kld5PKZoU+fF7g0EXTAriEollhZ+DrN8Q/Oi8J2Q" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {# Le JS du framework, comme le CSS : dist/js/webdev-ui.js ; après l'importmap : Firefox l'ignore si un module a déjà commencé à charger #}
            <script type="module" src="{{ asset('webdev-ui/js/webdev-ui.js') }}"></script>
        {% endblock %}
    </head>
    {# htmx : un lien dans un data-hx-boost charge sa page, n'en garde que #doc-content et remplace celui-ci, en haut de la fenêtre
       (data-hx-* et pas hx-* : valide en HTML) ; l'adresse et le titre de l'onglet suivent, le menu et l'en-tête restent #}
    {# Grand écran : la page a la hauteur de l'écran, l'en-tête et le pied restent, le contenu défile dans le main ;
       petit écran et zoom : toute la page défile (l'en-tête et le pied ne prennent pas la place du contenu) #}
    <body class="d-flex flex-direction-column min-h-100svh lg:h-100svh" data-hx-target="#doc-content" data-hx-select="#doc-content" data-hx-swap="outerHTML show:window:top">
        {# Fond de la doc (doc.css) : quatre bandes de vagues qui glissent derrière la page ; hors de #doc-content, htmx ne les recharge pas #}
        <div class="doc-waves"><div></div><div></div><div></div><div></div></div>

        {# En-tête, contenu et pied de page : trois cartes en verre, au-dessus du fond à vagues #}
        <div class="container pt-3">
            <header class="card glass box-shadow-xl">
                {# flex-wrap-wrap : sur un écran étroit, la recherche et les boutons passent à la ligne au lieu de déborder ;
                   grand écran : la recherche au milieu, entre deux côtés de même largeur (lg:w-25) ; lg:flex-wrap-nowrap : avec les écarts,
                   les trois dépassent 100 % et rétrécissent ensemble au lieu de passer à la ligne #}
                <div class="card-body d-flex flex-wrap-wrap lg:flex-wrap-nowrap align-items-center gap-3 py-3">
                    {# Téléphone : seuls sur la première ligne (w-100), la recherche et le thème sur la deuxième #}
                    <div class="d-flex align-items-center gap-3 w-100 sm:w-auto lg:w-25">
                        {# Petit écran : le menu est dans un drawer #}
                        <button class="btn btn-sm lg:d-none" type="button" commandfor="doc-menu" command="show-modal">Menu</button>
                        {# Grand écran : le nom est en haut du menu fixé #}
                        <a class="link fs-lg fw-bold text-decoration-none lg:d-none" href="{{ path('app_main') }}" data-hx-boost="true">webdev-ui</a>
                    </div>

                    {# Recherche : motif « combobox » de l'ARIA APG ; app.js filtre la liste des pages pendant la frappe, le focus reste dans le champ #}
                    <search class="flex-grow-1 lg:flex-grow-0 lg:w-50">
                        <label class="visually-hidden" for="doc-search">Rechercher une page</label>
                        {# type="text" : role="combobox" n'est pas permis sur type="search" ; enterkeyhint : la touche Rechercher du clavier des téléphones ;
                           autocomplete="off" : seulement les pages, pas ce qui a déjà été tapé ; size="10" : une largeur de départ courte, le champ prend ensuite la place qui reste #}
                        <input class="form-input-md" id="doc-search" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="doc-search-list" placeholder="Rechercher" size="10" enterkeyhint="search" autocomplete="off">
                        {# La liste : un dropdown en verre sous le champ, de sa largeur (doc.css) ; chaque option est un lien, chargé par htmx ; tabindex="-1" : Tab quitte la recherche #}
                        <div class="dropdown glass" id="doc-search-list" role="listbox" aria-label="Pages de la documentation" popover="manual" data-hx-boost="true">
                            {% for section in doc_sections %}
                                {% for link in section.links %}
                                    <a class="dropdown-item" id="doc-search-{{ link[0] }}" href="{{ path(link[0]) }}" role="option" tabindex="-1">{{ link[1] }}</a>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </search>

                    {# ms-auto : s'il passe seul à la ligne (police plus large), le bouton reste à droite #}
                    <div class="d-flex justify-content-end gap-3 ms-auto lg:w-25">
{#                        <a class="btn btn-sm" href="{{ path('app_test') }}" data-hx-boost="true">Page de test</a>#}
                        {# Thème : un dropdown du framework et trois boutons radio ; Système coché dans le HTML (le défaut), app.js coche le choix gardé et l'applique
                           Le bouton montre le thème choisi : son emoji (les deux autres en hidden), et son nom pour le lecteur d'écran (« Thème, Système ») ;
                           les emojis de l'archive, aria-hidden : le nom du thème est écrit à côté #}
                        <button class="btn btn-md d-inline-flex align-items-center gap-2" type="button" popovertarget="doc-theme">
                            <span aria-hidden="true">
                                <span data-theme-icon="light" hidden>☀️</span>
                                <span data-theme-icon="dark" hidden>🌙</span>
                                <span data-theme-icon="system">💻</span>
                            </span>
                            Thème
                            <span class="visually-hidden" id="doc-theme-current">Système</span>
                        </button>
                        <div class="dropdown" id="doc-theme" popover>
                            <fieldset class="border-0 p-0">
                                <legend class="visually-hidden">Thème</legend>
                                <label class="dropdown-item d-flex align-items-center gap-2 cursor-pointer"><input class="form-radio" type="radio" name="doc-theme" value="light"><span aria-hidden="true">☀️</span>Clair</label>
                                <label class="dropdown-item d-flex align-items-center gap-2 cursor-pointer"><input class="form-radio" type="radio" name="doc-theme" value="dark"><span aria-hidden="true">🌙</span>Sombre</label>
                                <label class="dropdown-item d-flex align-items-center gap-2 cursor-pointer"><input class="form-radio" type="radio" name="doc-theme" value="system" checked><span aria-hidden="true">💻</span>Système</label>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </header>
        </div>

        <dialog class="drawer-start glass" id="doc-menu" data-dialog closedby="any" aria-labelledby="doc-menu-title">
            <div class="drawer-header">
                <p class="fs-lg fw-semibold" id="doc-menu-title">Menu</p>
                <button class="btn-close" type="button" commandfor="doc-menu" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body">
                <nav class="d-grid gap-6" aria-label="Documentation" data-hx-boost="true">
                    {{ include('_menu.html.twig') }}
                </nav>
            </div>
        </dialog>

        {# Grand écran : le menu toujours là, fixé contre le bord gauche, en verre ; doc.css décale la page de sa place #}
        <nav class="drawer-start position-fixed glass d-none lg:d-block" id="doc-menu-fixed" aria-label="Documentation" data-hx-boost="true">
            <div class="drawer-header">
                <a class="link fs-lg fw-bold text-decoration-none" href="{{ path('app_main') }}">webdev-ui</a>
            </div>
            <div class="drawer-body d-grid gap-6">
                {{ include('_menu.html.twig') }}
            </div>
        </nav>

        {# Ce que htmx remplace d'une page à l'autre : le contenu et l'élément fixé d'une démo ; le seul gardé dans l'historique (Retour) #}
        {# Le main prend la place qui reste entre l'en-tête et le pied (lg:min-h-0 : il peut être plus petit que son contenu), son corps défile ;
           position-relative : les éléments en position absolue (visually-hidden) défilent dedans au lieu d'allonger la page #}
        <div class="container flex-grow-1 d-flex flex-direction-column lg:min-h-0 py-3" id="doc-content" data-hx-history-elt>
            <main class="card glass box-shadow-xl flex-grow-1 lg:min-h-0">
                <div class="card-body position-relative overflow-y-auto p-4 md:p-10">
                    {% block body %}{% endblock %}

                    {% if doc_prev or doc_next %}
                        {# Lecture suivie : les pages voisines dans l'ordre du menu #}
                        <nav class="d-flex flex-wrap-wrap gap-3 mt-12 pt-6 border-top" aria-label="Pages précédente et suivante" data-hx-boost="true">
                            {% if doc_prev %}
                                <a class="btn" href="{{ path(doc_prev.route) }}" rel="prev"><span aria-hidden="true">← </span><span class="visually-hidden">Page précédente : </span>{{ doc_prev.label }}</a>
                            {% endif %}
                            {% if doc_next %}
                                <a class="btn ms-auto" href="{{ path(doc_next.route) }}" rel="next"><span class="visually-hidden">Page suivante : </span>{{ doc_next.label }}<span aria-hidden="true"> →</span></a>
                            {% endif %}
                        </nav>
                    {% endif %}
                </div>
            </main>

            {# Hors de la carte : un élément fixé d'une démo (position-fixed) ; dans la carte, backdrop-filter le placerait par rapport à elle #}
            {% block fixed %}{% endblock %}
        </div>

        {# Annonce du bouton Copier des blocs de code (app.js) : vide au chargement, le JS y écrit « Code copié » ; hors du contenu, que htmx remplace #}
        <p class="visually-hidden" role="status" aria-live="polite" id="doc-copy-status"></p>

        <div class="container pb-3">
            {# Logos : htmx et GitHub de Simple Icons (CC0), Prism de son dépôt (MIT), en currentColor : la couleur du texte dans les deux thèmes #}
            <footer class="card glass box-shadow-xl">
                {# Une ligne sur grand écran (le pied reste affiché sous le contenu) : à gauche le nom et ce qu'est le framework,
                   à droite les outils de la doc et le projet, en petits boutons arrondis avec leur logo ; sur petit écran, les groupes passent à la ligne #}
                <div class="card-body d-flex flex-wrap-wrap align-items-center justify-content-space-between gap-3 py-3">
                    <p class="d-flex flex-wrap-wrap align-items-center column-gap-3 row-gap-1">
                        <a class="link d-inline-flex align-items-center gap-2 fw-bold text-decoration-none" href="{{ path('app_main') }}" data-hx-boost="true"><img src="/favicon.svg" alt="" width="24" height="24">webdev-ui</a>
                        <span class="fs-sm color-neutral-emphasis">HTML natif, variables CSS, zéro dépendance · licence MIT</span>
                    </p>
                    <div class="d-flex flex-wrap-wrap align-items-center gap-2">
                        <span class="fs-sm color-neutral-emphasis me-1">Cette doc est faite avec</span>
                        {# Les deux outils ensemble : sur petit écran, ils passent à la ligne d'un bloc #}
                        <span class="d-flex gap-2">
                            <a class="btn btn-xs border-radius-pill d-inline-flex align-items-center gap-1" href="https://htmx.org/"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 13.01v-2l7.09-2.98.58 1.94-5.1 2.05 5.16 2.05-.63 1.9Zm16.37 1.03 5.18-2-5.16-2.09.65-1.88L24 10.95v2.12L17 16zm-2.85-9.98H16l-5.47 15.88H8.05Z"/></svg>htmx</a>
                            <a class="btn btn-xs border-radius-pill d-inline-flex align-items-center gap-1" href="https://prismjs.com/"><svg width="14" height="14" viewBox="0 0 200 170" fill="currentColor" aria-hidden="true"><path d="M55.37 131.5H48.4v9.13h6.97c1.67 0 2.92-.4 3.78-1.22.85 -.8 1.28-1.92 1.28-3.33s-.43-2.54-1.28-3.35c-.86-.8-2.12-1.2-3.78-1.2m29.52 6.4c.3-.53.47-1.2.47-2.04 0-1.35-.45-2.4-1.37-3.2-.92-.76-2.14-1.15-3.65 -1.15H72.9v8.52h7.32c2.26 0 3.82-.7 4.67-2.1M100 0L0 170h200L100 0M60.86 141.03c-1.3 1.22-3.1 1.84-5.33 1.84H48.4v7.55H46v-21.2h9.53c2.24 0 4.02.63 5.34 1.87 1.3 1.23 1.96 2.88 1.96 4.95 0 2.1-.66 3.75-1.97 4.98m24.5 9.4l -5.1-8.14h-7.37v8.12h-2.4v-21.2h10.14c2.15 0 3.88.6 5.18 1.8 1.3 1.18 1.95 2.8 1.95 4.84 0 2.64-1.1 4.44-3.3 5.4-.6.28-1.22.5-1.82.6l5.57 8.56h-2.85m 13.43 0h-2.4v-21.2h2.4v21.2m23.56-1.32c-1.48 1.05-3.53 1.57-6.16 1.57-2.96 0 -5.23-.6-6.78-1.85-1.4-1.1-2.18-2.7-2.37-4.74h2.5c.08 1.45.78 2.56 2.1 3.33 1.16.67 2.68 1 4.58 1 3.97 0 5.95-1.25 5.95-3.74 0-.86-.35-1.53-1.07-2.02-.7 -.5-1.6-.9-2.68-1.2-1.07-.33-2.24-.63-3.48-.9s-2.4-.65-3.5-1.08-1.97-1.02 -2.68-1.73c-.7-.72-1.07-1.68-1.07-2.9 0-1.73.65-3.13 1.97-4.22 1.32-1.08 3.32-1.62 6-1.62 2.67 0 4.75.6 6.23 1.85 1.34 1.1 2.05 2.5 2.14 4.2h-2.46c -.22-1.76-1.35-2.92-3.4-3.5-.72-.2-1.62-.3-2.7-.3s-1.98.1-2.72.35c-.74.25 -1.3.55-1.7.9-.42.35-.7.74-.83 1.17s-.2.88-.2 1.36c0 .5.2.93.62 1.33s.96.75 1.65 1.03c.68.28 1.46.52 2.33.73.88.2 1.77.43 2.67.65.9.22 1.8.48 2.68.77.87 .3 1.65.65 2.33 1.1 1.53.96 2.28 2.27 2.28 3.94 0 2-.74 3.5-2.22 4.55m28.84 1.32v-17.54l-7.84 10.08-7.97-10.08v17.54H133v-21.2h2.78l7.58 10.06 7.45 -10.05h2.8v21.2h-2.4"/></svg>Prism</a>
                        </span>
                        <a class="btn btn-sm border-radius-pill d-inline-flex align-items-center gap-2 ms-2" href="https://github.com/laurent-webdev/webdev-ui"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>
