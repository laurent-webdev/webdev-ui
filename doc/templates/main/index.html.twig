{% extends 'base.html.twig' %}

{% block title %}Documentation{% endblock %}

{% block body %}
    <h1 class="fs-5xl">webdev-ui</h1>
    <p class="fs-xl color-neutral-emphasis mt-4">Un framework CSS/JS ultra léger : le HTML natif, des variables CSS pour tout personnaliser, les thèmes clair et sombre, et pas une dépendance.</p>
    <div class="d-flex flex-wrap-wrap gap-3 mt-6">
        <a class="btn btn-lg" href="{{ path('app_accordion') }}">Voir les composants</a>
        <a class="btn btn-lg" href="{{ path('app_variables') }}">Personnaliser</a>
    </div>

    <h2 class="mt-12">Installer</h2>
    <p class="mt-2">Un fichier CSS et un fichier JS, sans rien à compiler. Le JS n'est utile qu'aux composants qui en ont besoin (la fermeture animée des dialogues et des drawers).</p>
    <pre class="mt-2" tabindex="0"><code class="language-html">&lt;link rel="stylesheet" href="…/css/app.css"&gt;
&lt;script type="module" src="…/js/bundle.js"&gt;&lt;/script&gt;</code></pre>

    <h2 class="mt-12">Ce qu'il y a dedans</h2>
    <div class="grid mt-4">
        {% for section in doc_sections %}
            <section class="card md:col-6" aria-labelledby="home-{{ section.id }}">
                <div class="card-header">
                    <h3 class="fs-lg" id="home-{{ section.id }}">{{ section.label }}</h3>
                </div>
                <div class="card-body d-flex flex-wrap-wrap align-items-start gap-2">
                    {% for link in section.links %}
                        <a class="btn btn-xs" href="{{ path(link[0]) }}">{{ link[1] }}</a>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
