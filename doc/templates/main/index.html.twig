{% extends 'base.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block body %}

    <div>
        <button class="btn-solid" type="button">base</button>
        <button class="btn-solid theme-inverse" type="button">inverse</button>
        <button class="btn-solid theme-primary" type="button">primary</button>
        <button class="btn-solid theme-secondary" type="button">secondary</button>
        <button class="btn-solid theme-accent" type="button">accent</button>
        <button class="btn-solid theme-success" type="button">success</button>
        <button class="btn-solid theme-danger" type="button">danger</button>
        <button class="btn-solid theme-warning" type="button">warning</button>
        <button class="btn-solid theme-info" type="button">info</button>
    </div>

    <div>
        <button class="btn-outline" type="button">base</button>
        <button class="btn-outline theme-inverse" type="button">inverse</button>
        <button class="btn-outline theme-primary" type="button">primary</button>
        <button class="btn-outline theme-secondary" type="button">secondary</button>
        <button class="btn-outline theme-accent" type="button">accent</button>
        <button class="btn-outline theme-success" type="button">success</button>
        <button class="btn-outline theme-danger" type="button">danger</button>
        <button class="btn-outline theme-warning" type="button">warning</button>
        <button class="btn-outline theme-info" type="button">info</button>
    </div>

    <div>
        <button class="btn-subtle" type="button">base</button>
        <button class="btn-subtle theme-inverse" type="button">inverse</button>
        <button class="btn-subtle theme-primary" type="button">primary</button>
        <button class="btn-subtle theme-secondary" type="button">secondary</button>
        <button class="btn-subtle theme-accent" type="button">accent</button>
        <button class="btn-subtle theme-success" type="button">success</button>
        <button class="btn-subtle theme-danger" type="button">danger</button>
        <button class="btn-subtle theme-warning" type="button">warning</button>
        <button class="btn-subtle theme-info" type="button">info</button>
    </div>


    <div>
        <button class="btn-text" type="button">base</button>
        <button class="btn-text theme-inverse" type="button">inverse</button>
        <button class="btn-text theme-primary" type="button">primary</button>
        <button class="btn-text theme-secondary" type="button">secondary</button>
        <button class="btn-text theme-accent" type="button">accent</button>
        <button class="btn-text theme-success" type="button">success</button>
        <button class="btn-text theme-danger" type="button">danger</button>
        <button class="btn-text theme-warning" type="button">warning</button>
        <button class="btn-text theme-info" type="button">info</button>
    </div>

    <div>
        <button class="btn-link" type="button">base</button>
        <button class="btn-link theme-inverse" type="button">inverse</button>
        <button class="btn-link theme-primary" type="button">primary</button>
        <button class="btn-link theme-secondary" type="button">secondary</button>
        <button class="btn-link theme-accent" type="button">accent</button>
        <button class="btn-link theme-success" type="button">success</button>
        <button class="btn-link theme-danger" type="button">danger</button>
        <button class="btn-link theme-warning" type="button">warning</button>
        <button class="btn-link theme-info" type="button">info</button>
    </div>

    <div class="theme-primary">
        <button class="btn-solid btn-xs" type="button">solid xs</button>
        <button class="btn-solid btn-sm" type="button">solid sm</button>
        <button class="btn-solid" type="button">solid</button>
        <button class="btn-solid btn-lg" type="button">solid lg</button>
        <button class="btn-outline btn-xs" type="button">outline xs</button>
        <button class="btn-outline btn-sm" type="button">outline sm</button>
        <button class="btn-outline" type="button">outline</button>
        <button class="btn-outline btn-lg" type="button">outline lg</button>
        <button class="btn-subtle btn-xs" type="button">subtle xs</button>
        <button class="btn-subtle btn-sm" type="button">subtle sm</button>
        <button class="btn-subtle" type="button">subtle</button>
        <button class="btn-subtle btn-lg" type="button">subtle lg</button>
        <button class="btn-text btn-xs" type="button">text xs</button>
        <button class="btn-text btn-sm" type="button">text sm</button>
        <button class="btn-text" type="button">text</button>
        <button class="btn-text btn-lg" type="button">text lg</button>
        <button class="btn-link btn-xs" type="button">link xs</button>
        <button class="btn-link btn-sm" type="button">link sm</button>
        <button class="btn-link" type="button">link</button>
        <button class="btn-link btn-lg" type="button">link lg</button>
    </div>

    <div class="theme-primary">
        <button class="btn-solid" type="button" disabled>solid disabled</button>
        <button class="btn-outline" type="button" disabled>outline disabled</button>
        <button class="btn-subtle" type="button" disabled>subtle disabled</button>
        <button class="btn-text" type="button" disabled>text disabled</button>
        <button class="btn-link" type="button" disabled>link disabled</button>
    </div>

    <div class="theme-primary">
        <button class="btn-solid" type="button">button solid</button>
        <a class="btn-solid" href="#">a solid</a>
        <button class="btn-outline" type="button">button outline</button>
        <a class="btn-outline" href="#">a outline</a>
        <button class="btn-link" type="button">button link</button>
        <a class="btn-link" href="#">a link</a>
    </div>

    <section>
        <h2>Titres</h2>
        <h1>Titre h1 (3xl)</h1>
        <h2>Titre h2 (2xl)</h2>
        <h3>Titre h3 (xl)</h3>
        <h4>Titre h4 (lg)</h4>
        <h5>Titre h5 (md)</h5>
        <h6>Titre h6 (sm)</h6>
    </section>

    <section>
        <h2>Tailles</h2>
        <p class="fs-xs">.fs-xs</p>
        <p class="fs-sm">.fs-sm</p>
        <p class="fs-md">.fs-md</p>
        <p class="fs-lg">.fs-lg</p>
        <p class="fs-xl">.fs-xl</p>
        <p class="fs-2xl">.fs-2xl</p>
        <p class="fs-3xl">.fs-3xl</p>
        <p class="fs-4xl">.fs-4xl</p>
        <p class="fs-5xl">.fs-5xl</p>
        <p class="fs-6xl">.fs-6xl</p>
    </section>

    <section>
        <h2>Graisses</h2>
        <p class="fw-light">.fw-light</p>
        <p class="fw-normal">.fw-normal</p>
        <p class="fw-medium">.fw-medium</p>
        <p class="fw-semibold">.fw-semibold</p>
        <p class="fw-bold">.fw-bold</p>
    </section>

    <section>
        <h2>Style et famille</h2>
        <p class="fst-italic">.fst-italic</p>
        <p><em class="fst-normal">.fst-normal sur un em</em></p>
        <p class="font-monospace">.font-monospace</p>
        <p>Du <code>code</code> dans un paragraphe.</p>
    </section>

    <section>
        <h2>Liens</h2>
        <p>Un paragraphe avec <a href="#">un lien au milieu du texte</a>, pour voir sa couleur, son survol et son clic.</p>
        <p>
            <a class="theme-inverse" href="#">inverse</a>
            <a class="theme-primary" href="#">primary</a>
            <a class="theme-secondary" href="#">secondary</a>
            <a class="theme-accent" href="#">accent</a>
            <a class="theme-success" href="#">success</a>
            <a class="theme-danger" href="#">danger</a>
            <a class="theme-warning" href="#">warning</a>
            <a class="theme-info" href="#">info</a>
        </p>
        <p>Comparé aux boutons : <a href="#">lien</a> <button class="btn-link" type="button">btn-link</button> <a class="theme-primary" href="#">lien primary</a> <button class="btn-link theme-primary" type="button">btn-link primary</button></p>
        <p class="theme-danger">Un parent theme-danger : <a href="#">lien</a> et <button class="btn-link" type="button">btn-link</button> prennent la même couleur.</p>
    </section>

{% endblock %}
