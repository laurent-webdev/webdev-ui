    <section>
        <h2>Couleurs</h2>
        {% set colors = ['primary', 'secondary', 'accent', 'success', 'danger', 'warning', 'info', 'neutral', 'inverse'] %}
        <p class="mt-4">bg-* color-text-on-* : fond plein, texte noir ou blanc lisible</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <div class="bg-{{ color }} color-text-on-{{ color }} p-2 col-6 md:col-4">bg-{{ color }} color-text-on-{{ color }}</div>
            {% endfor %}
        </div>
        <p class="mt-4">bg-subtle-* : fond léger, le texte reste normal</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <div class="bg-subtle-{{ color }} p-2 col-6 md:col-4">bg-subtle-{{ color }}</div>
            {% endfor %}
        </div>
        <p class="mt-4">bg-subtle-* color-emphasis-* : fond léger, texte coloré</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <div class="bg-subtle-{{ color }} color-emphasis-{{ color }} p-2 col-6 md:col-4">bg-subtle-{{ color }} color-emphasis-{{ color }}</div>
            {% endfor %}
        </div>
        <p class="mt-4">color-emphasis-* : texte coloré lisible</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <p class="color-emphasis-{{ color }} col-6 md:col-4">color-emphasis-{{ color }}</p>
            {% endfor %}
        </div>
        <p class="mt-4">color-* : couleur brute, pour une icône (le texte reste normal)</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <p class="d-flex align-items-center gap-2 col-6 md:col-4">
                    <svg class="color-{{ color }}" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/></svg>
                    color-{{ color }}
                </p>
            {% endfor %}
        </div>
        <p class="mt-4">bg-subtle-neutral color-emphasis-* : fond gris léger, texte coloré</p>
        <div class="grid gap-2 mt-2">
            {% for color in colors %}
                <div class="bg-subtle-neutral color-emphasis-{{ color }} p-2 col-6 md:col-4">bg-subtle-neutral color-emphasis-{{ color }}</div>
            {% endfor %}
        </div>
