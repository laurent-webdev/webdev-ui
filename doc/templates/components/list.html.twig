{% extends 'base.html.twig' %}

{% block title %}Liste{% endblock %}

{% block body %}
    <h1>Liste</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Une liste encadrée, un trait entre les éléments : du texte, ou des liens et des boutons cliquables sur toute la ligne.</p>

    <h2 class="mt-10">Du texte</h2>
    {% set code %}
        <ul class="list">
            <li>Un élément</li>
            <li>Un deuxième élément</li>
            <li>Un troisième, assez long pour passer à la ligne dans une colonne étroite</li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Des liens et des boutons</h2>
    <p class="mt-2"><code>list-item</code> sur le lien ou le bouton : toute la ligne se clique.</p>
    {% set code %}
        <ul class="list">
            <li><a class="list-item" href="#">Profil</a></li>
            <li><a class="list-item" href="#">Réglages</a></li>
            <li><button class="list-item" type="button" disabled>Factures (bientôt)</button></li>
            <li><button class="list-item" type="button">Se déconnecter</button></li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Couleurs et élément en cours</h2>
    <p class="mt-2">La couleur n'apparaît qu'au survol, au clic et sur l'élément en cours (<code>aria-current</code>). Sur la liste, elle vaut pour tous ses éléments ; sur un élément, pour lui seul.</p>
    {% set code %}
        <nav aria-label="Mon compte">
            <ul class="list theme-primary">
                <li><a class="list-item" href="#">Profil</a></li>
                <li><a class="list-item" href="#" aria-current="page">Réglages</a></li>
                <li><a class="list-item" href="#">Notifications</a></li>
                <li><button class="list-item theme-danger" type="button">Se déconnecter</button></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Sans bordure</h2>
    <p class="mt-2">Pour un menu de côté, ou une liste dans une carte qui a déjà son cadre.</p>
    {% set code %}
        <nav aria-label="Paramètres">
            <ul class="list list-borderless theme-primary">
                <li><a class="list-item" href="#">Profil</a></li>
                <li><a class="list-item" href="#" aria-current="page">Réglages</a></li>
                <li><a class="list-item" href="#">Notifications</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">Le padding, le texte et l'interligne : des lignes de 26, 33, 40 et 47px. Sans classe : md.</p>
    {% set code %}
        <ul class="list list-xs">
            <li>list-xs</li>
            <li>Un élément</li>
        </ul>
        <ul class="list list-sm">
            <li>list-sm</li>
            <li>Un élément</li>
        </ul>
        <ul class="list list-md">
            <li>list-md</li>
            <li>Un élément</li>
        </ul>
        <ul class="list list-lg">
            <li>list-lg</li>
            <li>Un élément</li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un texte et un badge</h2>
    {% set code %}
        <ul class="list">
            <li><a class="list-item d-flex justify-content-space-between align-items-center gap-2" href="#">Messages <span class="badge-subtle theme-primary">12<span class="visually-hidden"> non lus</span></span></a></li>
            <li><a class="list-item d-flex justify-content-space-between align-items-center gap-2" href="#">Factures <span class="badge-subtle theme-danger">1 en retard</span></a></li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Sans style</h2>
    <p class="mt-2"><code>list-unstyled</code>, seule : ni puces, ni retrait, ni cadre ; le lecteur d'écran l'annonce toujours comme une liste. L'écart vient de la grille ou du flex.</p>
    {% set code %}
        <ul class="list-unstyled d-grid gap-2">
            <li><a class="link" href="#">Livraison</a></li>
            <li><a class="link" href="#">Contact</a></li>
            <li><a class="link" href="#">Mentions légales</a></li>
        </ul>
        <ul class="list-unstyled d-flex flex-wrap-wrap gap-2">
            <li><span class="badge">Design</span></li>
            <li><span class="badge">Contenu</span></li>
            <li><span class="badge">Développement</span></li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--list-item-padding-block</th><td>0.5rem</td><td>haut et bas d'un élément</td></tr>
                <tr><th scope="row">--list-item-padding-inline</th><td>1rem</td><td>côtés d'un élément</td></tr>
                <tr><th scope="row">--list-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--list-border-width</th><td>--border-width</td><td>cadre et traits (0px dans <code>list-borderless</code>)</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les listes sans taille (list-md garde 0.5rem) : des éléments plus bas (36px), des coins carrés */
        :root {
            --list-item-padding-block: 0.375rem;
            --list-border-radius: 0px;
        }

        /* Une taille */
        .list-lg { --list-item-padding-inline: 1.5rem; }

        /* Une liste du site */
        .menu-compte { --list-item-padding-inline: 0.75rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;ul&gt;</code> et des <code>&lt;li&gt;</code> : le lecteur d'écran annonce « liste, 3 éléments ».</li>
        <li>Une liste de navigation va dans un <code>&lt;nav aria-label="…"&gt;</code> ; <code>aria-current="page"</code> sur le lien de la page affichée.</li>
        <li>L'élément en cours n'est montré que par la couleur de son fond, sous 3:1 contre la page (WCAG 1.4.1 et 1.4.11) ; le lecteur d'écran l'annonce.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sans <ul> ni <li>, pas de liste annoncée, pas de traits -->
        <div class="list">
            <a class="list-item" href="/profil">Profil</a>
        </div>
        <!-- Oui -->
        <ul class="list">
            <li><a class="list-item" href="/profil">Profil</a></li>
        </ul>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : list-item sur un texte, il prend un fond au survol comme s'il se cliquait -->
        <li class="list-item">Un élément de texte</li>
        <!-- Oui : list-item seulement sur un lien ou un bouton -->
        <li>Un élément de texte</li>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : pas de classe d'état -->
        <a class="list-item active" href="/reglages">Réglages</a>
        <!-- Oui : le lecteur d'écran l'annonce -->
        <a class="list-item" href="/reglages" aria-current="page">Réglages</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : role="list" est inutile, le W3C le signale -->
        <ul class="list" role="list">…</ul>
        <!-- Non : sur un fond plein, le survol et l'élément en cours ne se voient plus -->
        <div class="card-solid theme-primary">
            <ul class="list">…</ul>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Sans puces par <code>list-style-type: ""</code> : la liste reste annoncée dans Safari d'après un test de 2023, à vérifier avec VoiceOver.</li>
        <li>Un <code>&lt;ol class="list"&gt;</code> ou <code>list-unstyled</code> perd ses numéros.</li>
        <li>Pas encore de liste horizontale ni de titres de groupe.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <ul class="list mt-2">
        <li><button class="list-item" type="button">sans thème (neutral)</button></li>
        {% for theme in ['primary', 'secondary', 'accent', 'success', 'danger', 'warning', 'info', 'inverse'] %}
            <li><button class="list-item theme-{{ theme }}" type="button">theme-{{ theme }}</button></li>
        {% endfor %}
    </ul>
{% endblock %}
