{% extends 'base.html.twig' %}

{% block title %}Badge{% endblock %}

{% block body %}
    <h1>Badge</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Une étiquette dans le texte, qui suit sa taille. Une variante pour la forme, un <code>.theme-*</code> pour la couleur.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <span class="badge">Brouillon</span>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Variantes</h2>
    {% set code %}
        <span class="badge-solid theme-success">Payée</span>
        <span class="badge-subtle theme-success">Payée</span>
        <span class="badge-outline theme-success">Payée</span>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Couleurs</h2>
    {% set code %}
        <span class="badge-solid theme-primary">Primary</span>
        <span class="badge-solid theme-secondary">Secondary</span>
        <span class="badge-solid theme-accent">Accent</span>
        <span class="badge-solid theme-success">Success</span>
        <span class="badge-solid theme-danger">Danger</span>
        <span class="badge-solid theme-warning">Warning</span>
        <span class="badge-solid theme-info">Info</span>
        <span class="badge-solid theme-neutral">Neutral</span>
        <span class="badge-solid theme-inverse">Inverse</span>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">La taille suit le texte</h2>
    <p class="mt-2">0.75em du texte autour, jamais moins de 12px.</p>
    {% set code %}
        <p class="fs-3xl">Titre <span class="badge-solid theme-primary">Nouveau</span></p>
        <p class="fs-lg">Texte fs-lg <span class="badge-solid theme-primary">Nouveau</span></p>
        <p class="fs-sm">Texte fs-sm <span class="badge-solid theme-primary">Nouveau</span></p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-2'}) }}

    <h2 class="mt-10">Dans un bouton</h2>
    <p class="mt-2">Le texte <code>visually-hidden</code> dit ce que compte le nombre.</p>
    {% set code %}
        <button class="btn-solid theme-primary" type="button">
            Messages <span class="badge-solid theme-inverse">4<span class="visually-hidden"> non lus</span></span>
        </button>
        <button class="btn" type="button">
            Notifications <span class="badge-solid theme-danger">12<span class="visually-hidden"> nouvelles</span></span>
        </button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">En pastille</h2>
    {% set code %}
        <span class="badge-solid theme-success border-radius-pill">En ligne</span>
        <span class="badge-subtle theme-warning border-radius-pill">En attente</span>
        <span class="badge-outline theme-danger border-radius-pill">Hors ligne</span>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--badge-padding-block</th><td>0.25em</td><td>haut et bas</td></tr>
                <tr><th scope="row">--badge-padding-inline</th><td>0.5em</td><td>côtés</td></tr>
                <tr><th scope="row">--badge-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--badge-border-width</th><td>--border-width</td><td>cadre</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les badges en pastille */
        :root { --badge-border-radius: 50rem; }

        /* Un badge du site */
        .badge-statut { --badge-padding-inline: 0.75em; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le texte du badge dit ce qu'il veut dire : la couleur ne suffit pas (WCAG 1.4.1).</li>
        <li>Un nombre seul a besoin d'un texte <code>visually-hidden</code> (« non lus »).</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de couleur -->
        <span class="badge-subtle">Nouveau</span>
        <!-- Oui -->
        <span class="badge-subtle theme-primary">Nouveau</span>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un badge ne se clique pas (pas de survol ni de clic visibles) -->
        <a class="badge-subtle theme-primary" href="/tag/css">CSS</a>
        <!-- Oui : une étiquette cliquable est un bouton -->
        <a class="btn-subtle btn-xs theme-primary" href="/tag/css">CSS</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : une pastille vide, seule la couleur dit « en ligne » -->
        <span class="badge-solid theme-success"></span> Laurent
        <!-- Oui -->
        Laurent <span class="badge-solid theme-success">En ligne</span>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sur un fond plein, badge-subtle et badge-outline ne se lisent pas -->
        <button class="btn-solid theme-primary" type="button">Messages <span class="badge-outline">4</span></button>
        <!-- Oui : badge-solid d'un autre thème -->
        <button class="btn-solid theme-primary" type="button">Messages <span class="badge-solid theme-inverse">4</span></button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : le texte d'un badge ne passe pas à la ligne, il dépasse de l'écran sur téléphone -->
        <span class="badge">Livraison offerte dès 50 € d'achat en France métropolitaine</span>
        <!-- Oui : quelques mots -->
        <span class="badge">Livraison offerte</span>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas de classes de taille : le badge suit le texte autour.</li>
        <li>En clair, le cadre de <code>badge-subtle</code> se voit à peine : le fond léger délimite le badge.</li>
        <li>Un badge vide reste affiché : le site le cache (<code>hidden</code>) quand le compteur est à 0.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['solid', 'subtle', 'outline'] %}
        <h3 class="fs-md mt-6">badge-{{ variant }}</h3>
        <p class="d-flex flex-wrap-wrap gap-2 mt-2">
            {% for color in colors %}
                <span class="badge-{{ variant }} theme-{{ color }}">{{ color }}</span>
            {% endfor %}
        </p>
    {% endfor %}
{% endblock %}
