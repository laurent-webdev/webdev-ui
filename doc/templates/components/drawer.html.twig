{% extends 'base.html.twig' %}

{% block title %}Drawer{% endblock %}

{% block body %}
    <h1>Drawer</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un panneau qui glisse depuis un bord de l'écran : un <code>&lt;dialog&gt;</code> ouvert en modal, comme le dialogue. La classe dit le bord. Sur un <code>&lt;aside&gt;</code> ou un <code>&lt;nav&gt;</code>, le même panneau reste toujours là.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <button class="btn" type="button" commandfor="drawer-menu" command="show-modal">Menu</button>
        <dialog class="drawer-start" id="drawer-menu" data-dialog closedby="any" aria-labelledby="drawer-menu-titre">
            <div class="drawer-header">
                <h2 class="fs-lg" id="drawer-menu-titre">Menu</h2>
                <button class="btn-close" type="button" commandfor="drawer-menu" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body">
                <nav aria-label="Menu principal">
                    <ul class="navbar-list">
                        <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                        <li><a class="navbar-item" href="#">Produits</a></li>
                        <li><a class="navbar-item" href="#">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Les autres bords</h2>
    <p class="mt-2"><code>drawer-end</code> : toute la hauteur ; <code>drawer-top</code> et <code>drawer-bottom</code> : toute la largeur.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="drawer-droite" command="show-modal">drawer-end</button>
        <button class="btn" type="button" commandfor="drawer-haut" command="show-modal">drawer-top</button>
        <button class="btn" type="button" commandfor="drawer-bas" command="show-modal">drawer-bottom</button>

        <dialog class="drawer-end" id="drawer-droite" data-dialog closedby="any" aria-labelledby="drawer-droite-titre">
            <div class="drawer-header">
                <h2 class="fs-lg" id="drawer-droite-titre">drawer-end</h2>
                <button class="btn-close" type="button" commandfor="drawer-droite" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body"><p>Le contenu du panneau.</p></div>
        </dialog>
        <dialog class="drawer-top" id="drawer-haut" data-dialog closedby="any" aria-labelledby="drawer-haut-titre">
            <div class="drawer-header">
                <h2 class="fs-lg" id="drawer-haut-titre">drawer-top</h2>
                <button class="btn-close" type="button" commandfor="drawer-haut" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body"><p>Le contenu du panneau.</p></div>
        </dialog>
        <dialog class="drawer-bottom" id="drawer-bas" data-dialog closedby="any" aria-labelledby="drawer-bas-titre">
            <div class="drawer-header">
                <h2 class="fs-lg" id="drawer-bas-titre">drawer-bottom</h2>
                <button class="btn-close" type="button" commandfor="drawer-bas" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body"><p>Le contenu du panneau.</p></div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Toujours là, à côté du contenu</h2>
    <p class="mt-2">Sur un <code>&lt;aside&gt;</code> : une colonne collée en haut de l'écran. Sous md, il se cache et le même contenu va dans un drawer, ouvert par un bouton.</p>
    {% set code %}
        <button class="btn md:d-none" type="button" commandfor="drawer-filtres" command="show-modal">Filtres</button>
        <dialog class="drawer-start" id="drawer-filtres" data-dialog closedby="any" aria-labelledby="drawer-filtres-titre">
            <div class="drawer-header">
                <h3 class="fs-lg" id="drawer-filtres-titre">Filtres</h3>
                <button class="btn-close" type="button" commandfor="drawer-filtres" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body">…</div>
        </dialog>

        <div class="d-flex gap-4">
            <aside class="drawer-start d-none md:d-block" aria-label="Filtres">
                <div class="drawer-header">
                    <h3 class="fs-lg">Filtres</h3>
                </div>
                <div class="drawer-body">…</div>
            </aside>
            <div class="flex-grow-1">…</div>
        </div>
    {% endset %}
    {# Le même contenu dans le panneau et dans le drawer du petit écran #}
    {% set filters %}
        <fieldset class="form-field">
            <legend>Catégories</legend>
            {% for category in ['Livres', 'Musique', 'Films', 'Jeux', 'Bandes dessinées'] %}
                <label><input class="form-checkbox theme-primary" type="checkbox" name="category"> {{ category }}</label>
            {% endfor %}
        </fieldset>
    {% endset %}
    {% set demo %}
        <button class="btn md:d-none" type="button" commandfor="drawer-filtres" command="show-modal">Filtres</button>
        <dialog class="drawer-start" id="drawer-filtres" data-dialog closedby="any" aria-labelledby="drawer-filtres-titre">
            <div class="drawer-header">
                <h3 class="fs-lg" id="drawer-filtres-titre">Filtres</h3>
                <button class="btn-close" type="button" commandfor="drawer-filtres" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body">{{ filters }}</div>
        </dialog>
        <div class="d-flex gap-4 mt-2 md:mt-0">
            <aside class="drawer-start d-none md:d-block" aria-label="Filtres">
                <div class="drawer-header">
                    <h3 class="fs-lg">Filtres</h3>
                </div>
                <div class="drawer-body">{{ filters }}</div>
            </aside>
            <div class="flex-grow-1">
                {% for i in 1..12 %}
                    <h4 class="fs-md{% if not loop.first %} mt-6{% endif %}">Résultat {{ i }}</h4>
                    <p>Le contenu défile, le panneau reste collé en haut de l'écran, à côté du contenu, sans le cacher.</p>
                {% endfor %}
            </div>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: ''}) }}

    <h2 class="mt-10">Toujours là, contre le bord de l'écran</h2>
    <p class="mt-2"><code>position-fixed</code> en plus : un menu de côté. Il passe par-dessus la page, le site décale son contenu.</p>
    {% set code %}
        <nav class="drawer-start position-fixed d-none md:d-block" aria-label="Menu">
            <div class="drawer-header"><p class="fs-lg fw-semibold">Mon site</p></div>
            <div class="drawer-body">
                <ul class="navbar-list">
                    <li><a class="navbar-item" href="/" aria-current="page">Accueil</a></li>
                    <li><a class="navbar-item" href="/produits">Produits</a></li>
                </ul>
            </div>
        </nav>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" aria-expanded="false" aria-controls="drawer-fixed" data-demo-toggle>Afficher / masquer le menu fixé (à droite, à partir de md)</button>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}
    {% set code %}
        /* Dans le CSS du site : la place du panneau, à partir de md comme md:d-block */
        @media (width >= 48rem) {
            body { padding-inline-start: calc(var(--drawer-width) + var(--drawer-inset) * 2); }
        }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--drawer-width</th><td>20rem</td><td>largeur de <code>drawer-start</code> et <code>drawer-end</code></td></tr>
                <tr><th scope="row">--drawer-height</th><td>20rem</td><td>hauteur de <code>drawer-top</code> et <code>drawer-bottom</code></td></tr>
                <tr><th scope="row">--drawer-padding-block</th><td>1rem</td><td>haut et bas de l'en-tête et du corps</td></tr>
                <tr><th scope="row">--drawer-padding-inline</th><td>1rem</td><td>côtés de l'en-tête et du corps</td></tr>
                <tr><th scope="row">--drawer-inset</th><td>0.75rem</td><td>écart avec les bords de l'écran</td></tr>
                <tr><th scope="row">--drawer-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--drawer-border-width</th><td>--border-width</td><td>cadre</td></tr>
                <tr><th scope="row">--drawer-transition-duration</th><td>0.2s</td><td>glissement</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les drawers, collés au bord sans arrondi */
        :root {
            --drawer-width: 24rem;
            --drawer-inset: 0px;
            --drawer-border-radius: 0px;
        }

        /* Un drawer du site */
        .drawer-panier { --drawer-width: 30rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">JavaScript</h2>
    <p class="mt-2">Le même que le dialogue : avec <code>data-dialog</code>, le panneau glisse vers son bord avant de se fermer. Événements du navigateur : <code>command</code>, <code>cancel</code>, <code>close</code>.</p>
    {% set code %}
        document.getElementById('drawer-menu').addEventListener('close', () => { … });
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;dialog&gt;</code> modal : la page est inactive, Échap ferme, le focus entre dans le panneau puis revient.</li>
        <li><code>aria-labelledby</code> vers le titre ; la croix visible, même avec <code>closedby="any"</code>.</li>
        <li>Toujours là : <code>&lt;nav&gt;</code> pour un menu, <code>&lt;aside&gt;</code> pour un contenu à côté, avec un <code>aria-label</code>.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : un aside ouvert et fermé en JS, il faudrait refaire le focus, Échap et le fond -->
        <aside class="drawer-start" hidden>…</aside>
        <!-- Non : open affiche un panneau non modal -->
        <dialog class="drawer-start" open>…</dialog>
        <!-- Oui : un dialog ouvert par command="show-modal" -->
        <dialog class="drawer-start" id="drawer-menu" data-dialog aria-labelledby="drawer-menu-titre">…</dialog>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : fixé sans d-none md:d-block, il couvre presque tout un téléphone -->
        <nav class="drawer-start position-fixed" aria-label="Menu">…</nav>
        <!-- Oui, avec le décalage de la page dans le CSS du site -->
        <nav class="drawer-start position-fixed d-none md:d-block" aria-label="Menu">…</nav>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : drawer-top et drawer-bottom seulement sur un dialog -->
        <aside class="drawer-top" aria-label="Annonce">…</aside>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Les limites du dialogue : fermeture animée seulement avec <code>data-dialog</code>, Échap deux fois, <code>preventDefault()</code> sur <code>cancel</code>, <code>closedby</code> fait par le JS dans Safari, navigateurs récents.</li>
        <li>Pas encore de couleurs ni de tailles.</li>
        <li>Collé : un ancêtre en <code>overflow: hidden</code> ou <code>auto</code> l'empêche de coller. Fixé : un ancêtre en <code>glass</code> devient sa référence.</li>
        <li>En écriture de droite à gauche, <code>drawer-start</code> glisse depuis la gauche.</li>
    </ul>
{% endblock %}

{# Le menu fixé de la démo : hors de la carte de la page, qui en serait la référence (backdrop-filter) #}
{% block fixed %}
    <nav class="drawer-end position-fixed d-none md:d-block demo-drawer-fixed" id="drawer-fixed" aria-label="Menu (démo)" hidden>
        <div class="drawer-header">
            <p class="fs-lg fw-semibold">Mon site</p>
        </div>
        <div class="drawer-body">
            <ul class="navbar-list">
                {% for link in ['Accueil', 'Produits', 'Blog', 'À propos', 'Contact'] %}
                    <li><a class="navbar-item" href="#"{% if loop.first %} aria-current="page"{% endif %}>{{ link }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </nav>
{% endblock %}
