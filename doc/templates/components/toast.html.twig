{% extends 'base.html.twig' %}

{% block title %}Toast{% endblock %}

{% block body %}
    <h1>Toast</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Des messages courts qui s'empilent dans un coin de l'écran, puis se ferment seuls. Le site ajoute le toast dans un conteneur ; le minuteur est en CSS.</p>

    {# Le conteneur de la page, et le toast des démos de position et du dialogue #}
    <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
    <template id="toast-modele">
        <div class="toast-subtle theme-success">
            <p>Succès : profil enregistré.</p>
            <button class="btn-close-subtle" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    </template>

    <h2 class="mt-10">Le conteneur</h2>
    <p class="mt-2">Une fois dans la page, vide au chargement, à la fin du <code>&lt;body&gt;</code>.</p>
    {% set code %}
        <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2">Un texte dans un seul élément, puis la croix <code>data-toast-close</code>. Il se ferme après 5 secondes, en pause au survol et au focus.</p>
    {% set code %}
        <div class="toast">
            <p>Brouillon enregistré.</p>
            <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    {% endset %}
    {% set demo %}
        {{ code }}
        <button class="btn" type="button" data-demo-toast="toast-defaut">Afficher dans le coin</button>
        <template id="toast-defaut">{{ code }}</template>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10">Variantes</h2>
    <p class="mt-2">La croix : <code>btn-close-solid</code> sur <code>toast-solid</code>, <code>btn-close-subtle</code> sur les autres.</p>
    {% set code %}
        <div class="toast-solid theme-danger">
            <p>Erreur : le profil n'a pas été enregistré.</p>
            <button class="btn-close-solid" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
        <div class="toast-subtle theme-success">
            <p>Succès : profil enregistré.</p>
            <button class="btn-close-subtle" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
        <div class="toast-outline theme-info">
            <p>Information : une mise à jour est disponible.</p>
            <button class="btn-close-subtle" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    {% endset %}
    {% set demo %}
        {{ code }}
        <button class="btn" type="button" data-demo-toast="toast-variantes">Afficher dans le coin</button>
        <template id="toast-variantes">{{ code }}</template>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10">Avec une action</h2>
    <p class="mt-2">Un lien ou un autre bouton que la croix : pas de minuteur, il reste jusqu'à la croix (WCAG 2.2.1).</p>
    {% set code %}
        <div class="toast">
            <p>Message supprimé.</p>
            <button class="btn-solid theme-primary btn-sm" type="button">Annuler</button>
            <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
        <div class="toast-subtle theme-info">
            <p>Nouveau message de Camille. <a class="link" href="#">Voir le message</a></p>
            <button class="btn-close-subtle" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    {% endset %}
    {% set demo %}
        {{ code }}
        <button class="btn" type="button" data-demo-toast="toast-action">Afficher dans le coin</button>
        <template id="toast-action">{{ code }}</template>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10">Ajouter un toast en JavaScript</h2>
    <p class="mt-2">Un <code>&lt;template&gt;</code> par message ; le site en ajoute une copie au conteneur. Un texte qui change : <code>textContent</code>, jamais <code>innerHTML</code>.</p>
    {% set code %}
        <template id="toast-enregistre">
            <div class="toast-subtle theme-success">
                <p>Succès : profil enregistré.</p>
                <button class="btn-close-subtle" type="button" aria-label="Fermer" data-toast-close></button>
            </div>
        </template>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        const modele = document.getElementById('toast-enregistre');
        document.querySelector('[data-toast]').append(modele.content.cloneNode(true));
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}

    <h2 class="mt-10">Position</h2>
    <p class="mt-2"><code>toast-container-top</code> et <code>toast-container-start</code> se combinent. Sans elles, en bas à droite.</p>
    {% set code %}
        <div class="toast-container toast-container-top" id="toasts-haut" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
        <div class="toast-container toast-container-start" id="toasts-gauche" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
        <div class="toast-container toast-container-top toast-container-start" id="toasts-haut-gauche" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" data-demo-toast="toast-modele" data-demo-toast-container="toasts-haut">toast-container-top</button>
        <button class="btn" type="button" data-demo-toast="toast-modele" data-demo-toast-container="toasts-gauche">toast-container-start</button>
        <button class="btn" type="button" data-demo-toast="toast-modele" data-demo-toast-container="toasts-haut-gauche">Les deux</button>
        {{ code }}
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10">Depuis un dialogue</h2>
    <p class="mt-2">Le dialogue modal passe devant le conteneur de la page : il a le sien, sans <code>popover</code>.</p>
    {% set code %}
        <dialog class="dialog dialog-sm" id="dialog-profil" data-dialog closedby="any" aria-labelledby="dialog-profil-titre">
            <div class="dialog-header">
                <h3 class="fs-lg" id="dialog-profil-titre">Modifier le profil</h3>
                <button class="btn-close" type="button" commandfor="dialog-profil" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <button class="btn-solid theme-primary" type="button">Enregistrer</button>
                <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" data-toast></div>
            </div>
        </dialog>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" commandfor="dialog-profil" command="show-modal">Ouvrir le dialogue</button>
        <dialog class="dialog dialog-sm" id="dialog-profil" data-dialog closedby="any" aria-labelledby="dialog-profil-titre">
            <div class="dialog-header">
                <h3 class="fs-lg" id="dialog-profil-titre">Modifier le profil</h3>
                <button class="btn-close" type="button" commandfor="dialog-profil" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <button class="btn-solid theme-primary" type="button" data-demo-toast="toast-modele">Enregistrer</button>
                <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" data-toast></div>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--toast-padding-block</th><td>0.75rem</td><td>haut et bas d'un toast</td></tr>
                <tr><th scope="row">--toast-padding-inline</th><td>1rem</td><td>côtés d'un toast</td></tr>
                <tr><th scope="row">--toast-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--toast-border-width</th><td>--border-width</td><td>cadre</td></tr>
                <tr><th scope="row">--toast-width</th><td>22rem</td><td>largeur du conteneur</td></tr>
                <tr><th scope="row">--toast-inset</th><td>1rem</td><td>écart avec les bords de l'écran</td></tr>
                <tr><th scope="row">--toast-duration</th><td>5s</td><td>temps d'affichage</td></tr>
                <tr><th scope="row">--toast-transition-duration</th><td>0.2s</td><td>apparition et fondu</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les toasts : 8 secondes */
        :root { --toast-duration: 8s; }

        /* Le conteneur du haut, sous un en-tête de 4rem */
        .toast-container-top { --toast-inset: 5rem; }

        /* Un toast du site */
        .toast-erreur { --toast-duration: 12s; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10" id="javascript">JavaScript</h2>
    <p class="mt-2">Rien à écrire : <code>dist/js/webdev-ui.js</code> ouvre les conteneurs au chargement et retire les toasts fermés. Pas d'événement. Un conteneur ajouté plus tard : <code>showPopover()</code>.</p>
    <div class="table-responsive mt-2" role="region" aria-labelledby="javascript" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Attribut</th>
                    <th scope="col">Sur</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">data-toast</th><td>le conteneur</td><td>ouvert au chargement, ses toasts retirés à la fin</td></tr>
                <tr><th scope="row">data-toast-close</th><td>la croix</td><td>ferme le toast qui la contient</td></tr>
                <tr><th scope="row">data-closing</th><td>le toast, posé par le JS</td><td>le fondu de fermeture</td></tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le conteneur est une zone <code>role="status"</code> présente dès le chargement : chaque toast ajouté est lu, sans interrompre.</li>
        <li><code>aria-atomic="false"</code> : seul le nouveau toast est lu, pas toute la pile.</li>
        <li>Le texte dit le type du message (« Erreur : ») ; une erreur qui demande d'agir va dans la page (une alerte).</li>
        <li>Le toast ne prend pas le focus ; animations réduites : ni glissement ni fondu, mais il reste 5 secondes.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de fond -->
        <div class="toast-subtle">…</div>
        <!-- Non : role="alert" interrompt la lecture et double l'annonce du conteneur -->
        <div class="toast-solid theme-danger" role="alert">…</div>
        <!-- Oui -->
        <div class="toast-solid theme-danger">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans popover, il passe sous ce qui est positionné ; sans data-toast, il n'est jamais ouvert -->
        <div class="toast-container" role="status" aria-live="polite" aria-atomic="false"></div>
        <!-- Non : dans un dialogue, avec popover, il reste sous le dialogue -->
        <dialog class="dialog">
            <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>
        </dialog>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : le texte et la croix sont sur une ligne, le titre et le paragraphe se mettent côte à côte -->
        <div class="toast">
            <h3>Profil</h3>
            <p>Enregistré.</p>
            <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
        <!-- Oui : le texte dans un seul élément -->
        <div class="toast">
            <div><h3>Profil</h3><p>Enregistré.</p></div>
            <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        // Non : un message d'utilisateur écrit en HTML peut contenir du code, et les toasts déjà là sont réécrits
        conteneur.innerHTML += `<div class="toast"><p>${message}</p>…</div>`;
        // Non : la zone role="status" ajoutée avec son message, rien n'est lu
        document.body.append(conteneurAvecToast);
        // Oui : la copie d'un template, le texte par textContent
        const toast = modele.content.cloneNode(true);
        toast.querySelector('p').textContent = message;
        conteneur.append(toast);
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Fermé à la croix au clavier, le focus repart au début de la page.</li>
        <li>Quand un toast part, ceux d'au-dessus descendent d'un coup. Pas de limite au nombre de toasts.</li>
        <li>Un toast déjà dans le HTML au chargement n'est pas lu : après un rechargement, une alerte.</li>
        <li>Sur <code>toast-solid</code>, le contour de focus de la croix est sous 3:1 en sombre.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['solid', 'subtle', 'outline'] %}
        <h3 class="fs-md mt-6">toast-{{ variant }}</h3>
        <div class="grid gap-3 mt-2">
            {% for color in colors %}
                <div class="toast-{{ variant }} theme-{{ color }} md:col-6 lg:col-4">
                    <p>theme-{{ color }} : profil enregistré.</p>
                    <button class="{{ variant == 'solid' ? 'btn-close-solid' : 'btn-close-subtle' }}" type="button" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
