{% extends 'base.html.twig' %}

{% block title %}Pagination{% endblock %}

{% block body %}
    <h1>Pagination</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Les liens vers les pages d'une liste longue : une liste de liens dans un <code>&lt;nav&gt;</code>, sans JavaScript. Le site écrit les numéros, le framework ne calcule rien.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2"><code>aria-current="page"</code> sur la page affichée, <code>aria-label="Page 2"</code> sur un numéro.</p>
    {% set code %}
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li><a class="pagination-item" href="#" rel="prev">Précédent</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 1">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2" aria-current="page">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
                <li>…</li>
                <li><a class="pagination-item" href="#" aria-label="Page 12">12</a></li>
                <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Variantes</h2>
    {% set code %}
        <nav aria-label="Pagination subtle">
            <ul class="pagination-subtle theme-primary">
                <li><a class="pagination-item" href="#" rel="prev">Précédent</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 1">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2" aria-current="page">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
                <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
            </ul>
        </nav>
        <nav aria-label="Pagination solid">
            <ul class="pagination-solid theme-primary">
                <li><a class="pagination-item" href="#" rel="prev">Précédent</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 1">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2" aria-current="page">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
                <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Éléments collés</h2>
    <p class="mt-2"><code>pagination-group</code> s'ajoute à <code>pagination</code>, <code>pagination-subtle</code> ou <code>pagination-solid</code>.</p>
    {% set code %}
        <nav aria-label="Pagination groupée">
            <ul class="pagination-solid pagination-group theme-primary">
                <li><a class="pagination-item" href="#" rel="prev">Précédent</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 1">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2" aria-current="page">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
                <li>…</li>
                <li><a class="pagination-item" href="#" aria-label="Page 12">12</a></li>
                <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">31, 36 et 41px de haut, comme les boutons.</p>
    {% set code %}
        <nav aria-label="Pagination petite">
            <ul class="pagination-solid pagination-sm theme-primary">
                <li><a class="pagination-item" href="#" aria-label="Page 1" aria-current="page">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
            </ul>
        </nav>
        <nav aria-label="Pagination moyenne">
            <ul class="pagination-solid pagination-md theme-primary">
                <li><a class="pagination-item" href="#" aria-label="Page 1" aria-current="page">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
            </ul>
        </nav>
        <nav aria-label="Pagination grande">
            <ul class="pagination-solid pagination-lg theme-primary">
                <li><a class="pagination-item" href="#" aria-label="Page 1" aria-current="page">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2">2</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 3">3</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Première page</h2>
    <p class="mt-2">Précédent sans <code>href</code> ni <code>rel</code> : estompé, hors du clavier. Pareil pour Suivant sur la dernière page.</p>
    {% set code %}
        <nav aria-label="Pagination, première page">
            <ul class="pagination-solid theme-primary">
                <li><a class="pagination-item">Précédent</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 1" aria-current="page">1</a></li>
                <li><a class="pagination-item" href="#" aria-label="Page 2">2</a></li>
                <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Des boutons</h2>
    <p class="mt-2">Quand le JavaScript du site change les résultats sans changer de page : <code>disabled</code>, et <code>aria-current="true"</code> déplacé par le site.</p>
    {% set code %}
        <nav aria-label="Résultats">
            <ul class="pagination-subtle theme-secondary">
                <li><button class="pagination-item" type="button" disabled>Précédent</button></li>
                <li><button class="pagination-item" type="button" aria-label="Page 1" aria-current="true">1</button></li>
                <li><button class="pagination-item" type="button" aria-label="Page 2">2</button></li>
                <li><button class="pagination-item" type="button">Suivant</button></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--pagination-item-padding-block</th><td>0.3125rem</td><td>haut et bas d'un élément</td></tr>
                <tr><th scope="row">--pagination-item-padding-inline</th><td>0.625rem</td><td>côtés d'un élément</td></tr>
                <tr><th scope="row">--pagination-item-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--pagination-item-border-width</th><td>--border-width</td><td>épaisseur du cadre</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les paginations en pilule */
        :root { --pagination-item-border-radius: var(--border-radius-pill); }

        /* Une taille */
        .pagination-sm { --pagination-item-padding-inline: 0.375rem; }

        /* Une pagination du site */
        .pagination-articles { --pagination-item-padding-block: 0.5rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;nav&gt;</code> avec un <code>aria-label</code> différent pour chaque pagination de la page.</li>
        <li><code>aria-label="Page 2"</code> contient le texte visible : une commande vocale « cliquer 2 » marche (WCAG 2.5.3).</li>
        <li>La page en cours ne se voit que par son fond, sous 3:1 en subtle et sans couleur : <code>pagination-solid</code> ou <code>pagination-group</code> la montrent mieux.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-*, la page en cours ne se voit plus -->
        <ul class="pagination-solid">…</ul>
        <!-- Non : pagination-group seul, les éléments ne sont plus en ligne -->
        <ul class="pagination-group theme-primary">…</ul>
        <!-- Oui -->
        <ul class="pagination-solid pagination-group theme-primary">…</ul>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : aria-disabled, le lien reste cliquable ; rel sans href, refusé par le W3C -->
        <a class="pagination-item" href="?page=0" aria-disabled="true">Précédent</a>
        <a class="pagination-item" rel="prev">Précédent</a>
        <!-- Oui : ni href ni rel -->
        <a class="pagination-item">Précédent</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : pas de classe d'état -->
        <a class="pagination-item active" href="?page=2">2</a>
        <!-- Oui -->
        <a class="pagination-item" href="?page=2" aria-label="Page 2" aria-current="page">2</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans <nav>, <ul> ni <li>, pas de zone de navigation ni de liste annoncées -->
        <div class="pagination">
            <a class="pagination-item" href="?page=1">1</a>
            <span>…</span>
        </div>
        <!-- Oui -->
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li><a class="pagination-item" href="?page=1" aria-label="Page 1">1</a></li>
                <li>…</li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Dans <code>pagination-group</code>, sur un écran étroit, le groupe passe à la ligne sans coins arrondis aux bouts de chaque ligne : afficher moins de numéros.</li>
        <li>Dans <code>pagination-group</code>, un élément désactivé pâlit avec son morceau de cadre.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['subtle', 'solid'] %}
        <h3 class="fs-md mt-6">pagination-{{ variant }}</h3>
        {% for color in colors %}
            <nav class="mt-2" aria-label="pagination-{{ variant }} theme-{{ color }} (démo)">
                <ul class="pagination-{{ variant }} theme-{{ color }}">
                    <li><a class="pagination-item" href="#" rel="prev">Précédent</a></li>
                    {% for page in 1..4 %}
                        <li><a class="pagination-item" href="#" aria-label="Page {{ page }}"{% if page == 2 %} aria-current="true"{% endif %}>{{ page }}</a></li>
                    {% endfor %}
                    <li><a class="pagination-item" href="#" rel="next">Suivant</a></li>
                </ul>
            </nav>
        {% endfor %}
    {% endfor %}
{% endblock %}
