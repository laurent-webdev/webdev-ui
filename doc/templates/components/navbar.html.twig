{% extends 'base.html.twig' %}

{% block title %}Navbar{% endblock %}

{% block body %}
    {% set links = ['Accueil', 'Produits', 'Tarifs', 'Contact'] %}

    <h1>Navbar</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">La barre de navigation du site : son nom, puis ses liens. Sur petit écran, un bouton ouvre les liens dans un drawer ; à partir du breakpoint choisi, ils passent dans la barre.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2">Les liens sont écrits deux fois : dans la barre et dans le drawer. <code>md:navbar-expand</code> : dans la barre à partir de 768px (rétrécir la fenêtre pour voir le passage).</p>
    {% set code %}
        <nav class="navbar md:navbar-expand" aria-label="Principal">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                <li><a class="navbar-item" href="#">Produits</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
            <button class="btn navbar-toggle" type="button" commandfor="navbar-menu" command="show-modal" aria-label="Menu"></button>
            <dialog class="drawer-end" id="navbar-menu" data-dialog closedby="any" aria-labelledby="navbar-menu-titre">
                <div class="drawer-header">
                    <h2 class="fs-lg" id="navbar-menu-titre">Menu</h2>
                    <button class="btn-close" type="button" commandfor="navbar-menu" command="close" aria-label="Fermer"></button>
                </div>
                <div class="drawer-body">
                    <ul class="navbar-list">
                        <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                        <li><a class="navbar-item" href="#">Produits</a></li>
                        <li><a class="navbar-item" href="#">Contact</a></li>
                    </ul>
                </div>
            </dialog>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="breakpoint">Quand passer les liens dans la barre</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="breakpoint" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Classe</th>
                    <th scope="col">Les liens dans la barre</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">aucune</th><td>jamais : le bouton et le drawer sur tous les écrans</td></tr>
                <tr><th scope="row">navbar-expand</th><td>toujours : pas de bouton ni de drawer</td></tr>
                <tr><th scope="row">xs:navbar-expand … 2xl:navbar-expand</th><td>à partir de ce breakpoint</td></tr>
            </tbody>
        </table>
    </div>
    <p class="mt-2">Toujours le drawer : une seule liste, celle du drawer.</p>
    {% set code %}
        <nav class="navbar" aria-label="Compte">
            <a class="navbar-brand" href="#">Mon site</a>
            <button class="btn navbar-toggle" type="button" commandfor="navbar-compte" command="show-modal" aria-label="Menu"></button>
            <dialog class="drawer-end" id="navbar-compte" data-dialog closedby="any" aria-labelledby="navbar-compte-titre">
                <div class="drawer-header">
                    <h2 class="fs-lg" id="navbar-compte-titre">Menu</h2>
                    <button class="btn-close" type="button" commandfor="navbar-compte" command="close" aria-label="Fermer"></button>
                </div>
                <div class="drawer-body">
                    <ul class="navbar-list">
                        <li><a class="navbar-item" href="#">Profil</a></li>
                        <li><button class="navbar-item" type="button">Se déconnecter</button></li>
                    </ul>
                </div>
            </dialog>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">La couleur n'apparaît qu'au survol, au clic et sur la page en cours.</p>
    {% set code %}
        <nav class="navbar navbar-expand theme-primary" aria-label="Produits">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#">Accueil</a></li>
                <li><a class="navbar-item" href="#" aria-current="page">Produits</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'overflow-x-auto'}) }}

    <h2 class="mt-10">Variantes</h2>
    <p class="mt-2">Un fond de la couleur pour la barre ; le drawer garde le fond de la page.</p>
    {% set code %}
        <nav class="navbar-subtle navbar-expand theme-primary" aria-label="Barre subtle">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
        </nav>
        <nav class="navbar-solid navbar-expand theme-primary" aria-label="Barre solid">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4 overflow-x-auto'}) }}

    <h2 class="mt-10">Une barre colorée avec un drawer</h2>
    <p class="mt-2">Sur <code>navbar-solid</code>, le bouton du menu est un <code>btn-solid</code> d'un autre thème.</p>
    {% set code %}
        <nav class="navbar-solid theme-primary md:navbar-expand" aria-label="Barre colorée">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
            <button class="btn-solid theme-inverse navbar-toggle" type="button" commandfor="navbar-couleur" command="show-modal" aria-label="Menu"></button>
            <dialog class="drawer-end" id="navbar-couleur" data-dialog closedby="any" aria-labelledby="navbar-couleur-titre">
                <div class="drawer-header">
                    <h2 class="fs-lg" id="navbar-couleur-titre">Menu</h2>
                    <button class="btn-close" type="button" commandfor="navbar-couleur" command="close" aria-label="Fermer"></button>
                </div>
                <div class="drawer-body">
                    <ul class="navbar-list">
                        <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                        <li><a class="navbar-item" href="#">Contact</a></li>
                    </ul>
                </div>
            </dialog>
        </nav>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">En haut de la page</h2>
    <p class="mt-2"><code>container</code> sur la navbar aligne son contenu sur celui de la page.</p>
    {% set code %}
        <header class="border-bottom">
            <nav class="navbar md:navbar-expand container theme-primary" aria-label="Principal">
                <a class="navbar-brand" href="/">Mon site</a>
                <ul class="navbar-list">…</ul>
                <button class="btn-subtle navbar-toggle" type="button" commandfor="menu" command="show-modal" aria-label="Menu"></button>
                <dialog class="drawer-start" id="menu" data-dialog closedby="any" aria-labelledby="menu-titre">…</dialog>
            </nav>
        </header>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--navbar-padding-block</th><td>0.5rem</td><td>haut et bas de la barre</td></tr>
                <tr><th scope="row">--navbar-padding-inline</th><td>1rem</td><td>côtés de <code>navbar-subtle</code> et <code>navbar-solid</code></td></tr>
                <tr><th scope="row">--navbar-item-padding-block</th><td>0.3125rem</td><td>haut et bas d'un lien</td></tr>
                <tr><th scope="row">--navbar-item-padding-inline</th><td>0.75rem</td><td>côtés d'un lien</td></tr>
                <tr><th scope="row">--navbar-item-border-radius</th><td>--border-radius-md</td><td>coins du fond d'un lien</td></tr>
                <tr><th scope="row">--navbar-item-border-width</th><td>--border-width</td><td>épaisseur du cadre transparent d'un lien</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les barres : plus hautes, des liens en pilule */
        :root {
            --navbar-padding-block: 1rem;
            --navbar-item-border-radius: var(--border-radius-pill);
        }

        /* Une barre du site */
        .navbar-compacte { --navbar-item-padding-inline: 0.5rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;nav&gt;</code> avec un <code>aria-label</code> différent pour chaque navigation de la page.</li>
        <li><code>aria-current="page"</code> dans les deux listes ; à l'écran, seulement le fond, sous 3:1 contre la page.</li>
        <li>Le bouton a un <code>aria-label</code> (« Menu ») ; il ouvre un dialogue modal, qui s'annonce lui-même : pas d'<code>aria-expanded</code>.</li>
        <li>Une seule liste se montre à la fois : l'autre n'est ni lue ni prise au clavier.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sans aria-label, le lecteur d'écran dit seulement « bouton » -->
        <button class="btn navbar-toggle" type="button" commandfor="menu" command="show-modal"></button>
        <!-- Non : une variante sans .theme-*, les traits sans fond ni cadre -->
        <button class="btn-subtle navbar-toggle" type="button" commandfor="menu" command="show-modal" aria-label="Menu"></button>
        <!-- Oui -->
        <button class="btn navbar-toggle" type="button" commandfor="menu" command="show-modal" aria-label="Menu"></button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : la liste dans un <div>, elle s'empile sur tous les écrans -->
        <nav class="navbar md:navbar-expand" aria-label="Principal">
            <div><ul class="navbar-list">…</ul></div>
        </nav>
        <!-- Non : md:navbar-expand sans la liste de la barre, aucun lien à partir de 768px -->
        <nav class="navbar md:navbar-expand" aria-label="Principal">
            <button class="btn navbar-toggle" …></button>
            <dialog class="drawer-end" …>…</dialog>
        </nav>
        <!-- Oui : la liste enfant direct de la navbar, et la même dans le drawer -->
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un div n'est pas une zone de navigation ; deux classes de barre -->
        <div class="navbar" aria-label="Principal">…</div>
        <nav class="navbar navbar-solid theme-primary" aria-label="Principal">…</nav>
        <!-- Oui -->
        <nav class="navbar-solid theme-primary" aria-label="Principal">…</nav>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : colorée par les utilitaires, le voile gris des liens se voit mal -->
        <header class="bg-primary color-primary-contrast">
            <nav class="navbar md:navbar-expand" aria-label="Principal">…</nav>
        </header>
        <!-- Oui -->
        <nav class="navbar-solid theme-primary md:navbar-expand" aria-label="Principal">…</nav>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Élargir la fenêtre avec le drawer ouvert le laisse ouvert.</li>
        <li>Un lien vers une ancre de la même page (#contact) laisse le drawer ouvert.</li>
        <li>Dans la barre, un lien ne passe pas à la ligne : avec trop de liens, la barre dépasse de l'écran. Choisir un breakpoint plus grand.</li>
        <li><code>navbar-expand</code> sans breakpoint garde les liens dans la barre même sur téléphone : à 320px, le nom du site et trois liens ne tiennent plus. Seulement pour une barre de deux liens courts ; sinon <code>md:navbar-expand</code> et le drawer.</li>
        <li>Pas de menu déroulant ni de barre fixée en haut au défilement ; pas de <code>container</code> à l'intérieur de la barre.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    <div class="overflow-x-auto">
        {% for variant in ['', '-subtle', '-solid'] %}
            <h3 class="fs-md mt-6">navbar{{ variant }}</h3>
            {% for color in colors %}
                <nav class="navbar{{ variant }} navbar-expand theme-{{ color }} mt-2" aria-label="navbar{{ variant }} theme-{{ color }} (démo)">
                    <a class="navbar-brand" href="#">theme-{{ color }}</a>
                    <ul class="navbar-list">
                        {% for link in links|slice(0, 3) %}
                            <li><a class="navbar-item" href="#"{% if loop.index == 2 %} aria-current="true"{% endif %}>{{ link }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endfor %}
        {% endfor %}
    </div>
{% endblock %}
