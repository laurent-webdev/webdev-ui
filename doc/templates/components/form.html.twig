{% extends 'base.html.twig' %}

{% block title %}Formulaire{% endblock %}

{% block body %}
    <h1>Formulaire</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Les champs du navigateur, mis en forme : <code>form-input</code> sur <code>input</code>, <code>select</code> et <code>textarea</code> ; cases, boutons radio et range colorés par le thème ; un switch dessiné. Le navigateur vérifie les champs, sans JavaScript.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2"><code>form-field</code> empile le libellé, le champ et son aide.</p>
    {% set code %}
        <div class="form-field">
            <label for="f-email">Adresse e-mail (obligatoire)</label>
            <input class="form-input" id="f-email" type="email" name="email" autocomplete="email" required aria-describedby="f-email-aide">
            <p class="fs-sm color-neutral-emphasis" id="f-email-aide">Exemple : nom@domaine.fr</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Un formulaire</h2>
    <p class="mt-2">La grille place les champs côte à côte. Envoyer vide : le navigateur s'arrête sur le premier champ obligatoire.</p>
    {% set code %}
        <form class="grid">
            <div class="form-field md:col-6">
                <label for="f-nom">Nom (obligatoire)</label>
                <input class="form-input" id="f-nom" type="text" name="nom" autocomplete="name" required>
            </div>
            <div class="form-field md:col-6">
                <label for="f-pays">Pays</label>
                <select class="form-input" id="f-pays" name="pays" autocomplete="country">
                    <option value="BE">Belgique</option>
                    <option value="FR" selected>France</option>
                    <option value="CH">Suisse</option>
                </select>
            </div>
            <div class="form-field">
                <label for="f-message">Message</label>
                <textarea class="form-input" id="f-message" name="message" rows="3"></textarea>
            </div>
            <fieldset class="form-field">
                <legend>Être contacté</legend>
                <label><input type="radio" name="contact" value="email" checked> Par e-mail</label>
                <label><input type="radio" name="contact" value="telephone"> Par téléphone</label>
            </fieldset>
            <div>
                <label><input type="checkbox" name="conditions" required> J'accepte les conditions (obligatoire)</label>
            </div>
            <div>
                <button class="btn-solid theme-primary" type="submit">Envoyer</button>
            </div>
        </form>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Champs de texte</h2>
    {% set code %}
        <div class="form-field">
            <label for="f-texte">Texte (text)</label>
            <input class="form-input" id="f-texte" type="text" name="texte">
        </div>
        <div class="form-field">
            <label for="f-mot-de-passe">Mot de passe (password)</label>
            <input class="form-input" id="f-mot-de-passe" type="password" name="mot-de-passe" autocomplete="current-password">
        </div>
        <div class="form-field">
            <label for="f-recherche">Recherche (search)</label>
            <input class="form-input" id="f-recherche" type="search" name="recherche">
        </div>
        <div class="form-field">
            <label for="f-telephone">Téléphone (tel)</label>
            <input class="form-input" id="f-telephone" type="tel" name="telephone" autocomplete="tel">
        </div>
        <div class="form-field">
            <label for="f-site">Site web (url)</label>
            <input class="form-input" id="f-site" type="url" name="site" autocomplete="url">
        </div>
        <div class="form-field">
            <label for="f-texte-long">Texte long (textarea)</label>
            <textarea class="form-input" id="f-texte-long" name="texte-long" rows="3"></textarea>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Nombres et dates</h2>
    {% set code %}
        <div class="form-field">
            <label for="f-quantite">Quantité (number)</label>
            <input class="form-input" id="f-quantite" type="number" name="quantite" min="1" max="10" value="1">
        </div>
        <div class="form-field">
            <label for="f-date">Date (date)</label>
            <input class="form-input" id="f-date" type="date" name="date">
        </div>
        <div class="form-field">
            <label for="f-heure">Heure (time)</label>
            <input class="form-input" id="f-heure" type="time" name="heure">
        </div>
        <div class="form-field">
            <label for="f-date-heure">Date et heure (datetime-local)</label>
            <input class="form-input" id="f-date-heure" type="datetime-local" name="date-heure">
        </div>
        <div class="form-field">
            <label for="f-mois">Mois (month)</label>
            <input class="form-input" id="f-mois" type="month" name="mois">
        </div>
        <div class="form-field">
            <label for="f-semaine">Semaine (week)</label>
            <input class="form-input" id="f-semaine" type="week" name="semaine">
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Listes</h2>
    <p class="mt-2">Avec <code>multiple</code> ou <code>size</code>, la liste est affichée en entier.</p>
    {% set code %}
        <div class="form-field">
            <label for="f-liste">Liste (select)</label>
            <select class="form-input" id="f-liste" name="liste">
                <option value="">Choisir…</option>
                <option value="fr">France</option>
                <option value="be">Belgique</option>
            </select>
        </div>
        <div class="form-field">
            <label for="f-groupes">Avec des groupes (optgroup)</label>
            <select class="form-input" id="f-groupes" name="groupes">
                <optgroup label="Fruits">
                    <option value="pomme">Pomme</option>
                    <option value="poire">Poire</option>
                </optgroup>
                <optgroup label="Légumes">
                    <option value="carotte">Carotte</option>
                </optgroup>
            </select>
        </div>
        <div class="form-field">
            <label for="f-suggestions">Suggestions (datalist)</label>
            <input class="form-input" id="f-suggestions" type="text" name="suggestions" list="f-navigateurs">
            <datalist id="f-navigateurs">
                <option value="Chrome"></option>
                <option value="Firefox"></option>
                <option value="Safari"></option>
            </datalist>
        </div>
        <div class="form-field">
            <label for="f-plusieurs">Plusieurs choix (multiple)</label>
            <select class="form-input" id="f-plusieurs" name="plusieurs" multiple size="3">
                <option value="fr">Français</option>
                <option value="en">Anglais</option>
                <option value="es">Espagnol</option>
            </select>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Fichier, couleur et range</h2>
    {% set code %}
        <div class="form-field">
            <label for="f-fichier">Fichier (file)</label>
            <input class="form-input" id="f-fichier" type="file" name="fichier">
        </div>
        <div class="form-field">
            <label for="f-couleur">Couleur (color)</label>
            <input id="f-couleur" type="color" name="couleur" value="#118ab2">
        </div>
        <div class="form-field">
            <label for="f-volume">Volume (range)</label>
            <input class="form-range" id="f-volume" type="range" name="volume" min="0" max="100" value="50">
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Cases et boutons radio</h2>
    <p class="mt-2">Un <code>&lt;fieldset class="form-field"&gt;</code> et une <code>&lt;legend&gt;</code> ; la case dans son libellé.</p>
    {% set code %}
        <fieldset class="form-field">
            <legend>Recevoir</legend>
            <label><input type="checkbox" name="nouveautes" checked> Les nouveautés</label>
            <label><input type="checkbox" name="offres"> Les offres</label>
            <label><input type="checkbox" name="partenaires" disabled> Les partenaires (bientôt)</label>
        </fieldset>
        <fieldset class="form-field">
            <legend>Livraison</legend>
            <label><input type="radio" name="livraison" value="domicile" checked> À domicile</label>
            <label><input type="radio" name="livraison" value="relais"> En point relais</label>
        </fieldset>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">États</h2>
    {% set code %}
        <div class="form-field">
            <label for="f-obligatoire">Obligatoire (required)</label>
            <input class="form-input" id="f-obligatoire" type="text" name="obligatoire" required>
        </div>
        <div class="form-field">
            <label for="f-lecture">Lecture seule (readonly) : envoyé</label>
            <input class="form-input" id="f-lecture" type="text" name="lecture" value="Pas modifiable" readonly>
        </div>
        <div class="form-field">
            <label for="f-desactive">Désactivé (disabled) : pas envoyé</label>
            <input class="form-input" id="f-desactive" type="text" name="desactive" value="Pas modifiable" disabled>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Erreur</h2>
    <p class="mt-2"><code>aria-invalid="true"</code> pose le thème danger ; le message, relié par <code>aria-describedby</code>, commence par « Erreur : ».</p>
    {% set code %}
        <div class="form-field">
            <label for="f-email-pris">Adresse e-mail (obligatoire)</label>
            <input class="form-input" id="f-email-pris" type="email" name="email-pris" value="nom@domaine.fr" autocomplete="email" required aria-invalid="true" aria-describedby="f-email-pris-erreur">
            <p class="fs-sm color-danger-emphasis" id="f-email-pris-erreur">Erreur : cette adresse a déjà un compte.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Libellé à côté</h2>
    <p class="mt-2">Une grille : le libellé en <code>md:col-3</code>, le champ en <code>md:col-9</code> ; une case dans un <code>&lt;div&gt;</code> de sa colonne.</p>
    {% set code %}
        <div class="grid row-gap-3 align-items-center">
            <label class="md:col-3" for="f-cote-nom">Nom</label>
            <input class="form-input md:col-9" id="f-cote-nom" type="text" name="cote-nom">

            <label class="md:col-3" for="f-cote-pays">Pays</label>
            <select class="form-input md:col-9" id="f-cote-pays" name="cote-pays">
                <option>France</option>
                <option>Belgique</option>
            </select>

            <label class="md:col-3" for="f-cote-nouveautes">Nouveautés</label>
            <div class="md:col-9"><input class="form-checkbox theme-primary" id="f-cote-nouveautes" type="checkbox" name="cote-nouveautes" checked></div>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Groupe</h2>
    <p class="mt-2">Un champ, des boutons et des textes collés sur une ligne ; le champ prend la place qui reste.</p>
    {% set code %}
        <div class="form-field">
            <label for="f-groupe-recherche">Rechercher</label>
            <div class="form-input-group">
                <input class="form-input" id="f-groupe-recherche" type="search" name="groupe-recherche">
                <button class="btn-solid theme-primary" type="button">Rechercher</button>
            </div>
        </div>
        <div class="form-field">
            <label for="f-groupe-utilisateur">Nom d'utilisateur</label>
            <div class="form-input-group">
                <span class="form-input-group-text">@</span>
                <input class="form-input" id="f-groupe-utilisateur" type="text" name="groupe-utilisateur" autocomplete="username">
            </div>
        </div>
        <div class="form-field">
            <label for="f-groupe-prix">Prix, en euros</label>
            <div class="form-input-group">
                <input class="form-input" id="f-groupe-prix" type="number" name="groupe-prix" min="0" step="0.01">
                <span class="form-input-group-text">€</span>
            </div>
        </div>
        <div class="form-field">
            <label for="f-groupe-code">Code promo</label>
            <div class="form-input-group">
                <input class="form-input" id="f-groupe-code" type="text" name="groupe-code" value="NOEL2025" aria-invalid="true" aria-describedby="f-groupe-code-erreur">
                <button class="btn" type="button">Valider</button>
            </div>
            <p class="fs-sm color-danger-emphasis" id="f-groupe-code-erreur">Erreur : ce code a expiré.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Switch</h2>
    <p class="mt-2">Une case avec <code>role="switch"</code>, sans JavaScript. <code>form-switch</code> sans couleur, <code>form-switch-solid</code> avec un <code>.theme-*</code>.</p>
    {% set code %}
        <fieldset class="form-field">
            <legend>Notifications</legend>
            <label><input class="form-switch" type="checkbox" role="switch" name="switch-email" checked> Par e-mail</label>
            <label><input class="form-switch-solid theme-primary" type="checkbox" role="switch" name="switch-sms" checked> Par SMS</label>
            <label><input class="form-switch-solid theme-primary" type="checkbox" role="switch" name="switch-push"> Sur le téléphone</label>
            <label><input class="form-switch-solid theme-primary" type="checkbox" role="switch" name="switch-courrier" disabled> Par courrier (bientôt)</label>
        </fieldset>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Une liste de réglages</h2>
    {% set code %}
        <div class="theme-primary">
            <label class="d-flex justify-content-space-between align-items-center gap-4 py-2 border-bottom">Mode sombre <input class="form-switch-solid" type="checkbox" role="switch" name="reglage-sombre"></label>
            <label class="d-flex justify-content-space-between align-items-center gap-4 py-2 border-bottom">Sauvegarde automatique <input class="form-switch-solid" type="checkbox" role="switch" name="reglage-sauvegarde" checked></label>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">Le cadre des champs, le bouton du champ fichier, la case cochée, le range et le switch allumé prennent la couleur du thème.</p>
    {% set code %}
        <form class="form-field theme-primary">
            <label for="f-couleur-nom">Nom</label>
            <input class="form-input" id="f-couleur-nom" type="text" name="couleur-nom">
            <input class="form-input" type="file" name="couleur-fichier" aria-label="Fichier">
            <input class="form-range" type="range" name="couleur-volume" aria-label="Volume">
            <label><input class="form-checkbox" type="checkbox" name="couleur-case" checked> Case</label>
            <label><input class="form-radio" type="radio" name="couleur-radio" checked> Bouton radio</label>
            <label><input class="form-switch-solid" type="checkbox" role="switch" name="couleur-switch" checked> Switch</label>
        </form>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2"><code>form-sm</code>, <code>form-md</code> ou <code>form-lg</code> sur un parent : tout ce qu'il contient (31, 38, 45px).</p>
    {% set code %}
        <form class="form-sm form-field">
            <label for="f-petit-nom">Nom</label>
            <input class="form-input" id="f-petit-nom" type="text" name="petit-nom">
            <label><input type="checkbox" name="petit-case" checked> Case à cocher</label>
            <label><input class="form-switch-solid theme-primary" type="checkbox" role="switch" name="petit-switch" checked> Switch</label>
            <div><button class="btn-solid theme-primary" type="button">Envoyer</button></div>
        </form>
        <form class="form-lg form-field">
            <label for="f-grand-nom">Nom</label>
            <input class="form-input" id="f-grand-nom" type="text" name="grand-nom">
            <label><input type="checkbox" name="grand-case" checked> Case à cocher</label>
            <label><input class="form-switch-solid theme-primary" type="checkbox" role="switch" name="grand-switch" checked> Switch</label>
            <div><button class="btn-solid theme-primary" type="button">Envoyer</button></div>
        </form>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-8'}) }}

    <h3 class="fs-lg mt-6">Un seul champ, un groupe, un switch</h3>
    <p class="mt-2"><code>form-input-sm</code> s'utilise seul ; un groupe prend sa taille par <code>form-sm</code> ; le switch a ses tailles.</p>
    {% set code %}
        <input class="form-input-sm" type="text" name="seul-petit" aria-label="Petit champ">
        <input class="form-input-md" type="text" name="seul-moyen" aria-label="Champ moyen">
        <input class="form-input-lg" type="text" name="seul-grand" aria-label="Grand champ">

        <div class="form-input-group form-lg">
            <span class="form-input-group-text">@</span>
            <input class="form-input" type="text" name="groupe-pseudo" aria-label="Pseudo">
            <button class="btn-solid theme-primary" type="button">Vérifier</button>
        </div>

        <div class="d-flex flex-wrap-wrap align-items-center gap-4">
            <label><input class="form-switch-solid form-switch-sm theme-primary" type="checkbox" role="switch" name="switch-petit" checked> form-switch-sm</label>
            <label><input class="form-switch-solid form-switch-md theme-primary" type="checkbox" role="switch" name="switch-moyen" checked> form-switch-md</label>
            <label><input class="form-switch-solid form-switch-lg theme-primary" type="checkbox" role="switch" name="switch-grand" checked> form-switch-lg</label>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-direction-column gap-4'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--form-field-gap</th><td>0.5rem</td><td>espace entre le libellé, le champ et son message</td></tr>
                <tr><th scope="row">--form-input-padding-block</th><td>0.375rem</td><td>haut et bas d'un champ</td></tr>
                <tr><th scope="row">--form-input-padding-inline</th><td>1rem</td><td>côtés d'un champ</td></tr>
                <tr><th scope="row">--form-input-border-radius</th><td>--border-radius-md</td><td>coins d'un champ</td></tr>
                <tr><th scope="row">--form-input-border-width</th><td>--border-width</td><td>épaisseur du cadre</td></tr>
                <tr><th scope="row">--form-input-border-color</th><td>gris foncé</td><td>couleur du cadre au repos</td></tr>
                <tr><th scope="row">--form-switch-height</th><td>1.25rem</td><td>hauteur d'un switch (la largeur en vaut le double)</td></tr>
                <tr><th scope="row">--form-switch-border-width</th><td>--border-width</td><td>cadre d'un switch</td></tr>
                <tr><th scope="row">--form-control-zoom</th><td>0.875, 1, 1.125</td><td>zoom des cases, boutons radio, range et color dans <code>form-sm</code>, <code>-md</code>, <code>-lg</code></td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les champs et tous les switchs */
        :root {
            --form-input-border-radius: 0px;
            --form-field-gap: 0.25rem;
            --form-switch-height: 1.5rem;
        }

        /* Une taille */
        .form-input-lg { --form-input-padding-inline: 1.5rem; }
        .form-lg { --form-control-zoom: 1.5; }

        /* Un champ du site */
        .recherche-hero { --form-input-padding-block: 0.75rem; }

        /* Les cases, boutons radio et range sans thème en primary (au lieu de la couleur du texte) */
        body { accent-color: var(--color-primary); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Chaque champ a un libellé visible, relié par <code>for</code> et <code>id</code> ou qui le contient ; le placeholder n'est pas un libellé.</li>
        <li>Un groupe de cases ou de boutons radio va dans un <code>&lt;fieldset&gt;</code> avec une <code>&lt;legend&gt;</code>.</li>
        <li><code>autocomplete</code> sur les champs qui parlent de l'utilisateur (WCAG 1.3.5) ; « obligatoire » écrit dans le libellé, avec <code>required</code>.</li>
        <li>Une erreur se dit en texte, relié par <code>aria-describedby</code>, et <code>aria-invalid="true"</code> sur le champ (WCAG 1.4.1).</li>
        <li>Le bouton d'envoi n'est jamais désactivé en attendant : le navigateur dit ce qui manque.</li>
        <li>Switch : <code>role="switch"</code>, annoncé « allumé » ou « éteint » ; l'état vient de <code>checked</code>. Il agit tout de suite ; une case est envoyée avec le formulaire.</li>
        <li>En clair, le cadre gris des champs et les couleurs pleines sont sous 3:1 sur le fond de la page.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sans libellé, le placeholder disparaît dès la saisie -->
        <input class="form-input" type="email" name="email" placeholder="Adresse e-mail">
        <!-- Oui -->
        <label for="email">Adresse e-mail</label>
        <input class="form-input" id="email" type="email" name="email">
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : la question n'est pas reliée aux réponses -->
        <div>
            <p>Être contacté</p>
            <label><input type="radio" name="contact"> Par e-mail</label>
        </div>
        <!-- Oui -->
        <fieldset class="form-field">
            <legend>Être contacté</legend>
            <label><input type="radio" name="contact"> Par e-mail</label>
        </fieldset>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : en erreur sans message ; theme-danger seul n'est pas annoncé -->
        <input class="form-input" id="email" type="email" name="email" aria-invalid="true">
        <input class="form-input theme-danger" id="email" type="email" name="email">
        <!-- Oui -->
        <input class="form-input" id="email" type="email" name="email" aria-invalid="true" aria-describedby="email-erreur">
        <p class="fs-sm color-danger-emphasis" id="email-erreur">Erreur : l'adresse est incomplète.</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : d-grid dans une grille, le champ s'étire à côté d'un message voisin -->
        <div class="d-grid gap-2 md:col-6">…</div>
        <!-- Non : un libellé en bloc, un clic loin de la case la coche -->
        <label class="d-block"><input type="checkbox" name="nouveautes"> Les nouveautés</label>
        <!-- Oui : form-field -->
        <div class="form-field md:col-6">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans role="switch", annoncé comme une case ; aria-checked est interdit -->
        <input class="form-switch" type="checkbox" name="nouveautes">
        <input class="form-switch" type="checkbox" role="switch" aria-checked="true" checked>
        <!-- Non : form-switch-solid sans .theme-*, allumé il n'a pas de couleur -->
        <input class="form-switch-solid" type="checkbox" role="switch">
        <!-- Oui -->
        <input class="form-switch-solid theme-primary" type="checkbox" role="switch" checked>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : form-input-sm ne change pas une case ; une taille sur le champ seul d'un groupe -->
        <input class="form-input-sm" type="checkbox" name="nouveautes">
        <div class="form-input-group">
            <input class="form-input-lg" id="prix" type="number" name="prix">
            <span class="form-input-group-text">€</span>
        </div>
        <!-- Oui : la taille sur le parent -->
        <div class="form-input-group form-lg">
            <input class="form-input" id="prix" type="number" name="prix">
            <span class="form-input-group-text">€</span>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : le texte du groupe à la place du libellé, le champ n'a pas de nom -->
        <div class="form-input-group">
            <span class="form-input-group-text">Prix</span>
            <input class="form-input" type="number" name="prix">
        </div>
        <!-- Oui : un libellé au-dessus -->
        <label for="prix">Prix, en euros</label>
        <div class="form-input-group">
            <input class="form-input" id="prix" type="number" name="prix">
            <span class="form-input-group-text">€</span>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>En refonte : les bulles d'erreur, les cases et le fieldset sont ceux du navigateur.</li>
        <li><code>aria-invalid</code> ne change que les champs : une case ou un switch en erreur gardent leur aspect.</li>
        <li>Dans Chromium, les dates et les heures font 33, 40 et 47px au lieu de 31, 38 et 45. Pas encore vérifié dans Safari.</li>
        <li><code>month</code> et <code>week</code> n'ont pas de sélecteur dans Firefox ni Safari sur ordinateur.</li>
        <li>La flèche des listes est grise dans les deux thèmes, toujours à droite.</li>
        <li>Un groupe ne passe pas à la ligne : des textes et des boutons courts. Un dropdown se met après le groupe, pas dedans.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <div class="grid mt-2">
        <div class="form-field sm:col-6 lg:col-4">
            <label for="form-theme-none">sans thème</label>
            <input class="form-input" id="form-theme-none" type="text" name="theme-none">
            <input class="form-input" type="file" name="file-theme-none" aria-label="Fichier, sans thème">
            <input class="form-range" type="range" name="range-theme-none" aria-label="Range, sans thème">
            <div class="d-flex flex-wrap-wrap gap-4">
                <label><input class="form-checkbox" type="checkbox" name="checkbox-theme-none" checked> Case</label>
                <label><input class="form-radio" type="radio" name="radio-theme-none" checked> Radio</label>
                <label><input class="form-switch" type="checkbox" role="switch" name="switch-theme-none" checked> Switch</label>
            </div>
        </div>
        {% for theme in colors %}
            <div class="form-field sm:col-6 lg:col-4 theme-{{ theme }}">
                <label for="form-theme-{{ theme }}">theme-{{ theme }}</label>
                <input class="form-input" id="form-theme-{{ theme }}" type="text" name="theme-{{ theme }}">
                <input class="form-input" type="file" name="file-theme-{{ theme }}" aria-label="Fichier, theme-{{ theme }}">
                <input class="form-range" type="range" name="range-theme-{{ theme }}" aria-label="Range, theme-{{ theme }}">
                <div class="d-flex flex-wrap-wrap gap-4">
                    <label><input class="form-checkbox" type="checkbox" name="checkbox-theme-{{ theme }}" checked> Case</label>
                    <label><input class="form-radio" type="radio" name="radio-theme-{{ theme }}" checked> Radio</label>
                    <label><input class="form-switch-solid" type="checkbox" role="switch" name="switch-theme-{{ theme }}" checked> Switch</label>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
