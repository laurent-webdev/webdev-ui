{% extends 'base.html.twig' %}

{% block title %}Tableau{% endblock %}

{% block body %}
    {% set fruits = {'Pommes': 12, 'Poires': 7, 'Prunes': 140, 'Kiwis': 3} %}

    <h1>Tableau</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un tableau de données natif : <code>table</code> sur le <code>&lt;table&gt;</code>, les autres balises sans classe. Des options qui se combinent, trois tailles, un <code>.theme-*</code> pour la couleur.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2"><code>&lt;caption&gt;</code> pour le nom, <code>&lt;th scope&gt;</code> pour les en-têtes, <code>text-align-end</code> pour les nombres.</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="commandes-legende" tabindex="0">
            <table class="table">
                <caption id="commandes-legende">Commandes de novembre</caption>
                <thead>
                    <tr>
                        <th scope="col">N°</th>
                        <th scope="col">Client</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="text-align-end">Montant</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">1042</th><td>Durand</td><td>Payée</td><td class="text-align-end">128,00 €</td></tr>
                    <tr><th scope="row">1043</th><td>Martin</td><td>En attente du virement, relancée le 12 novembre</td><td class="text-align-end">1 111,10 €</td></tr>
                    <tr><th scope="row">1044</th><td>Petit</td><td>Annulée</td><td class="text-align-end">9,90 €</td></tr>
                </tbody>
                <tfoot>
                    <tr><th scope="row" colspan="3">Total</th><td class="text-align-end">1 249,00 €</td></tr>
                </tfoot>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Rayures et survol</h2>
    <p class="mt-2"><code>table-striped</code> et <code>table-hover</code> s'ajoutent à <code>table</code>.</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="stock-legende" tabindex="0">
            <table class="table table-striped table-hover">
                <caption id="stock-legende">Stock</caption>
                <thead>
                    <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                </thead>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                    <tr><td>Prunes</td><td class="text-align-end">140</td></tr>
                    <tr><td>Kiwis</td><td class="text-align-end">3</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Traits</h2>
    <p class="mt-2"><code>table-bordered</code> : un trait autour de chaque cellule ; <code>table-borderless</code> : aucun trait.</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="bordered-legende" tabindex="0">
            <table class="table table-bordered">
                <caption id="bordered-legende">table-bordered</caption>
                <thead>
                    <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                </thead>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-responsive" role="region" aria-labelledby="borderless-legende" tabindex="0">
            <table class="table table-borderless">
                <caption id="borderless-legende">table-borderless</caption>
                <thead>
                    <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                </thead>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-6'}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">Un fond léger et des traits de la couleur ; le texte reste celui de la page.</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="stock-theme-legende" tabindex="0">
            <table class="table table-striped table-hover theme-primary">
                <caption id="stock-theme-legende">Stock</caption>
                <thead>
                    <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                </thead>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                    <tr><td>Prunes</td><td class="text-align-end">140</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">Le padding des cellules : 32, 40 et 48px par ligne. Le texte garde sa taille (<code>fs-sm</code> pour le réduire).</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="taille-sm-legende" tabindex="0">
            <table class="table table-striped table-sm">
                <caption id="taille-sm-legende">table-sm</caption>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-responsive" role="region" aria-labelledby="taille-md-legende" tabindex="0">
            <table class="table table-striped table-md">
                <caption id="taille-md-legende">table-md</caption>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                </tbody>
            </table>
        </div>
        <div class="table-responsive" role="region" aria-labelledby="taille-lg-legende" tabindex="0">
            <table class="table table-striped table-lg">
                <caption id="taille-lg-legende">table-lg</caption>
                <tbody>
                    <tr><td>Pommes</td><td class="text-align-end">12</td></tr>
                    <tr><td>Poires</td><td class="text-align-end">7</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-6'}) }}

    <h2 class="mt-10">Trop large pour l'écran</h2>
    <p class="mt-2"><code>table-responsive</code> sur le <code>&lt;div&gt;</code> autour : le tableau défile dedans, la page ne déborde pas. <code>tabindex="0"</code> : les flèches le font défiler.</p>
    {% set code %}
        <div class="table-responsive" role="region" aria-labelledby="ventes-legende" tabindex="0">
            <table class="table table-striped">
                <caption id="ventes-legende">Ventes de l'année, en euros</caption>
                <thead>
                    <tr>
                        <th scope="col">Magasin</th>
                        <th scope="col" class="text-align-end">Janvier</th>
                        <th scope="col" class="text-align-end">Février</th>
                        <th scope="col" class="text-align-end">Mars</th>
                        <th scope="col" class="text-align-end">Avril</th>
                        <th scope="col" class="text-align-end">Mai</th>
                        <th scope="col" class="text-align-end">Juin</th>
                        <th scope="col" class="text-align-end">Juillet</th>
                        <th scope="col" class="text-align-end">Août</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Bordeaux</th><td class="text-align-end">1 801</td><td class="text-align-end">3 035</td><td class="text-align-end">4 269</td><td class="text-align-end">5 503</td><td class="text-align-end">6 737</td><td class="text-align-end">7 971</td><td class="text-align-end">9 205</td><td class="text-align-end">10 439</td></tr>
                    <tr><th scope="row">Lyon</th><td class="text-align-end">2 368</td><td class="text-align-end">3 602</td><td class="text-align-end">4 836</td><td class="text-align-end">6 070</td><td class="text-align-end">7 304</td><td class="text-align-end">8 538</td><td class="text-align-end">9 772</td><td class="text-align-end">11 006</td></tr>
                    <tr><th scope="row">Nantes</th><td class="text-align-end">2 935</td><td class="text-align-end">4 169</td><td class="text-align-end">5 403</td><td class="text-align-end">6 637</td><td class="text-align-end">7 871</td><td class="text-align-end">9 105</td><td class="text-align-end">10 339</td><td class="text-align-end">11 573</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--table-cell-padding-block</th><td>0.5rem</td><td>haut et bas des cellules</td></tr>
                <tr><th scope="row">--table-cell-padding-inline</th><td>0.75rem</td><td>côtés des cellules</td></tr>
                <tr><th scope="row">--table-border-width</th><td>--border-width</td><td>traits (0px dans <code>table-borderless</code>)</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les tableaux sans taille (table-md garde 0.75rem) */
        :root { --table-cell-padding-inline: 1rem; }

        /* Une taille */
        .table-sm { --table-cell-padding-block: 0.125rem; }

        /* Un tableau du site */
        .tableau-factures { --table-border-width: 2px; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;table&gt;</code> natif : le lecteur d'écran annonce lignes et colonnes, pas d'<code>aria-*</code> à écrire.</li>
        <li><code>&lt;caption&gt;</code> nomme le tableau (sans légende visible : <code>aria-label</code>) ; <code>&lt;th scope&gt;</code> relie chaque cellule à ses en-têtes.</li>
        <li>La zone qui défile se prend au clavier (<code>tabindex="0"</code>) et a un nom (<code>role="region"</code>, <code>aria-labelledby</code>).</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une option sans table, ni padding ni traits -->
        <table class="table-striped">…</table>
        <!-- Non : deux options contraires, table-borderless gagne -->
        <table class="table table-bordered table-borderless">…</table>
        <!-- Oui -->
        <table class="table table-striped">…</table>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un en-tête en gras dans un <td> n'est pas relié aux cellules -->
        <td class="fw-bold">Montant</td>
        <!-- Oui -->
        <th scope="col">Montant</th>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : en display: block, le tableau perd sa structure -->
        <table class="table d-block overflow-x-auto">…</table>
        <!-- Non : sans tabindex, role ni nom, le clavier ne fait pas défiler la zone -->
        <div class="table-responsive"><table class="table">…</table></div>
        <!-- Oui -->
        <div class="table-responsive" role="region" aria-labelledby="ventes-legende" tabindex="0">
            <table class="table">…</table>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : .theme-* sur une ligne ne colore pas son fond, et la couleur seule ne suffit pas -->
        <tr class="theme-danger"><th scope="row">1044</th><td>Petit</td></tr>
        <!-- Oui : le texte le dit -->
        <tr><th scope="row">1044</th><td>Petit</td><td>Annulée</td></tr>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un tableau pour mettre en page -->
        <table class="table">
            <tr><td>menu</td><td>contenu de la page</td></tr>
        </table>
        <!-- Oui : la grille -->
        <div class="grid">
            <nav class="md:col-3">menu</nav>
            <main class="md:col-9">contenu de la page</main>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Sur un fond plein, le texte de la carte passe sur le fond léger du tableau et peut devenir illisible.</li>
        <li>Les coins de <code>table-bordered</code> sont carrés.</li>
        <li>Pas de tri, d'en-tête qui reste en haut ni de mise en pile sur petit écran : le défilement sur le côté garde le tableau.</li>
        <li>Sur un écran tactile, la ligne touchée garde le fond du survol jusqu'au toucher suivant.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <div class="grid mt-2">
        <div class="table-responsive md:col-4" role="region" aria-labelledby="couleurs-sans-theme" tabindex="0">
            <table class="table table-striped table-hover">
                <caption id="couleurs-sans-theme">sans thème</caption>
                <thead>
                    <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                </thead>
                <tbody>
                    {% for name, quantity in fruits %}
                        <tr><td>{{ name }}</td><td class="text-align-end">{{ quantity }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% for color in colors|filter(color => color != 'neutral') %}
            <div class="table-responsive md:col-4" role="region" aria-labelledby="couleurs-{{ color }}" tabindex="0">
                <table class="table table-striped table-hover theme-{{ color }}">
                    <caption id="couleurs-{{ color }}">theme-{{ color }}</caption>
                    <thead>
                        <tr><th scope="col">Fruit</th><th scope="col" class="text-align-end">Quantité</th></tr>
                    </thead>
                    <tbody>
                        {% for name, quantity in fruits %}
                            <tr><td>{{ name }}</td><td class="text-align-end">{{ quantity }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endfor %}
    </div>
{% endblock %}
