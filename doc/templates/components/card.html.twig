{% extends 'base.html.twig' %}

{% block title %}Carte{% endblock %}

{% block body %}
    <h1>Carte</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un bloc de contenu avec un en-tête, un corps et un pied, tous facultatifs sauf le corps. Une variante pour la forme, un <code>.theme-*</code> pour la couleur.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <article class="card">
            <header class="card-header">
                <h3 class="fs-md">Titre de la carte</h3>
            </header>
            <div class="card-body">
                <p>Le contenu de la carte.</p>
            </div>
            <footer class="card-footer">
                <button class="btn btn-sm" type="button">Action</button>
            </footer>
        </article>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Variantes</h2>
    <p class="mt-2">Dans une grille, les cartes ont la même hauteur et les pieds restent alignés.</p>
    {% set code %}
        <div class="grid gap-4">
            <article class="card-solid theme-primary md:col-4">
                <div class="card-body">
                    <h3 class="fs-md">Solid</h3>
                    <p class="mt-2">Fond plein, texte noir ou blanc. <a class="link color-inherit" href="#">Un lien</a></p>
                </div>
                <footer class="card-footer">
                    <button class="btn-solid btn-sm theme-inverse" type="button">Action</button>
                </footer>
            </article>
            <article class="card-subtle theme-primary md:col-4">
                <div class="card-body">
                    <h3 class="fs-md">Subtle</h3>
                    <p class="mt-2">Fond léger. <a class="link" href="#">Un lien</a></p>
                </div>
                <footer class="card-footer">
                    <button class="btn-solid btn-sm" type="button">Action</button>
                </footer>
            </article>
            <article class="card-outline theme-primary md:col-4">
                <div class="card-body">
                    <h3 class="fs-md">Outline</h3>
                    <p class="mt-2">Un cadre de la couleur. <a class="link" href="#">Un lien</a></p>
                </div>
                <footer class="card-footer">
                    <button class="btn-solid btn-sm" type="button">Action</button>
                </footer>
            </article>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Une image</h2>
    <p class="mt-2">L'image prend toute la largeur, ses coins suivent le cadre.</p>
    {% set code %}
        <article class="card w-50">
            <img class="aspect-ratio-16x9 object-fit-cover" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
            <div class="card-body">
                <h3 class="fs-lg">Titre de l'article</h3>
                <p class="mt-2">Le résumé de l'article.</p>
            </div>
        </article>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">En-tête et pied colorés</h2>
    <p class="mt-2">Les utilitaires <code>bg-*</code> ; les coins suivent le cadre.</p>
    {% set code %}
        <article class="card-outline theme-primary">
            <header class="card-header bg-primary color-primary-contrast">
                <h3 class="fs-md">En-tête bg-primary</h3>
            </header>
            <div class="card-body">
                <p>Le contenu de la carte.</p>
            </div>
            <footer class="card-footer bg-primary-subtle">
                <p>Pied bg-primary-subtle</p>
            </footer>
        </article>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Avec une ombre</h2>
    {% set code %}
        <div class="card box-shadow-md">
            <div class="card-body">
                <p>L'utilitaire box-shadow-md soulève la carte.</p>
            </div>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--card-padding-block</th><td>1rem</td><td>haut et bas de l'en-tête, du corps et du pied</td></tr>
                <tr><th scope="row">--card-padding-inline</th><td>1rem</td><td>côtés de l'en-tête, du corps et du pied</td></tr>
                <tr><th scope="row">--card-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--card-border-width</th><td>--border-width</td><td>cadre et traits</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les cartes */
        :root { --card-padding-inline: 1.5rem; }

        /* Une carte du site */
        .card-produit { --card-border-radius: var(--border-radius-xl); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li><code>&lt;article&gt;</code> pour un contenu qui se comprend seul (un article, un produit), sinon <code>&lt;div&gt;</code> ; le titre suit la hiérarchie de la page.</li>
        <li>Une image qui ne dit rien de plus que le texte : <code>alt=""</code>.</li>
        <li>Plusieurs « Lire la suite » : chacun dit où il mène, avec un texte <code>visually-hidden</code> (WCAG 2.4.4).</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de couleur -->
        <article class="card-solid">…</article>
        <!-- Oui -->
        <article class="card-solid theme-neutral">…</article>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un bouton dans un lien est interdit, et tout le contenu devient le nom du lien -->
        <a href="/article">
            <article class="card">… <button type="button">Partager</button></article>
        </a>
        <!-- Oui : le lien sur le titre -->
        <article class="card">
            <div class="card-body">
                <h3><a class="link" href="/article">Titre</a></h3>
            </div>
        </article>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans card-body, le texte est collé aux bords -->
        <div class="card"><p>Texte</p></div>
        <!-- Oui -->
        <div class="card"><div class="card-body"><p>Texte</p></div></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sur un fond plein, btn-outline et un lien sans color-inherit ne se lisent pas -->
        <div class="card-solid theme-primary">
            <div class="card-body"><a class="link" href="#">Voir</a> <a class="btn-outline" href="#">Voir</a></div>
        </div>
        <!-- Oui -->
        <div class="card-solid theme-primary">
            <div class="card-body"><a class="link color-inherit" href="#">Voir</a> <a class="btn-solid theme-inverse" href="#">Voir</a></div>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Seul le premier ou le dernier élément suit les coins : une image dans un lien ou un <code>&lt;picture&gt;</code> garde ses coins carrés.</li>
        <li>Un <code>.theme-*</code> sur la carte colore aussi ses boutons, liens et badges : sur <code>card-solid</code>, donner un autre thème au bouton.</li>
        <li>Pas de carte entièrement cliquable ni horizontale ; pas de tailles.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['solid', 'subtle', 'outline'] %}
        <h3 class="fs-md mt-6">card-{{ variant }}</h3>
        <div class="grid gap-4 mt-2">
            {% for color in colors %}
                <div class="card-{{ variant }} theme-{{ color }} col-6 md:col-4">
                    <div class="card-body">
                        <p>theme-{{ color }}, <a class="link{% if variant == 'solid' %} color-inherit{% endif %}" href="#">un lien</a></p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
