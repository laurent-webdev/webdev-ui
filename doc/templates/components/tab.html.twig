{% extends 'base.html.twig' %}

{% block title %}Onglets{% endblock %}

{% block body %}
    <h1>Onglets</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Une rangée d'onglets qui affichent un panneau à la fois. Le HTML porte l'état de départ, le JavaScript du framework le change au clic et au clavier.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2">Onglet choisi : <code>aria-selected="true"</code> ; les autres : <code>tabindex="-1"</code> et leur panneau <code>hidden</code>.</p>
    {% set code %}
        <div class="tab" role="tablist" aria-label="Mon compte" data-tab>
            <button class="tab-item" id="onglet-profil" type="button" role="tab" aria-selected="true" aria-controls="panneau-profil">Profil</button>
            <button class="tab-item" id="onglet-securite" type="button" role="tab" aria-selected="false" aria-controls="panneau-securite" tabindex="-1">Sécurité</button>
            <button class="tab-item" id="onglet-factures" type="button" role="tab" aria-selected="false" aria-controls="panneau-factures" tabindex="-1" disabled>Factures (bientôt)</button>
        </div>
        <div class="pt-4" id="panneau-profil" role="tabpanel" aria-labelledby="onglet-profil" tabindex="0">
            <p>Nom, photo, adresse e-mail.</p>
        </div>
        <div class="pt-4" id="panneau-securite" role="tabpanel" aria-labelledby="onglet-securite" tabindex="0" hidden>
            <p>Mot de passe, double authentification.</p>
        </div>
        <div class="pt-4" id="panneau-factures" role="tabpanel" aria-labelledby="onglet-factures" tabindex="0" hidden>
            <p>Les factures.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">La couleur colore le trait de l'onglet choisi et le fond au survol.</p>
    {% set code %}
        <div class="tab theme-primary" role="tablist" aria-label="Commandes" data-tab>
            <button class="tab-item" id="onglet-en-cours" type="button" role="tab" aria-selected="true" aria-controls="panneau-en-cours">En cours</button>
            <button class="tab-item" id="onglet-livrees" type="button" role="tab" aria-selected="false" aria-controls="panneau-livrees" tabindex="-1">Livrées</button>
        </div>
        <div class="pt-4" id="panneau-en-cours" role="tabpanel" aria-labelledby="onglet-en-cours" tabindex="0">
            <p>2 commandes en cours.</p>
        </div>
        <div class="pt-4" id="panneau-livrees" role="tabpanel" aria-labelledby="onglet-livrees" tabindex="0" hidden>
            <p>12 commandes livrées.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Vertical</h2>
    <p class="mt-2"><code>aria-orientation="vertical"</code> : les onglets s'empilent, ↑ et ↓ marchent aussi. La grille les met à gauche à partir de md.</p>
    {% set code %}
        <div class="grid">
            <div class="tab theme-primary md:col-3" role="tablist" aria-label="Réglages" aria-orientation="vertical" data-tab>
                <button class="tab-item" id="onglet-general" type="button" role="tab" aria-selected="true" aria-controls="panneau-general">Général</button>
                <button class="tab-item" id="onglet-affichage" type="button" role="tab" aria-selected="false" aria-controls="panneau-affichage" tabindex="-1">Affichage</button>
                <button class="tab-item" id="onglet-confidentialite" type="button" role="tab" aria-selected="false" aria-controls="panneau-confidentialite" tabindex="-1">Confidentialité et données personnelles</button>
            </div>
            <div class="md:col-9" id="panneau-general" role="tabpanel" aria-labelledby="onglet-general" tabindex="0">
                <p>Langue, fuseau horaire.</p>
            </div>
            <div class="md:col-9" id="panneau-affichage" role="tabpanel" aria-labelledby="onglet-affichage" tabindex="0" hidden>
                <p>Thème, taille du texte.</p>
            </div>
            <div class="md:col-9" id="panneau-confidentialite" role="tabpanel" aria-labelledby="onglet-confidentialite" tabindex="0" hidden>
                <p>Cookies, export des données.</p>
            </div>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Beaucoup d'onglets</h2>
    <p class="mt-2">La rangée défile sur le côté, sans passer à la ligne.</p>
    {% set code %}
        <div class="tab" role="tablist" aria-label="Mois" data-tab>
            <button class="tab-item" id="onglet-janvier" type="button" role="tab" aria-selected="true" aria-controls="panneau-janvier">Janvier</button>
            <button class="tab-item" id="onglet-fevrier" type="button" role="tab" aria-selected="false" aria-controls="panneau-fevrier" tabindex="-1">Février</button>
            <button class="tab-item" id="onglet-mars" type="button" role="tab" aria-selected="false" aria-controls="panneau-mars" tabindex="-1">Mars</button>
            <button class="tab-item" id="onglet-avril" type="button" role="tab" aria-selected="false" aria-controls="panneau-avril" tabindex="-1">Avril</button>
            <button class="tab-item" id="onglet-mai" type="button" role="tab" aria-selected="false" aria-controls="panneau-mai" tabindex="-1">Mai</button>
            <button class="tab-item" id="onglet-juin" type="button" role="tab" aria-selected="false" aria-controls="panneau-juin" tabindex="-1">Juin</button>
            <button class="tab-item" id="onglet-juillet" type="button" role="tab" aria-selected="false" aria-controls="panneau-juillet" tabindex="-1">Juillet</button>
            <button class="tab-item" id="onglet-aout" type="button" role="tab" aria-selected="false" aria-controls="panneau-aout" tabindex="-1">Août</button>
            <button class="tab-item" id="onglet-septembre" type="button" role="tab" aria-selected="false" aria-controls="panneau-septembre" tabindex="-1">Septembre</button>
        </div>
        <div class="pt-4" id="panneau-janvier" role="tabpanel" aria-labelledby="onglet-janvier" tabindex="0"><p>Les chiffres de janvier.</p></div>
        <div class="pt-4" id="panneau-fevrier" role="tabpanel" aria-labelledby="onglet-fevrier" tabindex="0" hidden><p>Les chiffres de février.</p></div>
        <div class="pt-4" id="panneau-mars" role="tabpanel" aria-labelledby="onglet-mars" tabindex="0" hidden><p>Les chiffres de mars.</p></div>
        <div class="pt-4" id="panneau-avril" role="tabpanel" aria-labelledby="onglet-avril" tabindex="0" hidden><p>Les chiffres d'avril.</p></div>
        <div class="pt-4" id="panneau-mai" role="tabpanel" aria-labelledby="onglet-mai" tabindex="0" hidden><p>Les chiffres de mai.</p></div>
        <div class="pt-4" id="panneau-juin" role="tabpanel" aria-labelledby="onglet-juin" tabindex="0" hidden><p>Les chiffres de juin.</p></div>
        <div class="pt-4" id="panneau-juillet" role="tabpanel" aria-labelledby="onglet-juillet" tabindex="0" hidden><p>Les chiffres de juillet.</p></div>
        <div class="pt-4" id="panneau-aout" role="tabpanel" aria-labelledby="onglet-aout" tabindex="0" hidden><p>Les chiffres d'août.</p></div>
        <div class="pt-4" id="panneau-septembre" role="tabpanel" aria-labelledby="onglet-septembre" tabindex="0" hidden><p>Les chiffres de septembre.</p></div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--tab-item-padding-block</th><td>0.5rem</td><td>haut et bas d'un onglet</td></tr>
                <tr><th scope="row">--tab-item-padding-inline</th><td>1rem</td><td>côtés d'un onglet</td></tr>
                <tr><th scope="row">--tab-border-radius</th><td>--border-radius-md</td><td>coins du fond au survol</td></tr>
                <tr><th scope="row">--tab-border-width</th><td>--border-width</td><td>trait sous la rangée</td></tr>
                <tr><th scope="row">--tab-item-border-width</th><td>0.125rem</td><td>trait sous l'onglet choisi</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les onglets : un trait plus épais, un fond carré au survol */
        :root {
            --tab-item-border-width: 0.1875rem;
            --tab-border-radius: 0px;
        }

        /* Des onglets du site */
        .onglets-compacts { --tab-item-padding-inline: 0.75rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10" id="javascript">JavaScript</h2>
    <p class="mt-2">Rien à écrire : <code>dist/js/bundle.js</code> agit sur les rangées <code>data-tab</code>, aussi celles ajoutées plus tard.</p>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="javascript" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Événement</th>
                    <th scope="col">Envoyé</th>
                    <th scope="col">detail</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">tab-beforechange</th><td>sur la rangée, avant le changement ; annulable</td><td>tab, previousTab</td></tr>
                <tr><th scope="row">tab-change</th><td>sur la rangée, après le changement</td><td>tab, previousTab</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        // Garder l'onglet en cours
        document.addEventListener('tab-beforechange', (event) => {
            if (formulaireModifie && !confirm('Quitter sans enregistrer ?')) event.preventDefault();
        });

        // Charger le contenu du panneau affiché
        document.addEventListener('tab-change', (event) => {
            const panneau = document.getElementById(event.detail.tab.getAttribute('aria-controls'));
        });
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Clavier : Tab va sur l'onglet choisi, ← → (↑ ↓ en vertical) passent d'un onglet à l'autre, Début et Fin ; Tab suivant va dans le panneau.</li>
        <li>La rangée a un nom (<code>aria-label</code>) : le lecteur d'écran annonce « Profil, onglet, sélectionné, 1 sur 3 ».</li>
        <li>L'onglet choisi se voit sans la couleur : un trait dessous.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : des onglets qui changent de page sont des liens de navigation -->
        <div class="tab" role="tablist" data-tab>
            <a class="tab-item" href="/profil" role="tab">Profil</a>
        </div>
        <!-- Oui -->
        <nav aria-label="Mon compte">
            <a href="/profil" aria-current="page">Profil</a>
        </nav>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans tabindex="-1", Tab s'arrête sur chaque onglet ; sans hidden, tous les panneaux s'affichent -->
        <button class="tab-item" type="button" role="tab" aria-selected="false" aria-controls="panneau-securite">Sécurité</button>
        <div id="panneau-securite" role="tabpanel" aria-labelledby="onglet-securite">…</div>
        <!-- Oui -->
        <button class="tab-item" type="button" role="tab" aria-selected="false" aria-controls="panneau-securite" tabindex="-1">Sécurité</button>
        <div id="panneau-securite" role="tabpanel" aria-labelledby="onglet-securite" tabindex="0" hidden>…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans data-tab, le JavaScript ne fait rien -->
        <div class="tab" role="tablist" aria-label="Mon compte">
        <!-- Non : empilés par un utilitaire, annoncés en rangée, sans ↑ ↓ -->
        <div class="tab flex-direction-column" role="tablist" aria-label="Réglages" data-tab>
        <!-- Oui -->
        <div class="tab" role="tablist" aria-label="Réglages" aria-orientation="vertical" data-tab>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : pas de classe d'état -->
        <button class="tab-item active" type="button" role="tab">Profil</button>
        <!-- Oui -->
        <button class="tab-item" type="button" role="tab" aria-selected="true">Profil</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Sans JavaScript, seul le premier panneau se voit : pour un contenu à lire sans JavaScript, un accordéon.</li>
        <li>Sur un fond plein, le trait et le survol ne se voient plus.</li>
        <li>Pas de lien vers un onglet par l'adresse (#panneau), pas d'animation.</li>
        <li>En écriture de droite à gauche, ← et → ne sont pas inversés.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    {% for color in colors %}
        <div class="tab theme-{{ color }} mt-4" role="tablist" aria-label="theme-{{ color }} (démo)" data-tab>
            <button class="tab-item" id="tab-{{ color }}-1" type="button" role="tab" aria-selected="true" aria-controls="tab-{{ color }}-1-panel">theme-{{ color }}</button>
            <button class="tab-item" id="tab-{{ color }}-2" type="button" role="tab" aria-selected="false" aria-controls="tab-{{ color }}-2-panel" tabindex="-1">Deuxième onglet</button>
        </div>
        <div class="pt-2" id="tab-{{ color }}-1-panel" role="tabpanel" aria-labelledby="tab-{{ color }}-1" tabindex="0">
            <p>Le premier panneau.</p>
        </div>
        <div class="pt-2" id="tab-{{ color }}-2-panel" role="tabpanel" aria-labelledby="tab-{{ color }}-2" tabindex="0" hidden>
            <p>Le deuxième panneau.</p>
        </div>
    {% endfor %}
{% endblock %}
