{% extends 'base.html.twig' %}

{% block title %}Accordéon{% endblock %}

{% block body %}
    <h1>Accordéon</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Des panneaux qui s'ouvrent et se ferment : des <code>&lt;details&gt;</code> natifs, sans JavaScript. Une variante pour la forme, un <code>.theme-*</code> pour la couleur.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2">Le même <code>name</code> : un seul panneau ouvert à la fois.</p>
    {% set code %}
        <div class="accordion">
            <details name="faq" open>
                <summary>Faut-il du JavaScript ?</summary>
                <div class="accordion-body">
                    <p>Non : details et summary ouvrent et ferment le panneau.</p>
                </div>
            </details>
            <details name="faq">
                <summary>Que fait l'attribut name ?</summary>
                <div class="accordion-body">
                    <p>Ouvrir un panneau ferme les autres du même name.</p>
                </div>
            </details>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Plusieurs panneaux ouverts</h2>
    <p class="mt-2">Sans <code>name</code>.</p>
    {% set code %}
        <div class="accordion">
            <details open>
                <summary>Livraison</summary>
                <div class="accordion-body">
                    <p>Sous 48 h en France métropolitaine.</p>
                </div>
            </details>
            <details>
                <summary>Retours</summary>
                <div class="accordion-body">
                    <p>Gratuits pendant 30 jours.</p>
                </div>
            </details>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Variantes</h2>
    <p class="mt-2">La variante colore le titre ; le contenu reste sur le fond de la page.</p>
    {% set code %}
        <div class="accordion-solid theme-primary">
            <details>
                <summary>Solid</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
        <div class="accordion-subtle theme-primary">
            <details>
                <summary>Subtle</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
        <div class="accordion-outline theme-primary">
            <details>
                <summary>Outline</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Tailles</h2>
    {% set code %}
        <div class="accordion accordion-xs">
            <details>
                <summary>accordion-xs</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
        <div class="accordion accordion-sm">
            <details>
                <summary>accordion-sm</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
        <div class="accordion accordion-md">
            <details>
                <summary>accordion-md</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
        <div class="accordion accordion-lg">
            <details>
                <summary>accordion-lg</summary>
                <div class="accordion-body"><p>Contenu</p></div>
            </details>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--accordion-padding-block</th><td>0.75rem</td><td>haut et bas du titre et du contenu</td></tr>
                <tr><th scope="row">--accordion-padding-inline</th><td>0.75rem</td><td>côtés du titre et du contenu</td></tr>
                <tr><th scope="row">--accordion-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--accordion-border-width</th><td>--border-width</td><td>cadre et traits</td></tr>
                <tr><th scope="row">--accordion-transition-duration</th><td>0.2s</td><td>ouverture, fermeture et flèche</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les accordéons sans taille (accordion-md garde 0.75rem) */
        :root { --accordion-padding-block: 1rem; }

        /* Une taille */
        .accordion-lg { --accordion-padding-inline: 1.5rem; }

        /* Un accordéon du site */
        .faq { --accordion-transition-duration: 0.4s; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le titre se prend au clavier et s'ouvre avec Entrée ou Espace ; le navigateur annonce s'il est ouvert : pas d'<code>aria-expanded</code>.</li>
        <li>La flèche est dessinée en bordures : visible en contraste élevé (Windows).</li>
        <li>Dans Chrome, Ctrl+F ouvre le panneau fermé qui contient le texte cherché.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de couleur -->
        <div class="accordion-solid">…</div>
        <!-- Oui -->
        <div class="accordion-solid theme-neutral">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans accordion-body, la réponse est collée aux bords -->
        <details>
            <summary>Question</summary>
            <p>Réponse</p>
        </details>
        <!-- Oui -->
        <details>
            <summary>Question</summary>
            <div class="accordion-body"><p>Réponse</p></div>
        </details>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : redondant, et l'attribut ne suit pas l'ouverture -->
        <summary aria-expanded="false">Question</summary>
        <!-- Non : summary a le rôle de bouton, le h3 n'est plus annoncé comme un titre -->
        <summary><h3>Question</h3></summary>
        <!-- Oui : un titre se met avant l'accordéon -->
        <summary>Question</summary>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : dans un groupe name, seul le premier open s'ouvre -->
        <details name="faq" open>…</details>
        <details name="faq" open>…</details>
        <!-- Oui : sans name pour en ouvrir plusieurs -->
        <details open>…</details>
        <details open>…</details>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>L'animation ne marche que dans Chrome et Edge : ailleurs, le panneau s'ouvre d'un coup.</li>
        <li>Un navigateur ancien ignore <code>name</code> : plusieurs panneaux peuvent être ouverts.</li>
        <li>Un contenu plus large que l'accordéon (tableau) dépasse : le mettre dans un bloc <code>table-responsive</code>.</li>
        <li>À la fermeture du dernier panneau, les coins du bas s'arrondissent avant la fin du repli.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['solid', 'subtle', 'outline'] %}
        <h3 class="fs-md mt-6">accordion-{{ variant }}</h3>
        <div class="grid mt-2">
            {% for color in colors %}
                <div class="accordion-{{ variant }} theme-{{ color }} col-6 md:col-4">
                    <details>
                        <summary>theme-{{ color }}</summary>
                        <div class="accordion-body">
                            <p>Contenu</p>
                        </div>
                    </details>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
