{% extends 'base.html.twig' %}

{% block title %}Alerte{% endblock %}

{% block body %}
    <h1>Alerte</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un message dans la page, sans JavaScript. Une variante pour la forme, un <code>.theme-*</code> pour la couleur.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <div class="alert">
            <p>Votre session expire dans 5 minutes.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Variantes</h2>
    {% set code %}
        <div class="alert-solid theme-warning">
            <p>Attention : votre abonnement expire demain.</p>
        </div>
        <div class="alert-subtle theme-warning">
            <p>Attention : votre abonnement expire demain.</p>
        </div>
        <div class="alert-outline theme-warning">
            <p>Attention : votre abonnement expire demain.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">Le texte dit le type du message : la couleur ne suffit pas.</p>
    {% set code %}
        <div class="alert-subtle theme-success">
            <p>Succès : vos modifications sont enregistrées.</p>
        </div>
        <div class="alert-subtle theme-info">
            <p>Information : la maintenance aura lieu dimanche.</p>
        </div>
        <div class="alert-subtle theme-warning">
            <p>Attention : votre abonnement expire demain.</p>
        </div>
        <div class="alert-subtle theme-danger">
            <p>Erreur : le paiement a été refusé.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un titre et une liste</h2>
    {% set code %}
        <div class="alert-subtle theme-danger">
            <h3 class="fs-md">Erreur : le formulaire contient 2 erreurs</h3>
            <ul class="mt-2">
                <li><a class="link" href="#">Le champ e-mail est vide</a></li>
                <li><a class="link" href="#">Le mot de passe est trop court</a></li>
            </ul>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Avec une icône</h2>
    <p class="mt-2">L'icône est décorative (<code>aria-hidden</code>), le texte dit « Information ».</p>
    {% set code %}
        <div class="alert-outline theme-info d-flex gap-3">
            <svg class="flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 11v6M12 7v.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <p>Information : la maintenance aura lieu dimanche de 2 h à 4 h.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un bouton et un lien sur un fond plein</h2>
    <p class="mt-2">Un <code>btn-solid</code> d'un autre thème ; <code>color-inherit</code> sur le lien.</p>
    {% set code %}
        <div class="alert-solid theme-primary">
            <p>Une nouvelle version est disponible. <a class="link color-inherit" href="#">Voir les nouveautés</a></p>
            <button class="btn-solid theme-inverse mt-3" type="button">Mettre à jour</button>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un message affiché par le JS</h2>
    <p class="mt-2">La zone <code>role="status"</code> est dans la page dès le chargement ; le JS du site retire <code>hidden</code>.</p>
    {% set code %}
        <div role="status" aria-live="polite">
            <div class="alert-subtle theme-success" id="message-enregistre" hidden>
                <p>Succès : vos modifications sont enregistrées.</p>
            </div>
        </div>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" aria-expanded="false" aria-controls="message-enregistre" data-demo-toggle>Afficher / masquer le message</button>
        {{ code }}
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: 'd-flex flex-direction-column align-items-start gap-2'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--alert-padding-block</th><td>1rem</td><td>haut et bas</td></tr>
                <tr><th scope="row">--alert-padding-inline</th><td>1rem</td><td>côtés</td></tr>
                <tr><th scope="row">--alert-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--alert-border-width</th><td>--border-width</td><td>cadre</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les alertes */
        :root { --alert-padding-block: 0.75rem; }

        /* Une alerte du site */
        .alert-compact { --alert-padding-block: 0.5rem; --alert-padding-inline: 0.75rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un message présent au chargement : pas de <code>role</code>.</li>
        <li>Un message affiché par le JS : dans une zone présente dès le chargement, <code>role="status" aria-live="polite"</code> (information, succès) ou <code>role="alert"</code> seul (erreur urgente ; avec <code>aria-live</code>, VoiceOver iOS le lit deux fois).</li>
        <li>Le texte dit le type du message (« Erreur : », « Succès : ») : la couleur ou une icône cachée ne suffisent pas (WCAG 1.4.1).</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de couleur -->
        <div class="alert-subtle">…</div>
        <!-- Oui -->
        <div class="alert-subtle theme-neutral">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : role="alert" n'est pas fait pour un message présent au chargement -->
        <div class="alert-subtle theme-warning" role="alert">
            <p>Attention : la maintenance aura lieu dimanche.</p>
        </div>
        <!-- Oui : sans role -->
        <div class="alert-subtle theme-warning">
            <p>Attention : la maintenance aura lieu dimanche.</p>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : seule la couleur dit si le paiement est accepté ou refusé -->
        <div class="alert-subtle theme-danger"><p>Paiement</p></div>
        <!-- Oui -->
        <div class="alert-subtle theme-danger"><p>Paiement refusé</p></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        // Non : ajouter d'un coup la zone role="status" et son message, en général rien n'est lu
        zone.append(alerteAvecRoleStatus);
        // Oui : la zone existe déjà, vide ; le JS y met le message
        zone.append(alerte);
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}
    {% set code %}
        <!-- Non : sur un fond plein, btn-outline et un lien sans color-inherit ne se lisent pas -->
        <div class="alert-solid theme-primary">
            <a class="link" href="#">Voir</a> <a class="btn-outline" href="#">Voir</a>
        </div>
        <!-- Oui -->
        <div class="alert-solid theme-primary">
            <a class="link color-inherit" href="#">Voir</a> <a class="btn-solid theme-inverse" href="#">Voir</a>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas de bouton de fermeture ni de disparition automatique : c'est le rôle du toast.</li>
        <li>En clair, le cadre d'<code>alert-subtle</code> se voit à peine : le fond léger délimite l'alerte.</li>
        <li>Pas de tailles : changer les variables dans le site.</li>
    </ul>

    <h2 class="mt-10">Toutes les combinaisons</h2>
    {% for variant in ['solid', 'subtle', 'outline'] %}
        <h3 class="fs-md mt-6">alert-{{ variant }}</h3>
        <div class="grid gap-3 mt-2">
            {% for color in colors %}
                <div class="alert-{{ variant }} theme-{{ color }} md:col-6 lg:col-4">
                    <p>theme-{{ color }}, avec <a class="link{% if variant == 'solid' %} color-inherit{% endif %}" href="#">un lien</a></p>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
