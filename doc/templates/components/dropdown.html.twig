{% extends 'base.html.twig' %}

{% block title %}Dropdown{% endblock %}

{% block body %}
    <h1>Dropdown</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un menu qui s'ouvre sous un bouton : un <code>popover</code> natif, sans JavaScript. Échap ou un clic à côté le ferment.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2"><code>popovertarget</code> sur le bouton, <code>popover</code> et le même <code>id</code> sur le menu.</p>
    {% set code %}
        <button class="btn" type="button" popovertarget="menu-compte">Mon compte</button>
        <div class="dropdown" id="menu-compte" popover>
            <a class="dropdown-item" href="#">Profil</a>
            <a class="dropdown-item" href="#">Réglages</a>
            <button class="dropdown-item" type="button" disabled>Factures (bientôt)</button>
            <hr>
            <button class="dropdown-item" type="button" popovertarget="menu-compte" popovertargetaction="hide">Se déconnecter</button>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Couleurs</h2>
    <p class="mt-2">La couleur n'apparaît qu'au survol et au clic. Sur le menu, elle vaut pour tous ses éléments ; sur un élément, pour lui seul.</p>
    {% set code %}
        <button class="btn" type="button" popovertarget="menu-couleur">Mon compte</button>
        <div class="dropdown theme-primary" id="menu-couleur" popover>
            <a class="dropdown-item" href="#">Profil</a>
            <a class="dropdown-item" href="#">Réglages</a>
            <hr>
            <button class="dropdown-item theme-danger" type="button" popovertarget="menu-couleur" popovertargetaction="hide">Se déconnecter</button>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Un panneau libre</h2>
    {% set code %}
        <button class="btn" type="button" popovertarget="menu-libre">Filtres</button>
        <div class="dropdown p-4" id="menu-libre" popover>
            <p>Du texte, un formulaire de filtres…</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Au bord de l'écran</h2>
    <p class="mt-2">Sans la place à droite, le menu s'aligne sur la fin du bouton ; sans la place en dessous, il s'ouvre au-dessus.</p>
    {% set code %}
        <button class="btn" type="button" popovertarget="menu-bord">Mon compte</button>
        <div class="dropdown" id="menu-bord" popover>
            <a class="dropdown-item" href="#">Profil</a>
            <a class="dropdown-item" href="#">Réglages</a>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex justify-content-end'}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--dropdown-padding-block</th><td>0.25rem</td><td>haut et bas du panneau, autour des séparateurs</td></tr>
                <tr><th scope="row">--dropdown-padding-inline</th><td>0.25rem</td><td>côtés du panneau</td></tr>
                <tr><th scope="row">--dropdown-item-padding-block</th><td>0.375rem</td><td>haut et bas d'un élément</td></tr>
                <tr><th scope="row">--dropdown-item-padding-inline</th><td>0.75rem</td><td>côtés d'un élément</td></tr>
                <tr><th scope="row">--dropdown-min-width</th><td>10rem</td><td>largeur minimum</td></tr>
                <tr><th scope="row">--dropdown-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--dropdown-border-width</th><td>--border-width</td><td>cadre et séparateurs</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les menus, et des éléments plus hauts (40px) */
        :root {
            --dropdown-min-width: 12rem;
            --dropdown-item-padding-block: 0.5rem;
        }

        /* Un menu du site */
        .dropdown-langues { --dropdown-min-width: 6rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le navigateur annonce que le bouton ouvre un panneau et s'il est ouvert : pas d'<code>aria-expanded</code> à écrire.</li>
        <li>Tab passe du bouton au menu, Échap le ferme et rend le focus au bouton.</li>
        <li>Pas de <code>role="menu"</code> : il est fait pour les menus d'application, parcourus avec les flèches.</li>
        <li>Un menu de navigation va dans un <code>&lt;nav aria-label="…"&gt;</code>, avec son bouton ; un bouton à icône seule (⋮) a un <code>aria-label</code>.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : redondant, et faux dès l'ouverture (l'attribut écrit ne change pas) -->
        <button type="button" popovertarget="menu" aria-expanded="false">Menu</button>
        <!-- Oui -->
        <button type="button" popovertarget="menu">Menu</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : annoncé comme un menu d'application, les flèches ne font rien -->
        <div class="dropdown" id="menu" popover role="menu">
            <a class="dropdown-item" href="/profil" role="menuitem">Profil</a>
        </div>
        <!-- Oui -->
        <div class="dropdown" id="menu" popover>
            <a class="dropdown-item" href="/profil">Profil</a>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : popovertarget ne marche que sur un <button> -->
        <a href="#" popovertarget="menu">Menu</a>
        <!-- Oui -->
        <button class="btn" type="button" popovertarget="menu">Menu</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : le menu reste ouvert après le clic -->
        <button class="dropdown-item" type="button">Supprimer</button>
        <!-- Oui -->
        <button class="dropdown-item" type="button" popovertarget="menu" popovertargetaction="hide">Supprimer</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : le .theme-* du bouton ne colore pas le menu, qui n'est pas dans le bouton -->
        <button class="btn-solid theme-primary" type="button" popovertarget="menu">Menu</button>
        <div class="dropdown" id="menu" popover>…</div>
        <!-- Oui : le .theme-* sur le menu -->
        <button class="btn-solid theme-primary" type="button" popovertarget="menu">Menu</button>
        <div class="dropdown theme-primary" id="menu" popover>…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Placé par le positionnement CSS par ancre (Baseline 2026) ; dans un navigateur plus ancien, il s'ouvre en haut de l'écran, centré, et marche quand même.</li>
        <li>S'ouvre au clic, pas au survol ; pas d'animation.</li>
        <li>Un menu plus haut que la place disponible dépasse de l'écran.</li>
        <li>Pas encore de tailles, de titres de groupe ni de sous-menus.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <div class="mt-2">
        <button class="btn" type="button" popovertarget="menu-toutes-couleurs">Une couleur par élément</button>
        <div class="dropdown" id="menu-toutes-couleurs" popover>
            <button class="dropdown-item" type="button">sans thème (neutral)</button>
            {% for theme in ['primary', 'secondary', 'accent', 'success', 'danger', 'warning', 'info', 'inverse'] %}
                <button class="dropdown-item theme-{{ theme }}" type="button">theme-{{ theme }}</button>
            {% endfor %}
        </div>
    </div>
{% endblock %}
