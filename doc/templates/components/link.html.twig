{% extends 'base.html.twig' %}

{% block title %}Lien{% endblock %}

{% block body %}
    <h1>Lien</h1>
    <p class="fs-lg color-emphasis-neutral mb-6">L'élément &lt;a&gt; est stylé sans classe : souligné, gris sans thème, le soulignement s'épaissit au survol et au clic. .theme-* change sa couleur.</p>

    <p>Un paragraphe avec <a href="#">un lien au milieu du texte</a>, pour voir sa couleur, son survol et son clic.</p>
    <p>
        <a class="theme-inverse" href="#">inverse</a>
        <a class="theme-primary" href="#">primary</a>
        <a class="theme-secondary" href="#">secondary</a>
        <a class="theme-accent" href="#">accent</a>
        <a class="theme-success" href="#">success</a>
        <a class="theme-danger" href="#">danger</a>
        <a class="theme-warning" href="#">warning</a>
        <a class="theme-info" href="#">info</a>
    </p>
    <p>Comparé aux boutons : <a href="#">lien</a> <button class="btn-link" type="button">btn-link</button> <a class="theme-primary" href="#">lien primary</a> <button class="btn-link theme-primary" type="button">btn-link primary</button></p>
    <p class="theme-danger">Un parent theme-danger : <a href="#">lien</a> et <button class="btn-link" type="button">btn-link</button> prennent la même couleur.</p>
{% endblock %}
