{% extends 'base.html.twig' %}

{% block title %}Lien{% endblock %}

{% block body %}
    <h1>Lien</h1>
    <p class="fs-lg color-neutral-emphasis mb-6"><code>link</code> sur un <code>&lt;a&gt;</code> : souligné, de la couleur du texte autour ; un <code>.theme-*</code> pour la couleur. Sans la classe, un <code>&lt;a&gt;</code> garde le style du navigateur.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <p>Lire <a class="link" href="#">les conditions de vente</a> avant de commander.</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">La couleur du texte autour</h2>
    {% set code %}
        <p class="color-danger-emphasis">Un texte coloré : <a class="link" href="#">le lien</a> prend sa couleur.</p>
        <p class="bg-primary color-primary-contrast p-4">Sur un fond plein : <a class="link" href="#">le lien</a> aussi.</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-2'}) }}

    <h2 class="mt-10">Couleurs</h2>
    {% set code %}
        <a class="link theme-primary" href="#">Primary</a>
        <a class="link theme-secondary" href="#">Secondary</a>
        <a class="link theme-accent" href="#">Accent</a>
        <a class="link theme-success" href="#">Success</a>
        <a class="link theme-danger" href="#">Danger</a>
        <a class="link theme-warning" href="#">Warning</a>
        <a class="link theme-info" href="#">Info</a>
        <a class="link theme-neutral" href="#">Neutral</a>
        <a class="link theme-inverse" href="#">Inverse</a>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-wrap-wrap gap-3'}) }}

    <h2 class="mt-10">Couleur sur un parent</h2>
    <p class="mt-2">Tous les liens prennent la couleur du parent ; celui qui a son <code>.theme-*</code> garde le sien.</p>
    {% set code %}
        <p class="theme-danger">
            <a class="link" href="#">Supprimer le compte</a> ou <a class="link theme-primary" href="#">revenir au profil</a>.
        </p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Survol et clic</h2>
    <p class="mt-2">Le soulignement s'épaissit (1, 2 puis 3px), la couleur ne change pas. <code>btn-link</code> fait pareil.</p>
    {% set code %}
        <a class="link theme-primary" href="#">Un lien</a>
        <button class="btn-link theme-primary" type="button">Un bouton btn-link</button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--text-decoration-thickness</th><td>max(1px, 0.0625rem, 0.04em)</td><td>soulignement au repos (×2 au survol, ×3 au clic)</td></tr>
                <tr><th scope="row">--text-underline-offset</th><td>0.15em</td><td>distance entre le texte et le soulignement</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les liens sans thème en primary (sur un fond plein, ajouter color-inherit) */
        :root { --link-theme-emphasis: var(--color-primary-emphasis); }

        /* Un soulignement plus épais : 2, 4 et 6px */
        :root { --text-decoration-thickness: 2px; }

        /* Un lien du site */
        .lien-aere { --text-underline-offset: 0.3em; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le soulignement montre le lien sans passer par la couleur (WCAG 1.4.1) : le garder dans un texte.</li>
        <li>Le texte du lien dit où il mène, pas « cliquez ici » (WCAG 2.4.4).</li>
        <li><code>&lt;a href&gt;</code> pour changer de page, <code>&lt;button&gt;</code> pour une action.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sans link, .theme-* ne fait rien -->
        <a class="theme-primary" href="/aide">Aide</a>
        <!-- Oui -->
        <a class="link theme-primary" href="/aide">Aide</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : dans un texte, sans soulignement, le lien ne se voit plus -->
        <p>Lire <a class="link text-decoration-none" href="/aide">l'aide</a> avant de continuer.</p>
        <!-- Oui : sans soulignement seulement seul sur sa ligne (un menu) -->
        <p>Lire <a class="link" href="/aide">l'aide</a> avant de continuer.</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sous un .theme-*, le lien prend la couleur emphasis, peu lisible sur le fond plein -->
        <div class="card-solid theme-primary">
            <a class="link" href="#">Voir</a>
        </div>
        <!-- Oui : color-inherit (pareil dans alert-solid et dialog-solid) -->
        <div class="card-solid theme-primary">
            <a class="link color-inherit" href="#">Voir</a>
        </div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : une action dans un lien -->
        <a class="link" href="#" onclick="supprimer()">Supprimer</a>
        <!-- Oui -->
        <button class="btn-link" type="button">Supprimer</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Un <code>&lt;a&gt;</code> sans <code>link</code> suit le navigateur, même sur un fond plein, où il peut être illisible.</li>
        <li>Au survol et au clic, le soulignement passe sur le bas des g, p et y.</li>
        <li>Pas de lien désactivé.</li>
    </ul>
{% endblock %}
