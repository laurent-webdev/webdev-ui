{% extends 'base.html.twig' %}

{% block title %}Bouton de fermeture{% endblock %}

{% block body %}
    <h1>Bouton de fermeture</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un bouton carré avec une croix, pour fermer. Les mêmes variantes et couleurs que le bouton.</p>

    <h2 class="mt-10">Par défaut</h2>
    {% set code %}
        <button class="btn-close" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Variantes</h2>
    {% set code %}
        <button class="btn-close-solid theme-danger" type="button" aria-label="Fermer"></button>
        <button class="btn-close-subtle theme-danger" type="button" aria-label="Fermer"></button>
        <button class="btn-close-outline theme-danger" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Couleurs</h2>
    {% set code %}
        <button class="btn-close-solid theme-primary" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-secondary" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-accent" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-success" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-danger" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-warning" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-info" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-neutral" type="button" aria-label="Fermer"></button>
        <button class="btn-close-solid theme-inverse" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">La hauteur du bouton de la même taille : 24, 31, 36 et 41px. Sans classe : xs.</p>
    {% set code %}
        <button class="btn-close btn-close-xs" type="button" aria-label="Fermer"></button>
        <button class="btn-close btn-close-sm" type="button" aria-label="Fermer"></button>
        <button class="btn-close btn-close-md" type="button" aria-label="Fermer"></button>
        <button class="btn-close btn-close-lg" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Fermer un dialogue</h2>
    {% set code %}
        <button class="btn-close" type="button" commandfor="dialog-compte" command="close" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--btn-close-width</th><td>1.5rem</td><td>côté du carré (la croix suit)</td></tr>
                <tr><th scope="row">--btn-close-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--btn-close-border-width</th><td>--border-width</td><td>épaisseur du cadre</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les boutons de fermeture sans taille (btn-close-xs garde 24px) */
        :root { --btn-close-width: 2rem; }

        /* Une taille */
        .btn-close-lg { --btn-close-width: 3rem; }

        /* Un bouton du site */
        .btn-close-rond { --btn-close-border-radius: 50%; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>La croix n'a pas de texte : <code>aria-label="Fermer"</code> donne son nom au bouton.</li>
        <li>24px au plus petit, la cible tactile minimale (WCAG 2.5.8).</li>
        <li>En contraste élevé (Windows), la croix prend la couleur des boutons du système.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de couleur -->
        <button class="btn-close-subtle" type="button" aria-label="Fermer"></button>
        <!-- Oui -->
        <button class="btn-close-subtle theme-neutral" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans aria-label, le lecteur d'écran dit seulement « bouton » -->
        <button class="btn-close" type="button"></button>
        <!-- Non : × est lu « multiplication » et s'affiche en plus de la croix -->
        <button class="btn-close" type="button">×</button>
        <!-- Oui -->
        <button class="btn-close" type="button" aria-label="Fermer"></button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sur un fond plein, btn-close-outline ne se lit pas -->
        <dialog class="dialog-solid theme-primary">
            <button class="btn-close-outline" type="button" aria-label="Fermer"></button>
        </dialog>
        <!-- Oui : btn-close-solid du même thème, le carré se fond dans le fond -->
        <dialog class="dialog-solid theme-primary">
            <button class="btn-close-solid" type="button" aria-label="Fermer"></button>
        </dialog>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Sur un fond léger de la même couleur, <code>btn-close-subtle</code> a le même fond : seule la croix se voit.</li>
        <li>Sur un fond plein, le contour de focus peut manquer de contraste, comme pour les boutons.</li>
        <li>Pas d'état désactivé.</li>
    </ul>

    <h2 class="mt-10" id="combinaisons">Toutes les combinaisons</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="combinaisons" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Thème</th>
                    <th scope="col">btn-close-solid</th>
                    <th scope="col">btn-close-subtle</th>
                    <th scope="col">btn-close-outline</th>
                </tr>
            </thead>
            <tbody>
                {% for color in colors %}
                    <tr>
                        <th scope="row">theme-{{ color }}</th>
                        {% for variant in ['solid', 'subtle', 'outline'] %}
                            <td><button class="btn-close-{{ variant }} theme-{{ color }}" type="button" aria-label="Fermer"></button></td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
