{% extends 'base.html.twig' %}

{% block title %}Dialogue{% endblock %}

{% block body %}
    <h1>Dialogue</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un <code>&lt;dialog&gt;</code> natif, ouvert et fermé sans JavaScript par <code>command</code> et <code>commandfor</code>. Avec <code>data-dialog</code>, le JS du framework l'efface aussi à la fermeture.</p>

    <h2 class="mt-10">Par défaut</h2>
    <p class="mt-2">Échap ou un bouton le ferment ; le focus revient sur le bouton d'ouverture.</p>
    {% set code %}
        <button class="btn-solid theme-primary" type="button" commandfor="dialog-compte" command="show-modal">Mon compte</button>
        <dialog class="dialog" id="dialog-compte" data-dialog aria-labelledby="dialog-compte-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-compte-titre">Mon compte</h2>
                <button class="btn-close" type="button" commandfor="dialog-compte" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <p>Le contenu du dialogue.</p>
            </div>
            <div class="dialog-footer">
                <button class="btn" type="button" commandfor="dialog-compte" command="close">Annuler</button>
                <button class="btn-solid theme-primary" type="button" commandfor="dialog-compte" command="close">Enregistrer</button>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10" id="closedby">Fermer en cliquant à côté</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="closedby" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">closedby</th>
                    <th scope="col">Échap</th>
                    <th scope="col">Clic à côté</th>
                    <th scope="col">Bouton du dialogue</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">any</th><td>oui</td><td>oui</td><td>oui</td></tr>
                <tr><th scope="row">closerequest (défaut)</th><td>oui</td><td>non</td><td>oui</td></tr>
                <tr><th scope="row">none</th><td>non</td><td>non</td><td>oui</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-aide" command="show-modal">Aide</button>
        <dialog class="dialog" id="dialog-aide" data-dialog closedby="any" aria-labelledby="dialog-aide-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-aide-titre">Aide</h2>
                <button class="btn-close" type="button" commandfor="dialog-aide" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <p>Un clic à côté le ferme aussi.</p>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Fermer seulement par un bouton</h2>
    <p class="mt-2"><code>closedby="none"</code> : pour un choix obligatoire, un bouton par réponse et pas de croix.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-modifications" command="show-modal">Quitter</button>
        <dialog class="dialog" id="dialog-modifications" data-dialog closedby="none" aria-labelledby="dialog-modifications-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-modifications-titre">Modifications non enregistrées</h2>
            </div>
            <div class="dialog-body">
                <p>Ni Échap ni un clic à côté ne le ferment : il faut choisir.</p>
            </div>
            <div class="dialog-footer">
                <button class="btn" type="button" commandfor="dialog-modifications" command="close">Ne pas enregistrer</button>
                <button class="btn-solid theme-primary" type="button" commandfor="dialog-modifications" command="close">Enregistrer</button>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Variantes</h2>
    <p class="mt-2">Sur <code>dialog-solid</code> : un <code>btn-solid</code> d'un autre thème, la croix <code>btn-close-solid</code> du même thème.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-solid" command="show-modal">dialog-solid</button>
        <dialog class="dialog-solid theme-primary" id="dialog-solid" data-dialog aria-labelledby="dialog-solid-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-solid-titre">dialog-solid</h2>
                <button class="btn-close-solid" type="button" commandfor="dialog-solid" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <p>Texte noir ou blanc. <a class="link color-inherit" href="#">Un lien</a></p>
            </div>
            <div class="dialog-footer">
                <button class="btn-solid theme-inverse" type="button" commandfor="dialog-solid" command="close">OK</button>
            </div>
        </dialog>

        <button class="btn" type="button" commandfor="dialog-subtle" command="show-modal">dialog-subtle</button>
        <dialog class="dialog-subtle theme-success" id="dialog-subtle" data-dialog aria-labelledby="dialog-subtle-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-subtle-titre">dialog-subtle</h2>
                <button class="btn-close-subtle" type="button" commandfor="dialog-subtle" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <p>Le texte de la page. <a class="link" href="#">Un lien</a></p>
            </div>
            <div class="dialog-footer">
                <button class="btn-solid" type="button" commandfor="dialog-subtle" command="close">OK</button>
            </div>
        </dialog>

        <button class="btn" type="button" commandfor="dialog-outline" command="show-modal">dialog-outline</button>
        <dialog class="dialog-outline theme-neutral" id="dialog-outline" data-dialog aria-labelledby="dialog-outline-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-outline-titre">dialog-outline</h2>
                <button class="btn-close-subtle" type="button" commandfor="dialog-outline" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <p>Le fond de la page, un cadre de la couleur.</p>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">La largeur du breakpoint du même nom : 360, 576, 768 (le défaut), 1024 et 1280px.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-xs" command="show-modal">dialog-xs</button>
        <button class="btn" type="button" commandfor="dialog-sm" command="show-modal">dialog-sm</button>
        <button class="btn" type="button" commandfor="dialog-md" command="show-modal">dialog-md</button>
        <button class="btn" type="button" commandfor="dialog-lg" command="show-modal">dialog-lg</button>
        <button class="btn" type="button" commandfor="dialog-xl" command="show-modal">dialog-xl</button>

        <dialog class="dialog dialog-xs" id="dialog-xs" data-dialog aria-labelledby="dialog-xs-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-xs-titre">dialog-xs</h2>
                <button class="btn-close" type="button" commandfor="dialog-xs" command="close" aria-label="Fermer"></button>
            </div>
        </dialog>
        <dialog class="dialog dialog-sm" id="dialog-sm" data-dialog aria-labelledby="dialog-sm-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-sm-titre">dialog-sm</h2>
                <button class="btn-close" type="button" commandfor="dialog-sm" command="close" aria-label="Fermer"></button>
            </div>
        </dialog>
        <dialog class="dialog dialog-md" id="dialog-md" data-dialog aria-labelledby="dialog-md-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-md-titre">dialog-md</h2>
                <button class="btn-close" type="button" commandfor="dialog-md" command="close" aria-label="Fermer"></button>
            </div>
        </dialog>
        <dialog class="dialog dialog-lg" id="dialog-lg" data-dialog aria-labelledby="dialog-lg-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-lg-titre">dialog-lg</h2>
                <button class="btn-close" type="button" commandfor="dialog-lg" command="close" aria-label="Fermer"></button>
            </div>
        </dialog>
        <dialog class="dialog dialog-xl" id="dialog-xl" data-dialog aria-labelledby="dialog-xl-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-xl-titre">dialog-xl</h2>
                <button class="btn-close" type="button" commandfor="dialog-xl" command="close" aria-label="Fermer"></button>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">La croix à gauche</h2>
    <p class="mt-2">La croix se place selon son ordre dans le HTML.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-croix" command="show-modal">Croix à gauche</button>
        <dialog class="dialog" id="dialog-croix" data-dialog aria-labelledby="dialog-croix-titre">
            <div class="dialog-header">
                <button class="btn-close" type="button" commandfor="dialog-croix" command="close" aria-label="Fermer"></button>
                <h2 class="fs-lg" id="dialog-croix-titre">Croix à gauche</h2>
            </div>
            <div class="dialog-body">
                <p>Le titre suit la croix.</p>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Une confirmation</h2>
    <p class="mt-2"><code>role="alertdialog"</code> ; <code>autofocus</code> sur le choix sans risque ; le JS du site lit le <code>value</code> du bouton dans <code>returnValue</code>.</p>
    {% set code %}
        <button class="btn-solid theme-danger" type="button" commandfor="dialog-supprimer" command="show-modal">Supprimer le fichier</button>
        <dialog class="dialog dialog-xs" id="dialog-supprimer" data-dialog role="alertdialog" aria-labelledby="dialog-supprimer-titre" aria-describedby="dialog-supprimer-texte">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-supprimer-titre">Supprimer le fichier ?</h2>
            </div>
            <div class="dialog-body">
                <p id="dialog-supprimer-texte">Le fichier rapport.pdf sera supprimé définitivement.</p>
            </div>
            <div class="dialog-footer">
                <button class="btn" type="button" commandfor="dialog-supprimer" command="close" autofocus>Annuler</button>
                <button class="btn-solid theme-danger" type="button" commandfor="dialog-supprimer" command="close" value="supprimer">Supprimer</button>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Un contenu long</h2>
    <p class="mt-2">Le dialogue ne dépasse pas de l'écran : tout le dialogue défile, en-tête compris.</p>
    {% set code %}
        <button class="btn" type="button" commandfor="dialog-conditions" command="show-modal">Conditions d'utilisation</button>
        <dialog class="dialog" id="dialog-conditions" data-dialog aria-labelledby="dialog-conditions-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-conditions-titre">Conditions d'utilisation</h2>
                <button class="btn-close" type="button" commandfor="dialog-conditions" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                <!-- Un long texte -->
            </div>
            <div class="dialog-footer">
                <button class="btn-solid theme-primary" type="button" commandfor="dialog-conditions" command="close">J'ai lu</button>
            </div>
        </dialog>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" commandfor="dialog-conditions" command="show-modal">Conditions d'utilisation</button>
        <dialog class="dialog" id="dialog-conditions" data-dialog aria-labelledby="dialog-conditions-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="dialog-conditions-titre">Conditions d'utilisation</h2>
                <button class="btn-close" type="button" commandfor="dialog-conditions" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body">
                {% for i in 1..12 %}
                    <h3 class="fs-md{% if not loop.first %} mt-4{% endif %}">Article {{ i }}</h3>
                    <p class="mt-2">Un long paragraphe de conditions, pour voir le défilement : quand le contenu est plus haut que l'écran, c'est le dialogue entier qui défile.</p>
                {% endfor %}
            </div>
            <div class="dialog-footer">
                <button class="btn-solid theme-primary" type="button" commandfor="dialog-conditions" command="close">J'ai lu</button>
            </div>
        </dialog>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--dialog-padding-block</th><td>1rem</td><td>haut et bas de l'en-tête, du corps et du pied</td></tr>
                <tr><th scope="row">--dialog-padding-inline</th><td>1rem</td><td>côtés de l'en-tête, du corps et du pied</td></tr>
                <tr><th scope="row">--dialog-border-radius</th><td>--border-radius-md</td><td>coins</td></tr>
                <tr><th scope="row">--dialog-border-width</th><td>--border-width</td><td>cadre et traits</td></tr>
                <tr><th scope="row">--dialog-width</th><td>48rem</td><td>largeur</td></tr>
                <tr><th scope="row">--dialog-transition-duration</th><td>0.2s</td><td>apparition et disparition</td></tr>
                <tr><th scope="row">--backdrop-background-color</th><td>noir à 50 % (65 % en sombre)</td><td>fond qui assombrit la page</td></tr>
                <tr><th scope="row">--backdrop-filter</th><td>blur(5px)</td><td>flou de la page</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tous les dialogues sans taille ; un fond plus clair, sans flou */
        :root {
            --dialog-width: 40rem;
            --backdrop-background-color: oklch(0 0 0 / 0.3);
            --backdrop-filter: none;
        }

        /* Un dialogue du site */
        .dialog-panier { --dialog-width: 50rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10" id="javascript">JavaScript</h2>
    <p class="mt-2">Rien à écrire : <code>dist/js/webdev-ui.js</code> anime la fermeture de tous les <code>&lt;dialog data-dialog&gt;</code> et, dans Safari, ferme au clic à côté les dialogues modaux en <code>closedby="any"</code>. Les événements sont ceux du navigateur.</p>
    <div class="table-responsive mt-2" role="region" aria-labelledby="javascript" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Événement</th>
                    <th scope="col">Envoyé</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">command</th><td>un bouton <code>commandfor</code> l'ouvre ou le ferme (<code>event.source</code> = le bouton)</td></tr>
                <tr><th scope="row">cancel</th><td>Échap, clic à côté, <code>command="request-close"</code> ou <code>requestClose()</code></td></tr>
                <tr><th scope="row">close</th><td>le dialogue est fermé, après l'animation</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        // Le choix de la confirmation
        document.getElementById('dialog-supprimer').addEventListener('close', (event) => {
            if (event.target.returnValue === 'supprimer') { … }
        });

        // Fermer depuis le JS du site : animé ; close() ferme d'un coup
        dialog.requestClose();
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'js'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Toujours <code>command="show-modal"</code> : la page est inactive, Échap ferme, le focus entre dans le dialogue puis revient.</li>
        <li><code>aria-labelledby</code> vers le titre ; au moins un bouton visible pour fermer.</li>
        <li><code>autofocus</code> sur l'élément à utiliser en premier ; sinon le focus va sur la croix.</li>
        <li><code>&lt;div class="dialog-header"&gt;</code> et non <code>&lt;header&gt;</code> : hors d'un <code>&lt;main&gt;</code>, il deviendrait l'en-tête de toute la page.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : une variante sans .theme-* n'a pas de fond, la page se voit à travers -->
        <dialog class="dialog-solid">…</dialog>
        <!-- Oui -->
        <dialog class="dialog-solid theme-neutral">…</dialog>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : open affiche un dialogue non modal (pas de fond, Échap ne ferme pas) -->
        <dialog class="dialog" open>…</dialog>
        <!-- Non : pas de tabindex sur un dialog -->
        <dialog class="dialog" tabindex="-1">…</dialog>
        <!-- Oui : ouvert par un bouton command="show-modal" -->
        <dialog class="dialog" id="dialog-compte" data-dialog aria-labelledby="dialog-compte-titre">…</dialog>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : closedby="none" sans bouton, la personne est bloquée -->
        <dialog class="dialog" closedby="none"><p>Chargement…</p></dialog>
        <!-- Oui : un chargement s'affiche dans la page -->
        <p role="status" aria-live="polite"><span class="spinner"></span> Chargement…</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li><code>command</code> et <code>commandfor</code> sont récents (Baseline 2025) : ailleurs, le JS du site ouvre avec <code>showModal()</code>.</li>
        <li><code>closedby</code> n'est pas encore dans Safari : <code>dist/js/webdev-ui.js</code> y fait le clic à côté d'un dialogue modal en <code>closedby="any"</code> ; <code>closedby="none"</code> y reste ignoré, Échap ferme.</li>
        <li>La fermeture ne s'anime qu'avec <code>data-dialog</code> ; <code>close()</code> et <code>&lt;form method="dialog"&gt;</code> ferment d'un coup. Échap pressé deux fois ferme d'un coup.</li>
        <li>Avec <code>data-dialog</code>, <code>preventDefault()</code> sur <code>cancel</code> ne garde pas le dialogue ouvert : <code>closedby="none"</code>, ou pas de <code>data-dialog</code>.</li>
        <li>Le flou peut saccader sur un vieux téléphone : <code>--backdrop-filter: none</code>.</li>
    </ul>
{% endblock %}
