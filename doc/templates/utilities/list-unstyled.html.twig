{% extends 'base.html.twig' %}

{% block title %}Liste sans style{% endblock %}

{% block body %}
    <h1>Liste sans style</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Une liste sans puces ni retrait : <code>list-unstyled</code>. Le lecteur d'écran l'annonce toujours comme une liste, avec son nombre d'éléments.</p>

    <h2 class="mt-10">Des liens</h2>
    <p class="mt-2">Les liens d'un pied de page, empilés ; l'écart vient de la grille.</p>
    {% set code %}
        <ul class="list-unstyled d-grid gap-2">
            <li><a class="link" href="#">Livraison</a></li>
            <li><a class="link" href="#">Contact</a></li>
            <li><a class="link" href="#">Mentions légales</a></li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Sur une ligne</h2>
    {% set code %}
        <ul class="list-unstyled d-flex flex-wrap-wrap gap-2">
            <li><span class="badge">Design</span></li>
            <li><span class="badge">Contenu</span></li>
            <li><span class="badge">Développement</span></li>
        </ul>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li><code>list-style-type: ""</code> et pas <code>none</code> : avec <code>none</code>, Safari n'annonce plus une liste.</li>
        <li>Pas de <code>role="list"</code> pour la garder : le validateur W3C le signale.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : des liens à la suite, le lecteur d'écran ne dit pas combien il y en a -->
        <div class="d-grid gap-2">
            <a class="link" href="#">Livraison</a>
            <a class="link" href="#">Contact</a>
        </div>
        <!-- Oui -->
        <ul class="list-unstyled d-grid gap-2">
            <li><a class="link" href="#">Livraison</a></li>
            <li><a class="link" href="#">Contact</a></li>
        </ul>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Seulement la liste qui a la classe : une liste dans un de ses éléments garde ses puces.</li>
        <li>Une liste encadrée, avec des liens qui se cliquent sur toute la ligne : la <a class="link" href="{{ path('app_list') }}" data-hx-boost="true">liste</a>.</li>
    </ul>
{% endblock %}
