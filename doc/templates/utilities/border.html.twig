{% extends 'base.html.twig' %}

{% block title %}Bordures{% endblock %}

{% block body %}
    <h1>Bordures</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Les côtés (<code>border</code>, <code>border-x</code>, <code>border-top</code>…), l'épaisseur (<code>border-1</code> à <code>-5</code>), la couleur (<code>border-*</code>, <code>border-*-emphasis</code>) et les arrondis (<code>border-radius-*</code>).</p>

    <h2 class="mt-10">Côtés</h2>
    {% set code %}
        <p class="border p-4">border</p>
        <p class="border-x p-4">border-x</p>
        <p class="border-y p-4">border-y</p>
        <p class="border-top p-4">border-top</p>
        <p class="border-bottom p-4">border-bottom</p>
        <p class="border-start p-4">border-start</p>
        <p class="border-end p-4">border-end</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-wrap-wrap gap-4'}) }}

    <h2 class="mt-10">Épaisseur et couleur</h2>
    <p class="mt-2">Avec <code>border</code> ou un côté ; l'épaisseur en px.</p>
    {% set code %}
        <p class="border border-2 border-neutral-emphasis p-4">border-2</p>
        <p class="border border-4 border-primary-emphasis p-4">border-4 border-primary-emphasis</p>
        <p class="border border-primary p-4">border-primary</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-wrap-wrap gap-4'}) }}

    <h2 class="mt-10">Arrondis</h2>
    <p class="mt-2">xs 2px, sm 4px, md 6px (celui des composants), lg 8px, xl 10px.</p>
    {% set code %}
        <p class="bg-primary-subtle border-radius-0 p-4">border-radius-0</p>
        <p class="bg-primary-subtle border-radius-xs p-4">border-radius-xs</p>
        <p class="bg-primary-subtle border-radius-sm p-4">border-radius-sm</p>
        <p class="bg-primary-subtle border-radius-md p-4">border-radius-md</p>
        <p class="bg-primary-subtle border-radius-lg p-4">border-radius-lg</p>
        <p class="bg-primary-subtle border-radius-xl p-4">border-radius-xl</p>
        <p class="bg-primary-subtle border-radius-pill px-4 py-2">border-radius-pill</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-wrap-wrap align-items-center gap-4'}) }}

    <h2 class="mt-10">Un cercle</h2>
    <p class="mt-2"><code>border-radius-circle</code> sur un élément carré.</p>
    {% set code %}
        <img class="aspect-ratio-1x1 object-fit-cover border-radius-circle" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="96" height="96">
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Un encadré</h2>
    {% set code %}
        <p class="border border-radius-lg p-4">Un bloc séparé du reste de la page.</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Une citation</h2>
    <p class="mt-2">Le trait suit le sens d'écriture.</p>
    {% set code %}
        <blockquote class="border-start border-4 border-primary-emphasis ps-4">
            <p>Un trait épais sur le côté de la citation.</p>
        </blockquote>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Sans le cadre natif</h2>
    {% set code %}
        <fieldset class="border-0">
            <legend>Préférences</legend>
            <label><input class="form-checkbox" type="checkbox" name="demo-border"> Recevoir les nouveautés</label>
        </fieldset>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--border-width</th><td>1px</td><td><code>border</code> sans épaisseur, et toutes les bordures des composants</td></tr>
                <tr><th scope="row">--border-color</th><td>gris</td><td><code>border</code> sans couleur, bordures décoratives</td></tr>
                <tr><th scope="row">--border-radius-xs à -xl</th><td>2 à 10px</td><td>arrondis</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les bordures, composants compris */
        :root { --border-width: 2px; }

        /* Un arrondi, et les composants qui le lisent */
        :root { --border-radius-md: 0.5rem; }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Le gris de <code>border</code> et les couleurs brutes <code>border-*</code> sont décoratifs : une bordure qui seule montre un élément prend <code>border-*-emphasis</code> (au moins 3:1, WCAG 1.4.11).</li>
        <li>Un champ de formulaire : <code>form-input</code>, pas <code>border</code>.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sans border, il n'y a pas de bordure à colorer ni à épaissir -->
        <div class="border-primary border-2">…</div>
        <!-- Oui -->
        <div class="border border-primary border-2">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : une couleur brute, souvent trop claire pour se voir (le jaune en clair) -->
        <div class="border border-warning">Attention : …</div>
        <!-- Oui -->
        <div class="border border-warning-emphasis">Attention : …</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : circle sur un élément qui n'est pas carré, une ellipse -->
        <p class="border-radius-circle p-4">Texte</p>
        <!-- Oui : des bouts ronds -->
        <p class="border-radius-pill px-4 py-2">Texte</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li><code>border-1</code> à <code>-5</code> sont en px fixes : changer <code>--border-width</code> ne les change pas.</li>
        <li>Pas d'arrondi par coin, de pointillés ni de préfixe d'écran : dans le site.</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <h3 class="fs-md mt-6">border border-*</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="border border-{{ color }} p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">border border-*-emphasis</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="border border-{{ color }}-emphasis p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
{% endblock %}
