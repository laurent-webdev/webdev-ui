{% extends 'base.html.twig' %}

{% block title %}Gap{% endblock %}

{% block body %}
    <h1>Gap</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">L'espace entre les enfants d'une grille ou d'un flex : <code>gap-*</code>, <code>row-gap-*</code> et <code>column-gap-*</code>, de 0 à 12 (<code>--space-*</code>).</p>

    <h2 class="mt-10">Dans une grille</h2>
    <p class="mt-2">Sans classe, <code>grid</code> a déjà 1rem (<code>--grid-gap</code>).</p>
    {% set code %}
        <div class="grid gap-2">
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Lignes et colonnes</h2>
    <p class="mt-2">Le plus précis gagne : <code>row-gap-8</code> passe devant <code>gap-2</code>.</p>
    {% set code %}
        <div class="grid gap-2 row-gap-8">
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Sans espace</h2>
    {% set code %}
        <div class="grid gap-0">
            <p class="border p-2 col-4">col-4</p>
            <p class="border p-2 col-4">col-4</p>
            <p class="border p-2 col-4">col-4</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Dans un flex</h2>
    {% set code %}
        <div class="d-flex flex-wrap-wrap gap-4">
            <p class="bg-primary-subtle p-2">Un</p>
            <p class="bg-primary-subtle p-2">Deux</p>
            <p class="bg-primary-subtle p-2">Trois</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Selon l'écran</h2>
    {% set code %}
        <div class="grid gap-2 md:gap-8">
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
            <p class="bg-primary-subtle p-2 col-4">col-4</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : gap ne fait rien sans flex ni grid -->
        <div class="gap-4"><p>…</p><p>…</p></div>
        <!-- Oui -->
        <div class="d-grid gap-4"><p>…</p><p>…</p></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>L'échelle est celle des espacements : changer <code>--space</code> change aussi les gaps.</li>
    </ul>
{% endblock %}
