{% extends 'base.html.twig' %}

{% block title %}Verre{% endblock %}

{% block body %}
    <h1>Verre</h1>
    <p class="fs-lg color-neutral-emphasis mb-6"><code>glass</code> : un fond translucide, clair ou foncé selon le thème, et ce qui est derrière flouté. Sur un composant sans couleur ou <code>-outline</code>, ou un bloc du site.</p>

    <div class="toast-container" role="status" aria-live="polite" aria-atomic="false" popover="manual" data-toast></div>

    <h2 class="mt-10">Sur une image</h2>
    <p class="mt-2">Le fond de l'exemple est chargé exprès : une bande noire à gauche, une blanche à droite, le pire cas pour le texte.</p>
    {% set code %}
        <div class="grid gap-4">
            <div class="card glass md:col-6">
                <div class="card-header"><h3 class="fs-md">card glass</h3></div>
                <div class="card-body"><p>Le texte de la page, avec <a class="link" href="#">un lien</a>.</p></div>
            </div>
            <div class="card-outline theme-primary glass md:col-6">
                <div class="card-body"><p>card-outline : le cadre coloré reste.</p></div>
            </div>
            <div class="alert glass md:col-6">
                <p>alert glass : un message posé sur une image.</p>
            </div>
            <div class="accordion glass md:col-6">
                <details name="glass-accordion" open>
                    <summary>accordion glass</summary>
                    <div class="accordion-body"><p>Le survol d'un titre pose un voile transparent.</p></div>
                </details>
                <details name="glass-accordion">
                    <summary>Deuxième panneau</summary>
                    <div class="accordion-body"><p>Le contenu du deuxième panneau.</p></div>
                </details>
            </div>
        </div>
    {% endset %}
    {% set demo %}
        <div class="demo-glass">
            <p class="demo-glass-text" aria-hidden="true">VERRE</p>
            {{ code }}
            <p class="demo-glass-text" aria-hidden="true">DÉPOLI</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: 'p-0 overflow-hidden'}) }}

    <h2 class="mt-10">Une barre collée en haut</h2>
    <p class="mt-2">En faisant défiler la page, le fond passe dessous ; <code>px-4</code> donne une marge au verre.</p>
    {% set code %}
        <nav class="navbar navbar-expand glass position-sticky top-0 px-4" aria-label="Exemple en verre">
            <a class="navbar-brand" href="#">Mon site</a>
            <ul class="navbar-list">
                <li><a class="navbar-item" href="#" aria-current="page">Accueil</a></li>
                <li><a class="navbar-item" href="#">Blog</a></li>
                <li><a class="navbar-item" href="#">Contact</a></li>
            </ul>
        </nav>
    {% endset %}
    {% set demo %}
        <div class="demo-glass">
            {{ code }}
            <p class="demo-glass-text mt-6" aria-hidden="true">FLOU</p>
            <p class="demo-glass-text mt-6" aria-hidden="true">DERRIÈRE</p>
            <p class="demo-glass-text mt-6" aria-hidden="true">LA BARRE</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: 'p-0 overflow-clip'}) }}

    <h2 class="mt-10">Par-dessus la page</h2>
    <p class="mt-2">Le dropdown, le dialogue, le drawer et le toast floutent ce qu'il y a derrière eux.</p>
    {% set code %}
        <button class="btn" type="button" popovertarget="glass-dropdown">Dropdown</button>
        <div class="dropdown glass" id="glass-dropdown" popover>
            <a class="dropdown-item" href="#">Profil</a>
            <a class="dropdown-item" href="#">Réglages</a>
        </div>

        <button class="btn" type="button" commandfor="glass-dialog" command="show-modal">Dialogue</button>
        <dialog class="dialog glass dialog-sm" id="glass-dialog" data-dialog closedby="any" aria-labelledby="glass-dialog-titre">
            <div class="dialog-header">
                <h3 class="fs-lg" id="glass-dialog-titre">dialog glass</h3>
                <button class="btn-close" type="button" commandfor="glass-dialog" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body"><p>Devant la page assombrie et floutée.</p></div>
        </dialog>

        <button class="btn" type="button" commandfor="glass-drawer" command="show-modal">Drawer</button>
        <dialog class="drawer-end glass" id="glass-drawer" data-dialog closedby="any" aria-labelledby="glass-drawer-titre">
            <div class="drawer-header">
                <h3 class="fs-lg" id="glass-drawer-titre">drawer-end glass</h3>
                <button class="btn-close" type="button" commandfor="glass-drawer" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body"><p>Glisse depuis la droite.</p></div>
        </dialog>

        <!-- Ajouté par le site dans le conteneur de toasts -->
        <div class="toast glass">
            <p>Profil enregistré.</p>
            <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
        </div>
    {% endset %}
    {% set demo %}
        <button class="btn" type="button" popovertarget="glass-dropdown">Dropdown</button>
        <div class="dropdown glass" id="glass-dropdown" popover>
            <a class="dropdown-item" href="#">Profil</a>
            <a class="dropdown-item" href="#">Réglages</a>
        </div>
        <button class="btn" type="button" commandfor="glass-dialog" command="show-modal">Dialogue</button>
        <dialog class="dialog glass dialog-sm" id="glass-dialog" data-dialog closedby="any" aria-labelledby="glass-dialog-titre">
            <div class="dialog-header">
                <h3 class="fs-lg" id="glass-dialog-titre">dialog glass</h3>
                <button class="btn-close" type="button" commandfor="glass-dialog" command="close" aria-label="Fermer"></button>
            </div>
            <div class="dialog-body"><p>Devant la page assombrie et floutée.</p></div>
        </dialog>
        <button class="btn" type="button" commandfor="glass-drawer" command="show-modal">Drawer</button>
        <dialog class="drawer-end glass" id="glass-drawer" data-dialog closedby="any" aria-labelledby="glass-drawer-titre">
            <div class="drawer-header">
                <h3 class="fs-lg" id="glass-drawer-titre">drawer-end glass</h3>
                <button class="btn-close" type="button" commandfor="glass-drawer" command="close" aria-label="Fermer"></button>
            </div>
            <div class="drawer-body"><p>Glisse depuis la droite.</p></div>
        </dialog>
        <button class="btn" type="button" data-demo-toast="glass-toast">Toast</button>
        <template id="glass-toast">
            <div class="toast glass">
                <p>Profil enregistré.</p>
                <button class="btn-close" type="button" aria-label="Fermer" data-toast-close></button>
            </div>
        </template>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--glass-background-color</th><td>--color-background à 70 %</td><td>le fond du verre, clair ou foncé selon le thème</td></tr>
                <tr><th scope="row">--glass-backdrop-filter</th><td>blur(16px) saturate(180%)</td><td>ce qui est derrière : flouté, un peu plus saturé</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Tout le verre du site : moins flou */
        :root { --glass-backdrop-filter: blur(8px) saturate(150%); }

        /* Un bloc du site : plus opaque (60 % au moins) */
        .hero-card { --glass-background-color: oklch(from var(--color-background) l c h / 0.85); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>À 70 %, le texte de la page reste lisible devant du noir (en clair) ou du blanc (en sombre) ; sous 60 %, plus.</li>
        <li>Le texte coloré (emphasis, <code>btn-outline</code>, <code>btn-text</code>, un lien avec un thème) n'est pas garanti : sur le verre, le texte de la page et des boutons qui ont leur fond.</li>
        <li>« Réduire la transparence » (<code>prefers-reduced-transparency</code>) : un fond plein, sans flou (Chrome et Edge).</li>
        <li>Lighthouse ne calcule pas un contraste sur un fond translucide : à regarder à la main.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sur solid, le texte noir ou blanc est fait pour la couleur pleine, pas pour le verre -->
        <div class="card-solid theme-primary glass">…</div>
        <!-- Oui -->
        <div class="card glass">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un texte coloré sans fond sur le verre -->
        <div class="card glass"><button class="btn-outline theme-info" type="button">Voir</button></div>
        <!-- Oui : un bouton qui a son fond -->
        <div class="card glass"><button class="btn-solid theme-info" type="button">Voir</button></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        /* Non : sous 60 %, le texte de la page descend sous 4,5:1 */
        :root { --glass-background-color: oklch(from var(--color-background) l c h / 0.4); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li><code>backdrop-filter</code> fait de l'élément la référence des éléments fixés qu'il contient : le conteneur de toasts d'un dialogue en verre se met dans le coin du dialogue.</li>
        <li>Un verre dans un verre ne floute que le contenu du premier. Pas de verre coloré.</li>
        <li>Le flou coûte du calcul : beaucoup de verre à l'écran peut ralentir le défilement sur un appareil lent.</li>
    </ul>
{% endblock %}
