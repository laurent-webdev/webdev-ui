{% extends 'base.html.twig' %}

{% block title %}Visibilité{% endblock %}

{% block body %}
    <h1>Visibilité</h1>
    <p class="fs-lg color-neutral-emphasis mb-6"><code>visibility-hidden</code> cache un élément en gardant sa place ; <code>visibility-visible</code> réaffiche un enfant d'un parent caché.</p>

    <h2 class="mt-10">Garder la place</h2>
    {% set code %}
        <p>Avant <span class="visibility-hidden">caché</span> après</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Un enfant visible</h2>
    {% set code %}
        <p class="visibility-hidden">Parent caché, <span class="visibility-visible">enfant visible</span></p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10" id="cacher-quelle-classe">Cacher : quelle classe ?</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="cacher-quelle-classe" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Classe</th>
                    <th scope="col">Garde sa place</th>
                    <th scope="col">Lu par les lecteurs d'écran</th>
                    <th scope="col">Cliquable, focusable</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">hidden, d-none</th><td>non</td><td>non</td><td>non</td></tr>
                <tr><th scope="row">visibility-hidden</th><td>oui</td><td>non</td><td>non</td></tr>
                <tr><th scope="row">opacity-0</th><td>oui</td><td>oui</td><td>oui</td></tr>
                <tr><th scope="row">visually-hidden</th><td>non</td><td>oui</td><td>oui</td></tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : caché aussi aux lecteurs d'écran -->
        <span class="visibility-hidden">Chargement…</span>
        <!-- Oui : pour eux seuls -->
        <span class="visually-hidden">Chargement…</span>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : visibility-visible ne réaffiche que dans un parent visibility-hidden -->
        <div class="opacity-0"><p class="visibility-visible">…</p></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas de préfixe d'écran : pour cacher selon l'écran, <code>d-none md:d-block</code> (la place n'est pas gardée).</li>
    </ul>
{% endblock %}
