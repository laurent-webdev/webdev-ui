{% extends 'base.html.twig' %}

{% block title %}Couleurs{% endblock %}

{% block body %}
    <h1>Couleurs</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Le fond par <code>bg-*</code> et <code>bg-*-subtle</code>, le texte à part : <code>color-*-contrast</code> sur un fond plein, <code>color-*-emphasis</code> pour un texte coloré, <code>color-*</code> pour une icône.</p>

    <h2 class="mt-10">Fond plein</h2>
    <p class="mt-2">Toujours la paire <code>bg-*</code> + <code>color-*-contrast</code> : un texte noir ou blanc, le plus lisible.</p>
    {% set code %}
        <p class="bg-primary color-primary-contrast p-2">bg-primary color-primary-contrast</p>
        <p class="bg-danger color-danger-contrast p-2">bg-danger color-danger-contrast</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-2'}) }}

    <h2 class="mt-10">Fond léger</h2>
    <p class="mt-2">Le texte de la page, ou un texte coloré.</p>
    {% set code %}
        <p class="bg-success-subtle p-2">bg-success-subtle</p>
        <p class="bg-success-subtle color-success-emphasis p-2">bg-success-subtle color-success-emphasis</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-2'}) }}

    <h2 class="mt-10">Texte coloré</h2>
    {% set code %}
        <p class="color-danger-emphasis">Le mot de passe est trop court.</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Une icône</h2>
    <p class="mt-2"><code>color-*</code>, la couleur brute : pour une icône ou un décor, pas pour du texte.</p>
    {% set code %}
        <p class="d-flex align-items-center gap-2">
            <svg class="color-success" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/></svg>
            En ligne
        </p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Liens et boutons sur un fond</h2>
    <p class="mt-2">Sur un fond plein, un lien prend la couleur du texte et seul <code>btn-solid</code> se lit.</p>
    {% set code %}
        <div class="bg-primary color-primary-contrast p-4">
            <p>Un texte avec <a class="link" href="#">un lien</a>.</p>
            <button class="btn-solid theme-inverse mt-2" type="button">Action</button>
        </div>
        <div class="bg-success-subtle p-4">
            <p>Un texte avec <a class="link" href="#">un lien</a>.</p>
            <button class="btn-outline theme-success mt-2" type="button">Action</button>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>La couleur ne dit jamais seule l'information : un texte dit l'erreur ou l'état (WCAG 1.4.1).</li>
        <li><code>color-*-emphasis</code> se lit sur le fond de page et sur <code>bg-*-subtle</code>, dans les deux thèmes.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : un fond plein sans son texte, illisible dans un des thèmes -->
        <section class="bg-warning">…</section>
        <!-- Oui -->
        <section class="bg-warning color-warning-contrast">…</section>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : la couleur brute pour du texte, trop claire -->
        <p class="color-success">Enregistré</p>
        <!-- Oui -->
        <p class="color-success-emphasis">Enregistré</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sous un .theme-*, le lien prend l'emphasis du thème, peu lisible sur le fond plein -->
        <section class="bg-primary color-primary-contrast theme-primary"><a class="link" href="…">…</a></section>
        <!-- Oui -->
        <section class="bg-primary color-primary-contrast theme-primary"><a class="link color-inherit" href="…">…</a></section>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : btn-outline, btn-text et btn-link sont faits pour le fond de page -->
        <section class="bg-primary color-primary-contrast"><button class="btn-outline theme-neutral" type="button">…</button></section>
        <!-- Oui -->
        <section class="bg-primary color-primary-contrast"><button class="btn-solid theme-inverse" type="button">…</button></section>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas de préfixe d'écran : ce n'est pas de la mise en page.</li>
        <li>Sur un fond plein, le contour de focus des boutons garde la couleur de leur thème : il peut manquer de contraste.</li>
        <li>Une nouvelle couleur : une <code>--color-&lt;nom&gt;</code> et son nom dans la liste <code>$colors</code> de <code>settings/_colors.scss</code> (recompiler).</li>
    </ul>

    <h2 class="mt-10">Toutes les couleurs</h2>
    <h3 class="fs-md mt-6">bg-* color-*-contrast</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="bg-{{ color }} color-{{ color }}-contrast p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">bg-*-subtle</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="bg-{{ color }}-subtle p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">bg-*-subtle color-*-emphasis</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="bg-{{ color }}-subtle color-{{ color }}-emphasis p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">bg-neutral-subtle color-*-emphasis</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="bg-neutral-subtle color-{{ color }}-emphasis p-2 col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">color-*-emphasis</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="color-{{ color }}-emphasis col-6 md:col-4">{{ color }}</p>
        {% endfor %}
    </div>
    <h3 class="fs-md mt-6">color-*</h3>
    <div class="grid gap-2 mt-2">
        {% for color in colors %}
            <p class="d-flex align-items-center gap-2 col-6 md:col-4">
                <svg class="color-{{ color }}" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/></svg>
                {{ color }}
            </p>
        {% endfor %}
    </div>
{% endblock %}
