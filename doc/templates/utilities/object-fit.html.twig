{% extends 'base.html.twig' %}

{% block title %}Object-fit{% endblock %}

{% block body %}
    <h1>Object-fit</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Comment une image ou une vidéo remplit sa boîte : <code>object-fit-contain</code>, <code>-cover</code>, <code>-fill</code>, <code>-none</code> et <code>-scale-down</code>.</p>

    <h2 class="mt-10">Valeurs</h2>
    <p class="mt-2">La même image, deux fois plus large que haute, dans une boîte carrée.</p>
    {% set code %}
        <div class="grid">
            <figure class="col-6 md:col-4">
                <img class="w-100 aspect-ratio-1x1 object-fit-contain border" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
                <figcaption>object-fit-contain</figcaption>
            </figure>
            <figure class="col-6 md:col-4">
                <img class="w-100 aspect-ratio-1x1 object-fit-cover border" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
                <figcaption>object-fit-cover</figcaption>
            </figure>
            <figure class="col-6 md:col-4">
                <img class="w-100 aspect-ratio-1x1 object-fit-fill border" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
                <figcaption>object-fit-fill</figcaption>
            </figure>
            <figure class="col-6 md:col-4">
                <img class="w-100 aspect-ratio-1x1 object-fit-none border" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
                <figcaption>object-fit-none</figcaption>
            </figure>
            <figure class="col-6 md:col-4">
                <img class="w-100 aspect-ratio-1x1 object-fit-scale-down border" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
                <figcaption>object-fit-scale-down</figcaption>
            </figure>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Un avatar rond</h2>
    <p class="mt-2"><code>width</code> donne la taille, <code>aspect-ratio-1x1</code> le carré, <code>object-fit-cover</code> recadre.</p>
    {% set code %}
        <img class="aspect-ratio-1x1 object-fit-cover border-radius-circle" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="96" height="96">
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : l'image n'a pas de boîte à remplir, sa hauteur suit ses proportions -->
        <img class="object-fit-cover" src="…" alt="…" width="400" height="200">
        <!-- Oui : une largeur et des proportions -->
        <img class="w-100 aspect-ratio-1x1 object-fit-cover" src="…" alt="…" width="400" height="200">
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : cover coupe les bords d'un logo ou d'un schéma -->
        <img class="w-100 aspect-ratio-1x1 object-fit-cover" src="logo.svg" alt="…">
        <!-- Oui -->
        <img class="w-100 aspect-ratio-1x1 object-fit-contain" src="logo.svg" alt="…">
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Sur <code>&lt;img&gt;</code> et <code>&lt;video&gt;</code> ; une image de fond se règle par <code>background-size</code>, dans le site.</li>
        <li>Le recadrage est centré : pas d'<code>object-position</code>. Pas de préfixe d'écran.</li>
    </ul>
{% endblock %}
