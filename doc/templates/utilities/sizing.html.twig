{% extends 'base.html.twig' %}

{% block title %}Largeur et hauteur{% endblock %}

{% block body %}
    <h1>Largeur et hauteur</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Largeurs en pourcentage du parent (<code>w-25</code> à <code>w-100</code>, <code>w-auto</code>, <code>w-fit-content</code>), <code>min-w-0</code>, <code>h-100</code>, <code>h-100svh</code>, <code>min-h-0</code> et <code>min-h-100svh</code>.</p>

    <h2 class="mt-10">Largeur</h2>
    {% set code %}
        <p class="bg-primary-subtle p-2 w-25">w-25</p>
        <p class="bg-primary-subtle p-2 w-33">w-33</p>
        <p class="bg-primary-subtle p-2 w-50">w-50</p>
        <p class="bg-primary-subtle p-2 w-66">w-66</p>
        <p class="bg-primary-subtle p-2 w-75">w-75</p>
        <p class="bg-primary-subtle p-2 w-100">w-100</p>
        <p class="bg-primary-subtle p-2 w-fit-content">w-fit-content : la largeur du texte</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Selon l'écran</h2>
    <p class="mt-2">Toute la largeur sur téléphone, la moitié à partir de md.</p>
    {% set code %}
        <p class="bg-primary-subtle p-2 md:w-50">md:w-50</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Un enfant flex qui rétrécit</h2>
    <p class="mt-2"><code>min-w-0</code> : le texte passe sous la largeur de son mot le plus long.</p>
    {% set code %}
        <div class="d-flex gap-2">
            <p class="bg-primary-subtle p-2 flex-shrink-0">Icône</p>
            <p class="bg-primary-subtle p-2 min-w-0">Anticonstitutionnellementanticonstitutionnellement</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Toute la hauteur du parent</h2>
    <p class="mt-2"><code>h-100</code> demande un parent qui a une hauteur, ici par <code>aspect-ratio-21x9</code>.</p>
    {% set code %}
        <div class="d-flex align-items-start gap-2 aspect-ratio-21x9 border">
            <p class="bg-primary-subtle p-2">sans classe</p>
            <p class="bg-primary-subtle p-2 h-100">h-100</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Le pied de page en bas de l'écran</h2>
    <p class="mt-2">Même quand la page est courte.</p>
    {% set code %}
        <body class="d-flex flex-direction-column min-h-100svh">
            <main class="flex-grow-1">…</main>
            <footer>…</footer>
        </body>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">L'en-tête et le pied toujours visibles</h2>
    <p class="mt-2">La mise en page de cette doc : sur grand écran, seul le contenu défile ; sur petit écran et en zoom, toute la page.</p>
    {% set code %}
        <body class="d-flex flex-direction-column min-h-100svh lg:h-100svh">
            <header>…</header>
            <main class="card flex-grow-1 lg:min-h-0">
                <div class="card-body position-relative overflow-y-auto">…</div>
            </main>
            <footer>…</footer>
        </body>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        /* La fenêtre ne défile plus : à l'ouverture d'un dialogue, pas de place gardée pour une barre qu'elle n'a pas */
        @media (width >= 64rem) {
            html { scrollbar-gutter: auto; }
        }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}
    <ul class="mt-2">
        <li><code>lg:min-h-0</code> laisse le main plus petit que son contenu : sans lui, la page s'allonge.</li>
        <li><code>position-relative</code> : un texte <code>visually-hidden</code> défile avec le contenu au lieu d'allonger la page.</li>
    </ul>

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Une hauteur fixe sur un bloc de texte le coupe en zoom 200 % ou quand l'utilisateur agrandit l'interligne (WCAG 1.4.4 et 1.4.12).</li>
        <li>Au clavier, une zone qui défile se prend avec <code>tabindex="0"</code>, ou par un lien qu'elle contient.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : 100 % du parent plus les marges, le bloc dépasse -->
        <div class="w-100 mx-4">…</div>
        <!-- Oui : un bloc prend déjà toute la place entre ses marges -->
        <div class="mx-4">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : en-tête et pied fixes sur tous les écrans, il ne reste presque rien au contenu sur un téléphone couché ou en zoom 400 % (WCAG 1.4.10) -->
        <body class="d-flex flex-direction-column h-100svh">…</body>
        <!-- Oui : seulement sur grand écran -->
        <body class="d-flex flex-direction-column min-h-100svh lg:h-100svh">…</body>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li><code>h-100</code> ne fait rien si le parent n'a pas de hauteur : la hauteur en % devient auto.</li>
        <li>Pas d'autres hauteurs (un bandeau à la moitié de l'écran) : dans le site, en svh.</li>
        <li><code>min-h-100svh</code> prend la hauteur de l'écran avec les barres du navigateur : quand elles se cachent sur téléphone, il reste un peu de place en bas.</li>
    </ul>
{% endblock %}
