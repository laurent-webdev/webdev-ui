{% extends 'base.html.twig' %}

{% block title %}Typographie{% endblock %}

{% block body %}
    <h1>Typographie</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Tailles <code>fs-*</code>, interligne <code>line-height-*</code>, graisses <code>fw-*</code>, italique <code>fst-*</code> et <code>font-family-monospace</code>.</p>

    <h2 class="mt-10">Titres</h2>
    <p class="mt-2">Sans classe : h1 en 3xl … h6 en sm.</p>
    {% set code %}
        <h1>Titre h1</h1>
        <h2>Titre h2</h2>
        <h3>Titre h3</h3>
        <h4>Titre h4</h4>
        <h5>Titre h5</h5>
        <h6>Titre h6</h6>
    {% endset %}
    {% set demo %}
        <p class="fs-3xl fw-medium">Titre h1</p>
        <p class="fs-2xl fw-medium">Titre h2</p>
        <p class="fs-xl fw-medium">Titre h3</p>
        <p class="fs-lg fw-medium">Titre h4</p>
        <p class="fs-md fw-medium">Titre h5</p>
        <p class="fs-sm fw-medium">Titre h6</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: ''}) }}

    <h2 class="mt-10">Tailles</h2>
    <p class="mt-2">xs à lg fixes (12 à 18px), xl à 6xl grandissent avec l'écran ; chaque taille pose aussi son interligne.</p>
    {% set code %}
        <p class="fs-xs">fs-xs</p>
        <p class="fs-sm">fs-sm</p>
        <p class="fs-md">fs-md</p>
        <p class="fs-lg">fs-lg</p>
        <p class="fs-xl">fs-xl</p>
        <p class="fs-2xl">fs-2xl</p>
        <p class="fs-3xl">fs-3xl</p>
        <p class="fs-4xl">fs-4xl</p>
        <p class="fs-5xl">fs-5xl</p>
        <p class="fs-6xl">fs-6xl</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Interligne</h2>
    <p class="mt-2"><code>line-height-*</code> change l'interligne seul : un grand texte à lire, aéré comme le texte.</p>
    {% set code %}
        <p class="fs-2xl">fs-2xl : un grand texte d'introduction, sur plusieurs lignes, avec l'interligne de sa taille.</p>
        <p class="fs-2xl line-height-md">fs-2xl line-height-md : la même taille, avec l'interligne du texte.</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un chiffre clé</h2>
    <p class="mt-2"><code>line-height-1</code> : la boîte colle au chiffre, pour une seule ligne.</p>
    {% set code %}
        <p><span class="d-block fs-5xl fw-bold line-height-1">98 %</span> de clients satisfaits</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Graisses</h2>
    {% set code %}
        <p class="fw-light">fw-light</p>
        <p class="fw-normal">fw-normal</p>
        <p class="fw-medium">fw-medium</p>
        <p class="fw-semibold">fw-semibold</p>
        <p class="fw-bold">fw-bold</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Style et famille</h2>
    {% set code %}
        <p class="fst-italic">fst-italic</p>
        <p><em class="fst-normal">fst-normal sur un em</em></p>
        <p class="font-family-monospace">font-family-monospace</p>
        <p>Du <code>code</code> dans un paragraphe</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--font-family</th><td>polices du système</td><td>texte</td></tr>
                <tr><th scope="row">--font-family-monospace</th><td>polices du système</td><td>code, <code>font-family-monospace</code></td></tr>
                <tr><th scope="row">--font-size-xs à -lg</th><td>12, 14, 16, 18px</td><td>texte</td></tr>
                <tr><th scope="row">--font-size-xl à -6xl</th><td>de 20-24px à 48-80px</td><td>titres, grandissent avec l'écran</td></tr>
                <tr><th scope="row">--line-height-xs à -6xl</th><td>1.5 à 1.2</td><td>interligne de chaque taille</td></tr>
                <tr><th scope="row">--font-weight-light à -bold</th><td>300 à 700</td><td>graisses</td></tr>
                <tr><th scope="row">--heading-font-weight</th><td>--font-weight-medium</td><td>graisse des titres</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* La police du site */
        :root { --font-family: "Inter", sans-serif; }

        /* Une taille : le texte, fs-md et line-height-md changent ensemble */
        :root { --line-height-md: 1.6; }

        /* Les titres en gras */
        :root { --heading-font-weight: var(--font-weight-bold); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>La balise dit le niveau du titre, <code>fs-*</code> sa taille : un h2 peut être petit, la hiérarchie reste juste.</li>
        <li>Les tailles sont en rem : elles suivent la taille de texte choisie dans le navigateur.</li>
        <li>Un utilisateur qui agrandit l'interligne (WCAG 1.4.12) passe devant ces classes : pas de hauteur fixe sur un bloc de texte.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : un paragraphe en gros, pris pour un titre -->
        <p class="fs-2xl">Nos offres</p>
        <!-- Oui : un titre, à la taille voulue -->
        <h2 class="fs-2xl">Nos offres</h2>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sur plusieurs lignes, les accents touchent la ligne du dessus -->
        <p class="line-height-1">Un paragraphe de plusieurs lignes…</p>
        <!-- Oui : line-height-1 pour une seule ligne -->
        <p class="fs-5xl line-height-1">42</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas de préfixe d'écran : les titres grandissent déjà avec l'écran.</li>
        <li>Plusieurs interlignes ont la même valeur (xs à lg : 1.5) : chacun suit sa variable, ils restent différents si un site change l'échelle.</li>
    </ul>
{% endblock %}
