{% extends 'base.html.twig' %}

{% block title %}Ombres{% endblock %}

{% block body %}
    <h1>Ombres</h1>
    <p class="fs-lg color-neutral-emphasis mb-6"><code>box-shadow-none</code> et <code>box-shadow-xs</code> à <code>-xl</code>, de plus en plus hautes, d'une seule couleur.</p>

    <h2 class="mt-10">Tailles</h2>
    {% set code %}
        <p class="border-radius-md box-shadow-xs p-4">box-shadow-xs</p>
        <p class="border-radius-md box-shadow-sm p-4">box-shadow-sm</p>
        <p class="border-radius-md box-shadow-md p-4">box-shadow-md</p>
        <p class="border-radius-md box-shadow-lg p-4">box-shadow-lg</p>
        <p class="border-radius-md box-shadow-xl p-4">box-shadow-xl</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'd-flex flex-wrap-wrap gap-6 p-6'}) }}

    <h2 class="mt-10">Une carte soulevée</h2>
    <p class="mt-2">La bordure sépare la carte du fond, l'ombre la soulève.</p>
    {% set code %}
        <div class="card box-shadow-md">
            <div class="card-body">
                <p>Une carte avec une ombre.</p>
            </div>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: 'p-6'}) }}

    <h2 class="mt-10">Retirer une ombre</h2>
    <p class="mt-2">Le dialogue, le drawer, le dropdown et le toast ont la leur.</p>
    {% set code %}
        <div class="dropdown box-shadow-none" id="menu" popover>…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10" id="variables">Variables</h2>
    <div class="overflow-x-auto mt-2" role="region" aria-labelledby="variables" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Variable</th>
                    <th scope="col">Défaut</th>
                    <th scope="col">Rôle</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">--box-shadow-color</th><td>noir à 10 % (clair), 50 % (sombre)</td><td>couleur de toutes les ombres</td></tr>
                <tr><th scope="row">--box-shadow-xs à -xl</th><td>de plus en plus hautes</td><td>une taille</td></tr>
            </tbody>
        </table>
    </div>
    {% set code %}
        /* Toutes les ombres, dans les deux thèmes */
        :root { --box-shadow-color: light-dark(oklch(0 0 0 / 0.15), oklch(0 0 0 / 0.6)); }

        /* Une taille */
        :root { --box-shadow-md: 0 2px 8px var(--box-shadow-color); }

        /* Un élément du site : redéfinir la taille, la couleur est lue dans :root */
        .card-produit { --box-shadow-md: 0 2px 8px oklch(0.5 0.1 228 / 0.3); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Une ombre est décorative : presque invisible en sombre, retirée en contraste élevé. Ce qui montre un élément est une bordure.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : un champ montré par son ombre seule (WCAG 1.4.11) -->
        <input class="box-shadow-sm border-0" type="text" name="nom" aria-label="Nom">
        <!-- Oui -->
        <input class="form-input" type="text" name="nom" aria-label="Nom">
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        /* Non : les --box-shadow-* sont calculées dans :root, avec la couleur de :root */
        .card { --box-shadow-color: oklch(0.5 0.1 228 / 0.3); }

        /* Oui : redéfinir la taille */
        .card { --box-shadow-md: 0 2px 8px oklch(0.5 0.1 228 / 0.3); }
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'css'}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>En sombre, une ombre se voit peu : séparer les blocs par une bordure ou un fond léger.</li>
        <li>Pas d'ombre au survol, colorée ou intérieure : dans le site.</li>
    </ul>
{% endblock %}
