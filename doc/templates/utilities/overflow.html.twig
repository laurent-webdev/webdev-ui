{% extends 'base.html.twig' %}

{% block title %}Overflow{% endblock %}

{% block body %}
    <h1>Overflow</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Ce qui dépasse d'une boîte : <code>overflow-*</code>, <code>overflow-x-*</code> et <code>overflow-y-*</code>, en <code>auto</code>, <code>hidden</code>, <code>clip</code> ou <code>visible</code>.</p>

    <h2 class="mt-10">Une zone qui défile</h2>
    <p class="mt-2"><code>overflow-y-auto</code> : une barre de défilement quand le texte dépasse.</p>
    {% set code %}
        <!-- Un parent qui a une hauteur, 8rem ici -->
        <div class="overflow-y-auto border p-2" role="region" aria-label="Conditions" tabindex="0">
            <p>Un texte plus long que la boîte. Il continue sur plusieurs lignes, pour dépasser la hauteur de la boîte et voir la barre de défilement apparaître quand le contenu ne tient plus dans son cadre.</p>
        </div>
    {% endset %}
    {% set demo %}
        <div class="demo-height overflow-y-auto border p-2" role="region" aria-label="Conditions" tabindex="0">
            <p>Un texte plus long que la boîte. Il continue sur plusieurs lignes, pour dépasser la hauteur de la boîte et voir la barre de défilement apparaître quand le contenu ne tient plus dans son cadre.</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: ''}) }}

    <h2 class="mt-10">Couper</h2>
    <p class="mt-2"><code>hidden</code> et <code>clip</code> coupent pareil ; <code>clip</code> ne crée pas de zone de défilement (<code>position-sticky</code> marche encore dedans).</p>
    {% set code %}
        <div class="overflow-hidden border p-2">…</div>
        <div class="overflow-clip border p-2">…</div>
    {% endset %}
    {% set demo %}
        <div class="demo-height overflow-hidden border p-2"><p>overflow-hidden : un texte plus long que la boîte, coupé en bas. Il continue sur plusieurs lignes pour dépasser la hauteur de la boîte et ne plus tenir dans son cadre.</p></div>
        <div class="demo-height overflow-clip border p-2"><p>overflow-clip : un texte plus long que la boîte, coupé en bas. Il continue sur plusieurs lignes pour dépasser la hauteur de la boîte et ne plus tenir dans son cadre.</p></div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, html: demo, class: 'd-grid gap-4'}) }}

    <h2 class="mt-10">Un tableau large</h2>
    <p class="mt-2">Le tableau défile seul sur un petit écran, la page ne déborde pas.</p>
    {% set code %}
        <div class="overflow-x-auto" role="region" aria-label="Tarifs" tabindex="0">
            <table class="table">
                <thead>
                    <tr><th scope="col">Offre</th><th scope="col">Janvier</th><th scope="col">Février</th><th scope="col">Mars</th><th scope="col">Avril</th><th scope="col">Mai</th><th scope="col">Juin</th></tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Découverte</th><td>9 €</td><td>9 €</td><td>9 €</td><td>12 €</td><td>12 €</td><td>12 €</td></tr>
                </tbody>
            </table>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Une animation qui entre par le côté</h2>
    <p class="mt-2">Pas de barre de défilement pendant le mouvement.</p>
    {% set code %}
        <section class="overflow-x-clip">
            <div class="animation-slide-in-end">…</div>
        </section>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Une zone qui défile a <code>tabindex="0"</code> (elle se prend au clavier), un <code>role="region"</code> et un nom (<code>aria-label</code> ou <code>aria-labelledby</code>).</li>
        <li>Ce qui est coupé par <code>hidden</code> ou <code>clip</code> est perdu pour l'utilisateur : seulement pour du décor.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : cache la barre, mais aussi le contenu qui dépasse (WCAG 1.4.10), et sticky ne marche plus -->
        <body class="overflow-x-hidden">
        <!-- Oui : corriger l'élément qui déborde (min-w-0, w-100 sans marge…) -->
        <body>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : sans tabindex, la zone ne défile pas au clavier dans Safari -->
        <div class="overflow-y-auto">…</div>
        <!-- Oui -->
        <div class="overflow-y-auto" role="region" aria-label="Conditions" tabindex="0">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li><code>overflow-x-auto</code> (ou <code>-hidden</code>) fait défiler aussi l'autre axe : un menu qui sort de la boîte est coupé. <code>clip</code> n'a pas ce défaut.</li>
        <li>Pas de <code>overflow-scroll</code> (barres toujours affichées) ni de préfixe d'écran.</li>
    </ul>
{% endblock %}
