{% extends 'base.html.twig' %}

{% block title %}Visually-hidden{% endblock %}

{% block body %}
    <h1>Visually-hidden</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Un texte caché à l'écran mais lu par les lecteurs d'écran : <code>visually-hidden</code>.</p>

    <h2 class="mt-10">Compléter un nombre</h2>
    <p class="mt-2">Le lecteur d'écran lit « Messages 3 non lus » ; à l'écran, seul le nombre se voit.</p>
    {% set code %}
        <button class="btn" type="button">Messages <span class="badge-solid theme-danger">3</span><span class="visually-hidden"> non lus</span></button>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Nommer une icône</h2>
    {% set code %}
        <p role="status" aria-live="polite"><span class="spinner"></span><span class="visually-hidden">Chargement…</span></p>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">Un lien plus précis</h2>
    <p class="mt-2">Plusieurs « Lire la suite » : chacun dit où il mène (WCAG 2.4.4).</p>
    {% set code %}
        <a class="link" href="#">Lire la suite<span class="visually-hidden"> de « Bien choisir son vélo »</span></a>
    {% endset %}
    {{ include('_example.html.twig', {code: code}) }}

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : d-none cache aussi le texte au lecteur d'écran, il n'entend que « 3 » -->
        <span class="d-none"> non lus</span>
        <!-- Oui -->
        <span class="visually-hidden"> non lus</span>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un lien caché reste atteint au clavier, mais le focus ne se voit pas -->
        <a class="visually-hidden" href="#main">Aller au contenu</a>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Pas encore de <code>visually-hidden-focusable</code> (un lien d'évitement qui apparaît au focus).</li>
        <li>Dans une zone qui défile, le parent prend <code>position-relative</code> : sinon le texte caché peut allonger la page.</li>
    </ul>
{% endblock %}
