{% extends 'base.html.twig' %}

{% block title %}Espacements{% endblock %}

{% block body %}
    <h1>Espacements</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Marges et paddings de 0 à 12 (--space-*, 0.25rem par cran), en propriétés logiques : m-*, mx-*, my-*, mt-*, mb-*, ms-*, me-* et les mêmes en p-*, avec des variantes xs: à 2xl:.</p>

    <div class="demo-frame mt-4"><div class="demo-box p-0">p-0</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-3">p-3</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-6">p-6</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-12">p-12</div></div>
    <div class="demo-frame mt-4"><div class="demo-box px-8 py-2">px-8 py-2</div></div>
    <div class="demo-frame mt-4"><div class="demo-box m-4 p-2">m-4 p-2</div></div>
    <div class="demo-frame mt-4"><div class="demo-box m-4 mt-0 p-2">m-4 mt-0 p-2 : le côté précis gagne</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-2 md:p-6 lg:p-12">p-2 md:p-6 lg:p-12 : grandit avec l'écran</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-1 sm:p-2 md:p-4 lg:p-6 xl:p-8 2xl:p-12">p-1 sm:p-2 md:p-4 lg:p-6 xl:p-8 2xl:p-12 : un cran par breakpoint</div></div>
    <div class="demo-frame mt-4"><div class="demo-box p-1 xs:p-4">p-1 xs:p-4 : plus serré sous 360px</div></div>
{% endblock %}
