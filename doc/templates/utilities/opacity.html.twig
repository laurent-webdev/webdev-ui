{% extends 'base.html.twig' %}

{% block title %}Opacité{% endblock %}

{% block body %}
    <h1>Opacité</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">L'opacité d'un élément et de ses enfants : <code>opacity-0</code>, <code>-25</code>, <code>-50</code>, <code>-75</code> et <code>-100</code>.</p>

    <h2 class="mt-10">Valeurs</h2>
    {% set code %}
        <div class="grid">
            <figure class="col-6 md:col-3">
                <div class="bg-primary aspect-ratio-1x1 opacity-25"></div>
                <figcaption>opacity-25</figcaption>
            </figure>
            <figure class="col-6 md:col-3">
                <div class="bg-primary aspect-ratio-1x1 opacity-50"></div>
                <figcaption>opacity-50</figcaption>
            </figure>
            <figure class="col-6 md:col-3">
                <div class="bg-primary aspect-ratio-1x1 opacity-75"></div>
                <figcaption>opacity-75</figcaption>
            </figure>
            <figure class="col-6 md:col-3">
                <div class="bg-primary aspect-ratio-1x1 opacity-100"></div>
                <figcaption>opacity-100</figcaption>
            </figure>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Une image décorative atténuée</h2>
    {% set code %}
        <img class="w-100 aspect-ratio-21x9 object-fit-cover opacity-50" src="{{ asset('images/demo-landscape.svg') }}" alt="" width="400" height="200">
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Accessibilité</h2>
    <ul class="mt-2">
        <li>Un texte transparent perd son contraste : pour un texte plus discret, une couleur lisible (<code>color-neutral-emphasis</code>).</li>
        <li><code>opacity-0</code> reste cliquable, focusable et lu par les lecteurs d'écran : pour cacher, <code>hidden</code> ou <code>visually-hidden</code>.</li>
    </ul>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : noir à 50 % sur blanc, sous 4,5:1 (WCAG 1.4.3) -->
        <p class="opacity-50">Texte secondaire</p>
        <!-- Oui -->
        <p class="color-neutral-emphasis">Texte secondaire</p>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : invisible, mais toujours cliquable et lu -->
        <button class="btn opacity-0" type="button">Valider</button>
        <!-- Oui -->
        <button class="btn" type="button" hidden>Valider</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : un enfant ne redevient pas opaque -->
        <div class="opacity-50"><img class="opacity-100" src="…" alt="…"></div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>Tout l'élément devient transparent, fond, texte et enfants : pour un fond seul, <code>color-mix()</code> dans le site.</li>
        <li>De 25 en 25, sans préfixe d'écran.</li>
    </ul>
{% endblock %}
