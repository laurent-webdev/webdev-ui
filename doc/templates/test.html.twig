{% extends 'base.html.twig' %}

{% block title %}Page de test{% endblock %}

{% block body %}
    <h1>Page de test</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Pour essayer un exemple avant de le mettre dans sa page.</p>

    {% set exemples %}
        <p class="d-flex flex-wrap-wrap gap-2 mb-2">
            <a class="btn-solid" href="#">a btn-solid : thème du parent</a>
            <button class="btn-solid" type="button">button btn-solid : thème du parent</button>
        </p>
        <p class="d-flex flex-wrap-wrap gap-2 mb-2">
            <a class="btn-solid theme-inverse" href="#">a btn-solid theme-inverse</a>
            <button class="btn-solid theme-inverse" type="button">button btn-solid theme-inverse</button>
        </p>
        <p class="d-flex flex-wrap-wrap gap-2 mb-2">
            <a class="btn-subtle theme-danger" href="#">a btn-subtle theme-danger</a>
            <button class="btn-subtle theme-danger" type="button">button btn-subtle theme-danger</button>
        </p>
        <p class="d-flex flex-wrap-wrap gap-4">
            <a class="link" href="#">link : thème du parent</a>
            <a class="link theme-danger" href="#">link theme-danger</a>
            <a class="link color-inherit" href="#">link color-inherit : couleur du texte</a>
            <a href="#">a sans classe : navigateur</a>
        </p>
    {% endset %}

    <h2 class="mt-10">Sans composant : un parent theme-primary</h2>
    <div class="theme-primary mt-2">{{ exemples }}</div>

    <h2 class="mt-10">Dans une carte solid theme-primary</h2>
    <div class="card-solid theme-primary mt-2">
        <div class="card-body">{{ exemples }}</div>
    </div>

    <h2 class="mt-10">Dans une carte subtle theme-primary</h2>
    <div class="card-subtle theme-primary mt-2">
        <div class="card-body">{{ exemples }}</div>
    </div>

    <h2 class="mt-10">Dans une alerte solid theme-primary</h2>
    <div class="alert-solid theme-primary mt-2">{{ exemples }}</div>

    <h2 class="mt-10">Dans un dialogue solid theme-primary</h2>
    <p class="mt-2"><button class="btn-solid theme-primary" type="button" commandfor="exemple-dialog" command="show-modal">Ouvrir le dialogue</button></p>
    <dialog class="dialog-solid theme-primary" id="exemple-dialog" aria-labelledby="exemple-dialog-titre">
        <div class="dialog-header">
            <h3 id="exemple-dialog-titre">Le même exemple</h3>
        </div>
        <div class="dialog-body">{{ exemples }}</div>
        <div class="dialog-footer">
            <button class="btn-solid theme-inverse" type="button" commandfor="exemple-dialog" command="close">Fermer</button>
        </div>
    </dialog>
{% endblock %}
