{% extends 'base.html.twig' %}

{% block title %}Breakpoints{% endblock %}

{% block body %}
    <h1>Breakpoints</h1>
    <p class="fs-lg color-neutral-emphasis mb-6">Six largeurs d'écran. Une classe sans préfixe vaut pour tous les écrans ; avec un préfixe (<code>md:</code>), à partir de cette largeur.</p>

    <h2 class="mt-10">Exemple</h2>
    <p class="mt-2">En colonne sur téléphone, en ligne à partir de md (768px).</p>
    {% set code %}
        <div class="d-flex flex-direction-column md:flex-direction-row gap-4">
            <p class="bg-primary-subtle p-2">Un</p>
            <p class="bg-primary-subtle p-2">Deux</p>
            <p class="bg-primary-subtle p-2">Trois</p>
        </div>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10">Plusieurs préfixes</h2>
    <p class="mt-2">Le plus grand qui correspond à l'écran gagne.</p>
    {% set code %}
        <p class="bg-primary-subtle p-2 md:p-6 lg:p-12">p-2 md:p-6 lg:p-12</p>
    {% endset %}
    {{ include('_example.html.twig', {code: code, class: ''}) }}

    <h2 class="mt-10" id="les-largeurs">Les largeurs</h2>
    <div class="table-responsive mt-2" role="region" aria-labelledby="les-largeurs" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Préfixe</th>
                    <th scope="col">À partir de</th>
                    <th scope="col">Appareils</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">sans préfixe</th><td>0</td><td>tous, petits écrans compris (320px)</td></tr>
                <tr><th scope="row">xs:</th><td>22.5rem (360px)</td><td>téléphones debout</td></tr>
                <tr><th scope="row">sm:</th><td>36rem (576px)</td><td>petites tablettes, petits téléphones couchés</td></tr>
                <tr><th scope="row">md:</th><td>48rem (768px)</td><td>tablettes debout, la plupart des téléphones couchés</td></tr>
                <tr><th scope="row">lg:</th><td>64rem (1024px)</td><td>tablettes couchées, petits portables</td></tr>
                <tr><th scope="row">xl:</th><td>80rem (1280px)</td><td>portables</td></tr>
                <tr><th scope="row">2xl:</th><td>96rem (1536px)</td><td>grands portables, écrans de bureau</td></tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-10">Changer une largeur</h2>
    <p class="mt-2">Dans le SCSS du site, avec le projet entier : Sass recompile le framework avec ces largeurs.</p>
    {% set code %}
        // Le SCSS du site
        @use '…/webdev-ui/src/scss/settings/breakpoints' with ($screen-md: 50rem);
        @use '…/webdev-ui/src/scss/webdev-ui';
    {% endset %}
    {{ include('_code.html.twig', {code: code, language: 'scss'}) }}

    <h2 class="mt-10">Quelles classes ont un préfixe</h2>
    <p class="mt-2">La mise en page seulement : display, flex, grille (<code>col-*</code>), espacements, gap, largeur et hauteur, aspect-ratio, <code>position-*</code> et alignement du texte.</p>

    <h2 class="mt-10">À éviter</h2>
    {% set code %}
        <!-- Non : sm: ne veut pas dire « petit écran », mais « à partir de 576px » -->
        <div class="sm:d-none">…</div>
        <!-- Oui : caché sur petit écran, affiché à partir de md -->
        <div class="d-none md:d-block">…</div>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}
    {% set code %}
        <!-- Non : pas de préfixe pour les couleurs, les bordures, les ombres ni les tailles des composants -->
        <button class="btn-sm md:btn-lg" type="button">…</button>
        <!-- Oui -->
        <button class="btn-md" type="button">…</button>
    {% endset %}
    {{ include('_code.html.twig', {code: code}) }}

    <h2 class="mt-10">Limites</h2>
    <ul class="mt-2">
        <li>En rem : quand l'utilisateur agrandit le texte de son navigateur, la page passe plus tôt en version mobile (Chrome et Firefox ; Safari reste en px).</li>
        <li><code>var()</code> ne marche pas dans une media query : les largeurs sont des variables SCSS (<code>settings/_breakpoints.scss</code>), les changer demande de recompiler le SCSS.</li>
        <li>Les préfixes suivent la largeur de l'écran, pas celle du parent.</li>
    </ul>
{% endblock %}
