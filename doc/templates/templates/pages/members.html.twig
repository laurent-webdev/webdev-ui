        <!-- Ajouter un adhérent : le bouton Enregistrer, dans le pied, envoie le formulaire du corps (attribut form) -->
        <dialog class="dialog dialog-md" id="nouvel-adherent" data-dialog aria-labelledby="nouvel-adherent-titre">
            <div class="dialog-header">
                <h2 class="fs-lg" id="nouvel-adherent-titre">Ajouter un adhérent</h2>
                <button class="btn-close" type="button" commandfor="nouvel-adherent" command="close" aria-label="Fermer"></button>
            </div>
            <form class="dialog-body grid" id="adherent-formulaire" method="post">
                <div class="form-field md:col-6">
                    <label for="adherent-prenom">Prénom (obligatoire)</label>
                    <input class="form-input" id="adherent-prenom" type="text" name="prenom" autocomplete="given-name" required>
                </div>
                <div class="form-field md:col-6">
                    <label for="adherent-nom">Nom (obligatoire)</label>
                    <input class="form-input" id="adherent-nom" type="text" name="nom" autocomplete="family-name" required>
                </div>
                <div class="form-field md:col-6">
                    <label for="adherent-email">E-mail (obligatoire)</label>
                    <input class="form-input" id="adherent-email" type="email" name="email" autocomplete="email" required>
                </div>
                <div class="form-field md:col-6">
                    <label for="adherent-telephone">Téléphone</label>
                    <input class="form-input" id="adherent-telephone" type="tel" name="telephone" autocomplete="tel">
                </div>
                <div class="form-field md:col-6">
                    <label for="adherent-niveau">Niveau</label>
                    <select class="form-input" id="adherent-niveau" name="niveau">
                        <option value="debutant">Débutant</option>
                        <option value="confirme">Confirmé</option>
                        <option value="expert">Expert</option>
                    </select>
                </div>
                <div class="form-field md:col-6">
                    <label for="adherent-cotisation">Cotisation payée le</label>
                    <input class="form-input" id="adherent-cotisation" type="date" name="cotisation">
                </div>
                <div>
                    <label><input class="form-checkbox theme-secondary" type="checkbox" name="certificat"> Certificat médical reçu</label>
                </div>
            </form>
            <div class="dialog-footer">
                <button class="btn" type="button" commandfor="nouvel-adherent" command="close">Annuler</button>
                <button class="btn-solid theme-secondary" type="submit" form="adherent-formulaire">Enregistrer</button>
            </div>
